{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:safor:project:0.7.0",
  "title": "SAFOR Project Descriptor 0.7.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "projectId",
    "projectSlug",
    "title",
    "owner",
    "creationType",
    "goal",
    "createdAt",
    "controlRepository",
    "workRepositories"
  ],
  "properties": {
    "format": {
      "const": "SAFOR_PROJECT"
    },
    "schemaVersion": {
      "const": "0.7.0"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "projectSlug": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "controlRepository": {
      "$ref": "#/$defs/repositoryRef"
    },
    "workRepositories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repositoryRef"
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "namespace",
        "stableId"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "stableId": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "creationType": {
      "enum": [
        "SOFTWARE_WEBSITE",
        "BOOK"
      ]
    }
  },
  "$defs": {
    "repositoryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "stableId",
        "repository",
        "branch",
        "purpose"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "stableId": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
