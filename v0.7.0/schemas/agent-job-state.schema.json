{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:safor:agent-job-state:0.7.0",
  "title": "SAFOR MASTER Agent Job State 0.7.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "projectId",
    "jobId",
    "assignedAgentId",
    "owner",
    "revision",
    "lifecycleStatus",
    "contractRef",
    "contractBlobSha",
    "agentStateRef",
    "resultRef",
    "evidenceRefs",
    "verification",
    "transitionHistory",
    "updatedAt"
  ],
  "properties": {
    "format": {
      "const": "SAFOR_AGENT_JOB_STATE"
    },
    "schemaVersion": {
      "const": "0.7.0"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "jobId": {
      "type": "string",
      "minLength": 1
    },
    "assignedAgentId": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "const": "MASTER"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "lifecycleStatus": {
      "enum": [
        "READY",
        "CLAIMED",
        "RUNNING",
        "RESULT_SUBMITTED",
        "VERIFIED",
        "ACCEPTED",
        "REJECTED",
        "REWORK_READY",
        "BLOCKED",
        "CANCELED",
        "SUPERSEDED"
      ]
    },
    "contractRef": {
      "type": "string",
      "minLength": 1
    },
    "contractBlobSha": {
      "type": "string",
      "minLength": 1
    },
    "agentStateRef": {
      "type": "string",
      "minLength": 1
    },
    "resultRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "verifiedAt",
        "observedRefs",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_STARTED",
            "PENDING",
            "PASS",
            "FAIL"
          ]
        },
        "verifiedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "observedRefs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "transitionHistory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "at",
        "actorId",
        "evidenceRefs"
      ],
      "properties": {
        "from": {
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "actorId": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
