{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:safor:evidence-record:0.7.0",
  "title": "SAFOR Evidence Record 0.7.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "evidenceId",
    "evidenceType",
    "subjectRef",
    "source",
    "observedAt",
    "reference",
    "integrity",
    "claims"
  ],
  "properties": {
    "format": {
      "const": "SAFOR_EVIDENCE_RECORD"
    },
    "schemaVersion": {
      "const": "0.7.0"
    },
    "evidenceId": {
      "type": "string"
    },
    "evidenceType": {
      "type": "string"
    },
    "subjectRef": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "reference": {
      "type": "string"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stableId",
        "revisionRef"
      ],
      "properties": {
        "stableId": {
          "type": [
            "string",
            "null"
          ]
        },
        "revisionRef": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
