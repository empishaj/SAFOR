{
  "format": "SAFOR_BUNDLE_BUILD_PART",
  "part": 4,
  "modules": {
    "v0.5.0/schemas/package-manifest.schema.json": {
      "sha": "7602f752237972e534c9ca59eff23fec5e85a336",
      "content": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:safor:package-manifest:0.5.0",
        "title": "SAFOR Package Manifest 0.5.0",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "schemaVersion",
          "packageId",
          "packageKind",
          "version",
          "name",
          "description",
          "compatibility",
          "exports",
          "dependencies",
          "model"
        ],
        "properties": {
          "format": {
            "const": "SAFOR_PACKAGE_MANIFEST"
          },
          "schemaVersion": {
            "const": "0.5.0"
          },
          "packageId": {
            "type": "string",
            "pattern": "^safor\\.(om|factory|provider|memory)\\.[a-z0-9][a-z0-9.-]*$"
          },
          "packageKind": {
            "enum": [
              "OPERATING_MODEL",
              "FACTORY",
              "PROVIDER_ADAPTER",
              "MEMORY_PROVIDER_ADAPTER"
            ]
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "compatibility": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kernel"
            ],
            "properties": {
              "kernel": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "exports": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capabilities",
              "authorities",
              "workItemTypes",
              "artifactTypes",
              "providerCapabilities",
              "memoryCapabilities"
            ],
            "properties": {
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "authorities": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "workItemTypes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "artifactTypes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "providerCapabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "memoryCapabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "packageId",
                "versionRange"
              ],
              "properties": {
                "packageId": {
                  "type": "string"
                },
                "versionRange": {
                  "type": "string"
                }
              }
            }
          },
          "model": {
            "type": "object"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "repository": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "ref": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "v0.5.0/schemas/control-state.schema.json": {
      "sha": "d424985a00429e6b40cdfd18fba614441fd1fd01",
      "content": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:safor:control-state:0.5.0",
        "title": "SAFOR Control State 0.5.0",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "schemaVersion",
          "kernelRef",
          "projectRef",
          "bindingsRef",
          "mode",
          "status",
          "currentActionId",
          "stateRevision",
          "resumeMode",
          "mandates",
          "lastTransition",
          "audit"
        ],
        "properties": {
          "format": {
            "const": "SAFOR_CONTROL_STATE"
          },
          "schemaVersion": {
            "const": "0.5.0"
          },
          "kernelRef": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "sourceRef"
            ],
            "properties": {
              "version": {
                "const": "0.4.0"
              },
              "sourceRef": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "projectRef": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "projectId",
              "projectSlug"
            ],
            "properties": {
              "projectId": {
                "type": "string",
                "minLength": 1
              },
              "projectSlug": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
              }
            }
          },
          "bindingsRef": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "revision"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "mode": {
            "enum": [
              "BOOTSTRAP",
              "INITIALIZING",
              "PLANNING",
              "AWAITING_AUTHORIZATION",
              "EXECUTING",
              "WAITING_OUTCOME",
              "RECOVERING",
              "PAUSED",
              "STOPPED",
              "COMPLETED"
            ]
          },
          "status": {
            "enum": [
              "READY",
              "RUNNING",
              "WAITING_HUMAN",
              "WAITING_EXTERNAL",
              "RECONCILE_REQUIRED",
              "BLOCKED",
              "FAILED",
              "DONE"
            ]
          },
          "currentActionId": {
            "type": [
              "string",
              "null"
            ]
          },
          "stateRevision": {
            "type": "integer",
            "minimum": 0
          },
          "resumeMode": {
            "type": [
              "string",
              "null"
            ]
          },
          "mandates": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/mandate"
            }
          },
          "lastTransition": {
            "type": [
              "object",
              "null"
            ]
          },
          "audit": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "expectedControlHead",
              "lastVerifiedReadback"
            ],
            "properties": {
              "expectedControlHead": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "lastVerifiedReadback": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "$defs": {
          "mandate": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mandateId",
              "type",
              "active",
              "scope",
              "decisionRef",
              "issuedAt",
              "revokedAt"
            ],
            "properties": {
              "mandateId": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "active": {
                "type": "boolean"
              },
              "scope": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "workItemIds",
                  "capabilities",
                  "objectRefs"
                ],
                "properties": {
                  "workItemIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  },
                  "capabilities": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  },
                  "objectRefs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  }
                }
              },
              "decisionRef": {
                "type": "string",
                "minLength": 1
              },
              "issuedAt": {
                "type": "string",
                "format": "date-time"
              },
              "revokedAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "v0.5.0/schemas/value-stream-state.schema.json": {
      "sha": "fba75e68a96fbac2d4694885976c452bed2c7f11",
      "content": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:safor:value-stream-state:0.5.0",
        "title": "SAFOR Value Stream State 0.5.0",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "schemaVersion",
          "projectId",
          "factoryBinding",
          "valueStreamId",
          "revision",
          "objects",
          "relations",
          "workItems",
          "outcomes"
        ],
        "properties": {
          "format": {
            "const": "SAFOR_VALUE_STREAM_STATE"
          },
          "schemaVersion": {
            "const": "0.5.0"
          },
          "projectId": {
            "type": "string",
            "minLength": 1
          },
          "factoryBinding": {
            "$ref": "#/$defs/packageBinding"
          },
          "valueStreamId": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "objects": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/object"
            }
          },
          "relations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/relation"
            }
          },
          "workItems": {
            "type": "array",
            "items": {
              "$ref": "work-item.schema.json"
            }
          },
          "outcomes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/outcome"
            }
          }
        },
        "$defs": {
          "packageBinding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "packageId",
              "version",
              "snapshotRef"
            ],
            "properties": {
              "packageId": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "snapshotRef": {
                "type": "string"
              }
            }
          },
          "object": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "status",
              "artifactRef"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "description": "Factory-defined domain artifact/business-object type."
              },
              "status": {
                "type": "string"
              },
              "artifactRef": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "relation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "from",
              "to"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            }
          },
          "outcome": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "definition",
              "status",
              "evidenceRefs"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "definition": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "NOT_EVALUATED",
                  "VALUE_SUPPORTED",
                  "VALUE_NOT_DEMONSTRATED",
                  "VALUE_UNCLEAR"
                ]
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "v0.5.0/schemas/execution-state.schema.json": {
      "sha": "bfed9529dcc1538131e761704e71d2fc7b970a0f",
      "content": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:safor:execution-state:0.5.0",
        "title": "SAFOR Execution State 0.5.0",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "schemaVersion",
          "projectId",
          "revision",
          "actorAssignments",
          "sessions",
          "contracts",
          "runs",
          "outputRefs",
          "reconciliation",
          "selfHealing"
        ],
        "properties": {
          "format": {
            "const": "SAFOR_EXECUTION_STATE"
          },
          "schemaVersion": {
            "const": "0.5.0"
          },
          "projectId": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "actorAssignments": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/assignment"
            }
          },
          "sessions": {
            "type": "array",
            "items": {
              "$ref": "session-record.schema.json"
            }
          },
          "contracts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/contract"
            }
          },
          "runs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/run"
            }
          },
          "outputRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reconciliation": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/reconciliation"
            }
          },
          "selfHealing": {
            "type": "array",
            "items": {
              "$ref": "self-healing-record.schema.json"
            }
          }
        },
        "$defs": {
          "assignment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "roleId",
              "actorId",
              "actorKind",
              "capabilities"
            ],
            "properties": {
              "roleId": {
                "type": "string"
              },
              "actorId": {
                "type": "string"
              },
              "actorKind": {
                "enum": [
                  "HUMAN",
                  "AGENT",
                  "SERVICE"
                ]
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          },
          "contract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contractId",
              "workItemId",
              "performerActorId",
              "reviewerActorIds",
              "status",
              "scope"
            ],
            "properties": {
              "contractId": {
                "type": "string"
              },
              "workItemId": {
                "type": "string"
              },
              "performerActorId": {
                "type": "string"
              },
              "reviewerActorIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "status": {
                "enum": [
                  "PREPARED",
                  "ASSIGNED",
                  "IN_PROGRESS",
                  "RESULT_RECORDED",
                  "REWORK_REQUESTED",
                  "ACCEPTED",
                  "SUPERSEDED",
                  "CANCELED",
                  "BLOCKED"
                ]
              },
              "scope": {
                "type": "object"
              }
            }
          },
          "run": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "runId",
              "actionId",
              "operationId",
              "sessionId",
              "status",
              "inputRefs",
              "outputRefs",
              "evidenceRefs",
              "startedAt",
              "endedAt",
              "error"
            ],
            "properties": {
              "runId": {
                "type": "string"
              },
              "actionId": {
                "type": "string"
              },
              "operationId": {
                "type": "string"
              },
              "sessionId": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "INTENT_WRITTEN",
                  "RUNNING",
                  "WAITING_HUMAN",
                  "WAITING_EXTERNAL",
                  "RECONCILE_REQUIRED",
                  "COMPLETED",
                  "BLOCKED",
                  "FAILED",
                  "CANCELED"
                ]
              },
              "inputRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "outputRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "startedAt": {
                "type": "string",
                "format": "date-time"
              },
              "endedAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "error": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          },
          "reconciliation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operationId",
              "status",
              "observedRefs"
            ],
            "properties": {
              "operationId": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "OPEN",
                  "RESOLVED_EFFECT_PRESENT",
                  "RESOLVED_EFFECT_ABSENT",
                  "MANUAL_DECISION_REQUIRED"
                ]
              },
              "observedRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "v0.5.0/schemas/work-item.schema.json": {
      "sha": "2838e5b1185cc5c650a8dd39330fd8f66aa52216",
      "content": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:safor:work-item:0.5.0",
        "title": "SAFOR Domain-Agnostic Work Item 0.5.0",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "valueStreamId",
          "type",
          "objective",
          "status",
          "requiredCapabilities",
          "authorityRequirements",
          "inputs",
          "expectedOutputs",
          "acceptanceCriteria",
          "dependencies",
          "assignment",
          "review",
          "evidenceRequirements",
          "valueContribution"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          },
          "valueStreamId": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "description": "Factory-defined work-item type. The MASTER kernel must not enumerate domain types."
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PLANNED",
              "READY",
              "ASSIGNED",
              "IN_PROGRESS",
              "HANDOFF_READY",
              "IN_REVIEW",
              "CHANGES_REQUIRED",
              "ACCEPTED",
              "BLOCKED",
              "CANCELED"
            ]
          },
          "requiredCapabilities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "authorityRequirements": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "inputs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "expectedOutputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "assignment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "performerActorId",
              "reviewerActorIds"
            ],
            "properties": {
              "performerActorId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reviewerActorIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "required",
              "independencePolicy",
              "status",
              "evidenceRefs"
            ],
            "properties": {
              "required": {
                "type": "boolean"
              },
              "independencePolicy": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "NOT_REQUIRED",
                  "NOT_STARTED",
                  "PENDING",
                  "CHANGES_REQUIRED",
                  "APPROVED"
                ]
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "evidenceRequirements": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "valueContribution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "evidenceRefs",
              "outcomeRefs"
            ],
            "properties": {
              "status": {
                "enum": [
                  "NOT_DELIVERED",
                  "DELIVERED_CONTRIBUTION"
                ]
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "outcomeRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "$defs": {
          "ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "expectedType": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "v0.5.0/schemas/project.schema.json": {
      "sha": "112636fdb83b4c1285ea10ff844732b95bce1a3e",
      "content": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:safor:project:0.5.0",
        "title": "SAFOR Project Descriptor 0.5.0",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "schemaVersion",
          "projectId",
