        "$id": "urn:safor:bindings:0.5.0",
        "title": "SAFOR Project Bindings 0.5.0",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "schemaVersion",
          "revision",
          "kernel",
          "operatingModel",
          "factory",
          "memoryProvider",
          "workProviderAdapters",
