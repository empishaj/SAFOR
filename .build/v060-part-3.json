{
  "format": "SAFOR_PRODUCT_BUILD_PART",
  "part": 3,
  "modules": {
    "v0.6.0/schemas/execution-state.schema.json": {
      "sha": "4087a70f01eadbf01c3753567929f62262abc76e",
      "content": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:safor:execution-state:0.6.0",
        "title": "SAFOR Execution State 0.6.0",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "schemaVersion",
          "projectId",
          "revision",
          "actorAssignments",
          "contracts",
          "agentJobStateRefs",
          "runs",
          "reconciliation",
          "selfHealing"
        ],
        "properties": {
          "format": {
            "const": "SAFOR_EXECUTION_STATE"
          },
          "schemaVersion": {
            "const": "0.6.0"
          },
          "projectId": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "actorAssignments": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/assignment"
            }
          },
          "contracts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/contract"
            }
          },
          "runs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/run"
            }
          },
          "reconciliation": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/reconciliation"
            }
          },
          "selfHealing": {
            "type": "array",
            "items": {
              "$ref": "self-healing-record.schema.json"
            }
          },
          "agentJobStateRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "description": "References to MASTER-owned master/jobs/{jobId}.json records. Lifecycle fields are not duplicated here."
          }
        },
        "$defs": {
          "assignment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "roleId",
              "actorId",
              "actorKind",
              "capabilities"
            ],
            "properties": {
              "roleId": {
                "type": "string"
              },
              "actorId": {
                "type": "string"
              },
              "actorKind": {
                "enum": [
                  "HUMAN",
                  "AGENT",
                  "SERVICE"
                ]
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          },
          "contract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contractId",
              "workItemId",
              "performerActorId",
              "reviewerActorIds",
              "status",
              "scope"
            ],
            "properties": {
              "contractId": {
                "type": "string"
              },
              "workItemId": {
                "type": "string"
              },
              "performerActorId": {
                "type": "string"
              },
              "reviewerActorIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "status": {
                "enum": [
                  "PREPARED",
                  "ASSIGNED",
                  "IN_PROGRESS",
                  "RESULT_RECORDED",
                  "REWORK_REQUESTED",
                  "ACCEPTED",
                  "SUPERSEDED",
                  "CANCELED",
                  "BLOCKED"
                ]
              },
              "scope": {
                "type": "object"
              }
            }
          },
          "run": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "runId",
              "actionId",
              "operationId",
              "status",
              "inputRefs",
              "outputRefs",
              "evidenceRefs",
              "startedAt",
              "endedAt",
              "error"
            ],
            "properties": {
              "runId": {
                "type": "string"
              },
              "actionId": {
                "type": "string"
              },
              "operationId": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "INTENT_WRITTEN",
                  "RUNNING",
                  "WAITING_HUMAN",
                  "WAITING_EXTERNAL",
                  "RECONCILE_REQUIRED",
                  "COMPLETED",
                  "BLOCKED",
                  "FAILED",
                  "CANCELED"
                ]
              },
              "inputRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "outputRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "startedAt": {
                "type": "string",
                "format": "date-time"
              },
              "endedAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "error": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          },
          "reconciliation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operationId",
              "status",
              "observedRefs"
            ],
            "properties": {
              "operationId": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "OPEN",
                  "RESOLVED_EFFECT_PRESENT",
                  "RESOLVED_EFFECT_ABSENT",
                  "MANUAL_DECISION_REQUIRED"
                ]
              },
              "observedRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "v0.6.0/schemas/work-item.schema.json": {
      "sha": "b703a9589a5ae5e199110ef3f592545755ff9803",
      "content": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:safor:work-item:0.6.0",
        "title": "SAFOR Domain-Agnostic Work Item 0.6.0",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "valueStreamId",
          "type",
          "objective",
          "status",
          "requiredCapabilities",
          "authorityRequirements",
          "inputs",
          "expectedOutputs",
          "acceptanceCriteria",
          "dependencies",
          "assignment",
          "review",
          "evidenceRequirements",
          "valueContribution"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          },
          "valueStreamId": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "description": "Factory-defined work-item type. The MASTER kernel must not enumerate domain types."
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PLANNED",
              "READY",
              "ASSIGNED",
              "IN_PROGRESS",
              "HANDOFF_READY",
              "IN_REVIEW",
              "CHANGES_REQUIRED",
              "ACCEPTED",
              "BLOCKED",
              "CANCELED"
            ]
          },
          "requiredCapabilities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "authorityRequirements": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "inputs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "expectedOutputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "assignment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "performerActorId",
              "reviewerActorIds"
            ],
            "properties": {
              "performerActorId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reviewerActorIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "required",
              "independencePolicy",
              "status",
              "evidenceRefs"
            ],
            "properties": {
              "required": {
                "type": "boolean"
              },
              "independencePolicy": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "NOT_REQUIRED",
                  "NOT_STARTED",
                  "PENDING",
                  "CHANGES_REQUIRED",
                  "APPROVED"
                ]
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "evidenceRequirements": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "valueContribution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "evidenceRefs",
              "outcomeRefs"
            ],
            "properties": {
              "status": {
                "enum": [
                  "NOT_DELIVERED",
                  "DELIVERED_CONTRIBUTION"
                ]
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "outcomeRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "$defs": {
          "ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "expectedType": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "v0.6.0/schemas/project.schema.json": {
      "sha": "6e18f057c58090d8a9613ea278badfc1e38c262b",
      "content": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:safor:project:0.6.0",
        "title": "SAFOR Project Descriptor 0.6.0",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "schemaVersion",
          "projectId",
          "projectSlug",
          "title",
          "owner",
          "creationType",
          "goal",
          "createdAt",
          "controlRepository",
          "workRepositories"
        ],
        "properties": {
          "format": {
            "const": "SAFOR_PROJECT"
          },
          "schemaVersion": {
            "const": "0.6.0"
          },
          "projectId": {
            "type": "string",
            "minLength": 1
          },
          "projectSlug": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "controlRepository": {
            "$ref": "#/$defs/repositoryRef"
          },
          "workRepositories": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/repositoryRef"
            }
          },
          "owner": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider",
              "namespace",
              "stableId"
            ],
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "namespace": {
                "type": "string",
                "minLength": 1
              },
              "stableId": {
                "type": "string",
                "minLength": 1
              },
              "displayName": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "creationType": {
            "enum": [
              "SOFTWARE_WEBSITE",
              "BOOK"
            ]
          }
        },
        "$defs": {
          "repositoryRef": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider",
              "stableId",
              "repository",
              "branch",
              "purpose"
            ],
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "stableId": {
                "type": "string",
                "minLength": 1
              },
              "repository": {
                "type": "string",
                "minLength": 1
              },
              "branch": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "v0.6.0/schemas/bindings.schema.json": {
      "sha": "4e53fee5d362a06f0d7c844e4343111edf46332d",
      "content": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:safor:bindings:0.6.0",
        "title": "SAFOR Project Bindings 0.6.0",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "schemaVersion",
          "revision",
          "kernel",
          "operatingModel",
          "factory",
          "providerAdapters",
          "actorAssignments"
        ],
        "properties": {
          "format": {
            "const": "SAFOR_PROJECT_BINDINGS"
          },
          "schemaVersion": {
            "const": "0.6.0"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "kernel": {
            "$ref": "#/$defs/binding"
          },
          "operatingModel": {
            "$ref": "#/$defs/binding"
          },
          "factory": {
            "$ref": "#/$defs/binding"
          },
          "providerAdapters": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/binding"
            }
          },
          "actorAssignments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "roleId",
                "actorId",
                "actorKind"
              ],
              "properties": {
                "roleId": {
                  "type": "string"
                },
                "actorId": {
                  "type": "string"
                },
                "actorKind": {
                  "enum": [
                    "HUMAN",
                    "AGENT",
                    "SERVICE"
                  ]
                }
              }
            }
          }
        },
        "$defs": {
          "binding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "packageId",
              "version",
              "sourceRef",
              "snapshotRef"
            ],
            "properties": {
              "packageId": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "sourceRef": {
                "type": "string"
              },
              "snapshotRef": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "v0.6.0/schemas/decision-record.schema.json": {
      "sha": "b099d3f56bc410d4cb08265d72ab548e82d32591",
