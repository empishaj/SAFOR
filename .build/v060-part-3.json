          },
          "decisionId": {
            "type": "string"
          },
          "decisionType": {
            "type": "string"
          },
          "authorityId": {
            "type": "string"
          },
          "actorId": {
            "type": "string"
          },
          "scope": {
            "type": "object"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "decision": {
            "type": "string"
          },
          "source": {
