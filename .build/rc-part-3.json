              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 42
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 120
              },
              "intent": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "PRIMARY",
                  "SECONDARY",
                  "UTILITY",
                  "DANGER"
                ]
              },
              "enabled": {
                "type": "boolean"
              },
              "requiresConfirmation": {
                "type": "boolean"
              },
              "visibilityRule": {
                "type": "string",
                "minLength": 1
              },
              "badge": {
                "type": [
