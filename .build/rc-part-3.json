{
  "format": "SAFOR_PRODUCT_BUILD_PART",
  "part": 3,
  "source": {
    "repository": "empishaj/SAFOR",
    "ref": "safor/product-ready-v0.4.0"
  },
  "modules": {
    "v0.4.0/schemas/work-item.schema.json": {
      "sha": "23f3bea85448d26df771686d1fe25cad3cd4a0cc",
      "content": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:saf:work-item:0.4.0",
        "title": "SAF Domain-Agnostic Work Item 0.4.0",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "valueStreamId",
          "type",
          "objective",
          "status",
          "requiredCapabilities",
          "authorityRequirements",
          "inputs",
          "expectedOutputs",
          "acceptanceCriteria",
          "dependencies",
          "assignment",
          "review",
          "evidenceRequirements",
          "valueContribution"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          },
          "valueStreamId": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "description": "Factory-defined work-item type. The MASTER kernel must not enumerate domain types."
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PLANNED",
              "READY",
              "ASSIGNED",
              "IN_PROGRESS",
              "HANDOFF_READY",
              "IN_REVIEW",
              "CHANGES_REQUIRED",
              "ACCEPTED",
              "BLOCKED",
              "CANCELED"
            ]
          },
          "requiredCapabilities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "authorityRequirements": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "inputs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "expectedOutputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "assignment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "performerActorId",
              "reviewerActorIds"
            ],
            "properties": {
              "performerActorId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reviewerActorIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "required",
              "independencePolicy",
              "status",
              "evidenceRefs"
            ],
            "properties": {
              "required": {
                "type": "boolean"
              },
              "independencePolicy": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "NOT_REQUIRED",
                  "NOT_STARTED",
                  "PENDING",
                  "CHANGES_REQUIRED",
                  "APPROVED"
                ]
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "evidenceRequirements": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "valueContribution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "evidenceRefs",
              "outcomeRefs"
            ],
            "properties": {
              "status": {
                "enum": [
                  "NOT_DELIVERED",
                  "DELIVERED_CONTRIBUTION"
                ]
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "outcomeRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "$defs": {
          "ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "expectedType": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "v0.4.0/schemas/project.schema.json": {
      "sha": "0bddb70576fad1bace7ede9b069a4424829e498a",
      "content": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:saf:project:0.4.0",
        "title": "SAF Project Descriptor 0.4.0",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "schemaVersion",
          "projectId",
          "projectSlug",
          "title",
          "owner",
          "creationType",
          "goal",
          "createdAt",
          "controlRepository",
          "workRepositories"
        ],
        "properties": {
          "format": {
            "const": "SAF_PROJECT"
          },
          "schemaVersion": {
            "const": "0.4.0"
          },
          "projectId": {
            "type": "string",
            "minLength": 1
          },
          "projectSlug": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "controlRepository": {
            "$ref": "#/$defs/repositoryRef"
          },
          "workRepositories": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/repositoryRef"
            }
          },
          "owner": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider",
              "namespace",
              "stableId"
            ],
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "namespace": {
                "type": "string",
                "minLength": 1
              },
              "stableId": {
                "type": "string",
                "minLength": 1
              },
              "displayName": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "creationType": {
            "enum": [
              "SOFTWARE_WEBSITE",
              "BOOK"
            ]
          }
        },
        "$defs": {
          "repositoryRef": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider",
              "stableId",
              "repository",
              "branch",
              "purpose"
            ],
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "stableId": {
                "type": "string",
                "minLength": 1
              },
              "repository": {
                "type": "string",
                "minLength": 1
              },
              "branch": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
