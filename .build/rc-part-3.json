    "v0.4.0/conformance.json": {
      "sha": "48da4b94f6fd2c738ab17a5a257a1e6247a64600",
      "content": {
        "format": "SAF_CONFORMANCE_SUITE",
        "schemaVersion": "0.4.0",
        "purpose": "Declarative architecture checks for the modular SAF MASTER baseline.",
        "assertions": [
          {
            "id": "CF-001",
            "statement": "SAF-MASTER.json is the single portable bootstrap entrypoint.",
            "expected": true
          },
          {
            "id": "CF-002",
            "statement": "Kernel requires OPERATING_MODEL, FACTORY and PROVIDER_ADAPTER bindings.",
            "expected": true
          },
          {
            "id": "CF-003",
            "statement": "Factory packages reference capabilities/authorities but contain no roleId bindings.",
            "expected": true
          },
          {
            "id": "CF-004",
            "statement": "Every capability required by the software factory is exported by the SaaS engineering operating model.",
            "expected": true
          },
          {
            "id": "CF-005",
            "statement": "Every authority required by the software factory is exported by the SaaS engineering operating model.",
            "expected": true
          },
          {
            "id": "CF-006",
            "statement": "Every capability required by the book factory is exported by the book authoring operating model.",
            "expected": true
          },
          {
            "id": "CF-007",
            "statement": "Every authority required by the book factory is exported by the book authoring operating model.",
            "expected": true
          },
          {
            "id": "CF-008",
            "statement": "Provider adapters export only capabilities known to the kernel provider capability vocabulary.",
            "expected": true
          },
          {
            "id": "CF-009",
            "statement": "Global schemas contain no safomwebsite-specific migration constant.",
            "expected": true
          },
          {
            "id": "CF-010",
            "statement": "Work-item type is a factory-defined string and is not a kernel domain enum.",
            "expected": true
          },
          {
            "id": "CF-011",
            "statement": "Control, value-stream and execution states are separate aggregates.",
            "expected": true
          },
          {
            "id": "CF-012",
            "statement": "Delivery completion is distinct from outcome validation.",
            "expected": true
          },
          {
            "id": "CF-013",
            "statement": "Kernel references a dedicated interaction model and interaction-menu schema.",
            "expected": true
          },
          {
            "id": "CF-014",
            "statement": "A state-aware menu is required at user-relevant stable checkpoints.",
            "expected": true
          },
          {
            "id": "CF-015",
            "statement": "NEXT_ROUND is bounded by existing authorization and stops before any new human decision or authority expansion.",
            "expected": true
          },
          {
            "id": "CF-016",
            "statement": "Native clickable actions are preferred only when the host actually exposes a supported interaction capability.",
            "expected": true
          },
          {
            "id": "CF-017",
            "statement": "Recommendations are advisory until explicitly selected and are ranked from current state/evidence.",
            "expected": true
          },
          {
            "id": "CF-018",
            "statement": "Danger actions are visually separated and require confirmation.",
            "expected": true
          },
          {
            "id": "CF-019",
            "statement": "Direct HUMAN communication uses the SAF_HUMAN_BUDDY profile.",
            "expected": true
          },
          {
            "id": "CF-020",
            "statement": "Routine checkpoint communication is concise by default and governed by explicit response budgets.",
            "expected": true
          },
          {
            "id": "CF-021",
            "statement": "HUMAN messages lead with the useful result, decision or next action instead of tool/process narration.",
            "expected": true
          },
          {
            "id": "CF-022",
            "statement": "Technical state and evidence detail are progressively disclosed through Details unless immediately necessary.",
            "expected": true
          },
          {
            "id": "CF-023",
