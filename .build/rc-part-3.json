              "mode": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "headline": {
                "type": "string",
                "minLength": 1,
                "maxLength": 90
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 280
              },
              "progressLabel": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 80
              },
              "currentWorkLabel": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 100
              }
            }
          },
          "presentation": {
