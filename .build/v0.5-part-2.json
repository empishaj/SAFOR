              "providerOperation": "read_pipeline_or_job_evidence"
            },
            {
              "capability": "provider.issue.read",
              "providerOperation": "read_issue"
            },
            {
              "capability": "provider.issue.write",
              "providerOperation": "create_or_update_issue"
            }
          ],
          "runtimeBinding": {
