        "packageId": "safor.provider.plastic-scm",
        "packageKind": "PROVIDER_ADAPTER",
        "version": "0.1.0",
        "name": "Plastic SCM / Unity Version Control Provider Adapter",
        "description": "Conceptual provider contract for Plastic SCM / Unity Version Control installations. Actual execution requires host-exposed tools or an organization-specific connector.",
        "compatibility": {
          "kernel": ">=0.5.0 <0.6.0"
        },
        "exports": {
          "capabilities": [],
          "authorities": [],
          "workItemTypes": [],
          "artifactTypes": [],
          "memoryCapabilities": [],
          "providerCapabilities": [
            "provider.identity.read",
            "provider.repository.list",
            "provider.repository.read",
            "provider.repository.create",
            "provider.artifact.read",
            "provider.artifact.write",
            "provider.history.read",
            "provider.branch.read",
            "provider.branch.write"
          ]
        },
        "dependencies": [],
        "model": {
          "providerId": "plastic-scm",
          "terminology": {
            "repository": "repository",
            "branch": "branch_or_stream",
            "revision": "changeset",
            "changeRequest": "merge_or_code_review_when_exposed"
          },
          "runtimeBinding": {
            "strategy": "DISCOVER_ACTUAL_HOST_TOOLS",
