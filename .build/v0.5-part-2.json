    "v0.5.0/providers/github/0.1.0/package.json": {
      "sha": "40db0272b2b2f10cbe8078255552998431e231fe",
      "content": {
        "format": "SAFOR_PACKAGE_MANIFEST",
        "schemaVersion": "0.5.0",
        "packageId": "safor.provider.github",
        "packageKind": "PROVIDER_ADAPTER",
        "version": "0.1.0",
        "name": "GitHub Provider Adapter Contract",
        "description": "Provider-neutral capability mapping for GitHub. The adapter declares semantics only; actual host tool names and permissions are discovered at runtime.",
        "compatibility": {
          "kernel": ">=0.5.0 <0.6.0"
        },
        "exports": {
          "capabilities": [],
          "authorities": [],
          "workItemTypes": [],
          "artifactTypes": [],
          "providerCapabilities": [
            "provider.identity.read",
            "provider.namespace.list",
            "provider.repository.list",
            "provider.repository.read",
            "provider.repository.create",
            "provider.artifact.read",
            "provider.artifact.write",
            "provider.history.read",
            "provider.branch.read",
            "provider.branch.write",
            "provider.change_request.read",
            "provider.change_request.write",
            "provider.change_request.merge",
            "provider.checks.read",
            "provider.issue.read",
            "provider.issue.write"
          ],
          "memoryCapabilities": []
        },
        "dependencies": [],
        "model": {
          "providerId": "github",
          "terminology": {
            "changeRequest": "pull_request",
            "repository": "repository",
            "branch": "branch",
            "issue": "issue",
            "checks": "checks_or_actions"
          },
          "capabilitySemantics": [
            {
              "capability": "provider.identity.read",
              "providerOperation": "read_authenticated_identity"
            },
            {
              "capability": "provider.repository.list",
              "providerOperation": "list_repositories_for_selected_owner_with_activity_metadata"
            },
            {
              "capability": "provider.namespace.list",
              "providerOperation": "list_authenticated_user_and_accessible_organization_namespaces"
            },
            {
              "capability": "provider.repository.read",
              "providerOperation": "read_repository_metadata_and_stable_id"
            },
            {
              "capability": "provider.repository.create",
              "providerOperation": "create_repository_after_explicit_authorization"
            },
            {
              "capability": "provider.artifact.read",
              "providerOperation": "read_repository_file_at_ref"
            },
            {
              "capability": "provider.artifact.write",
              "providerOperation": "write_repository_file_with_revision_control"
            },
            {
              "capability": "provider.history.read",
              "providerOperation": "read_commit_history_or_revision"
            },
            {
              "capability": "provider.branch.read",
              "providerOperation": "read_branch_or_ref"
            },
            {
              "capability": "provider.branch.write",
              "providerOperation": "create_or_update_branch_with_expected_revision_when_supported"
            },
            {
              "capability": "provider.change_request.read",
              "providerOperation": "read_pull_request_and_review_evidence"
            },
            {
              "capability": "provider.change_request.write",
              "providerOperation": "create_or_update_pull_request"
            },
            {
              "capability": "provider.change_request.merge",
              "providerOperation": "merge_pull_request_when_authorized_and_checks_allow"
            },
            {
              "capability": "provider.checks.read",
              "providerOperation": "read_checks_or_workflow_evidence"
            },
            {
              "capability": "provider.issue.read",
              "providerOperation": "read_issue"
            },
            {
              "capability": "provider.issue.write",
              "providerOperation": "create_or_update_issue"
            }
          ],
          "runtimeBinding": {
            "strategy": "DISCOVER_ACTUAL_HOST_TOOLS",
            "rule": "Never treat this manifest as proof that a host exposes a GitHub tool or that the authenticated account has a permission."
          },
          "writeSafety": {
            "readCurrentRevisionBeforeWrite": true,
            "readbackAfterWrite": true,
            "unknownOutcome": "RECONCILE_REQUIRED"
          },
          "initializationSupport": {
            "ownerResolution": {
              "personalNamespace": "authenticated_user_login",
              "organizationNamespaces": "accessible_organizations",
              "stableIdentity": "provider_owner_id_when_available"
            },
            "permissionVerification": {
              "baseline": "Prove repository metadata read plus content/artifact write and branch write through actual host/provider capabilities.",
              "ownerScoped": "After owner selection, verify that repositories under the owner can be listed and target repositories can be read/written.",
              "newProject": "Repository creation capability is additionally required for NEW mode."
            },
            "recentRepositoryDiscovery": {
              "activityWindowDays": 7,
              "fields": [
                "updated_at",
                "pushed_at"
              ],
              "normalizedField": "lastActivityAt",
              "rule": "Use the most recent trustworthy activity timestamp; updated_at is primary for broad repository activity and pushed_at is retained as supporting code activity.",
              "fallback": "latest_default_branch_commit_at",
              "sort": "lastActivityAt DESC"
            }
          }
        }
      }
    },
