{
  "format": "SAFOR_BUNDLE_BUILD_PART",
  "part": 5,
  "modules": {
    "v0.5.0/schemas/memory-binding.schema.json": {
      "sha": "1c9611d68886d22e152bb7519226a7fa9ef8f2c4",
      "content": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:safor:memory-binding:0.5.0",
        "title": "SAFOR Memory Binding 0.5.0",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "schemaVersion",
          "memoryId",
          "mode",
          "owner",
          "provider",
          "location",
          "verifiedCapabilities",
          "concurrency",
          "lastVerifiedAt"
        ],
        "properties": {
          "format": {
            "const": "SAFOR_MEMORY_BINDING"
          },
          "schemaVersion": {
            "const": "0.5.0"
          },
          "memoryId": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "PERSONAL",
              "SHARED_TEAM"
            ]
          },
          "owner": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ownerKind",
              "ownerRef"
            ],
            "properties": {
              "ownerKind": {
                "enum": [
                  "HUMAN",
                  "ORGANIZATION"
                ]
              },
              "ownerRef": {
                "type": "string",
                "minLength": 1
              },
              "displayName": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "provider": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "packageId",
              "version",
              "providerType"
            ],
            "properties": {
              "packageId": {
                "type": "string",
                "pattern": "^safor\\.memory\\."
              },
              "version": {
                "type": "string"
              },
              "providerType": {
                "enum": [
                  "VERSIONED_REPOSITORY",
                  "HOST_FILESYSTEM",
                  "CUSTOM"
                ]
              }
            }
          },
          "location": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "stableRef"
            ],
            "properties": {
              "stableRef": {
                "type": "string",
                "minLength": 1
              },
              "displayRef": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "verifiedCapabilities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "concurrency": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "strategy",
              "revisionRef"
            ],
            "properties": {
              "strategy": {
                "enum": [
                  "COMPARE_AND_SWAP",
                  "LOCK",
                  "SINGLE_WRITER"
                ]
              },
              "revisionRef": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "lockRef": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "lastVerifiedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "v0.5.0/schemas/session-record.schema.json": {
      "sha": "728643a7f9beae36da36c508ffebec389a27a78e",
      "content": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:safor:session-record:0.5.0",
        "title": "SAFOR Session Record 0.5.0",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "schemaVersion",
          "sessionId",
          "projectId",
          "actorId",
          "actorKind",
          "host",
          "llm",
          "baseMemoryRevision",
          "startedAt"
        ],
        "properties": {
          "format": {
            "const": "SAFOR_SESSION_RECORD"
          },
          "schemaVersion": {
            "const": "0.5.0"
          },
          "sessionId": {
            "type": "string",
            "minLength": 1
          },
          "projectId": {
            "type": "string",
            "minLength": 1
          },
          "actorId": {
            "type": "string",
            "minLength": 1
          },
          "actorKind": {
            "enum": [
              "HUMAN",
              "AGENT",
              "SERVICE"
            ]
          },
          "host": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "product"
            ],
            "properties": {
              "product": {
                "type": "string",
                "minLength": 1
              },
              "instanceRef": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "llm": {
            "$ref": "#/$defs/llm"
          },
          "baseMemoryRevision": {
            "type": [
              "string",
              "integer",
              "null"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "endedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "$defs": {
          "llm": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "used",
              "observability"
            ],
            "properties": {
              "used": {
                "type": "boolean"
              },
              "observability": {
                "enum": [
                  "OBSERVED",
                  "PARTIALLY_OBSERVED",
                  "NOT_EXPOSED"
                ]
              },
              "provider": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "model": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "modelVersion": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "v0.5.0/schemas/output-record.schema.json": {
      "sha": "97dbbe1e1cd5692e5de742c91ee491bc1babb40a",
      "content": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:safor:output-record:0.5.0",
        "title": "SAFOR Output Provenance Record 0.5.0",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "schemaVersion",
          "outputId",
          "projectId",
          "artifactRef",
          "createdAt",
          "producer",
          "llm",
          "safor",
          "inputRefs",
          "evidenceRefs",
          "memoryRevision"
        ],
        "properties": {
          "format": {
            "const": "SAFOR_OUTPUT_RECORD"
          },
          "schemaVersion": {
            "const": "0.5.0"
          },
          "outputId": {
            "type": "string",
            "minLength": 1
          },
          "projectId": {
            "type": "string",
            "minLength": 1
          },
          "workItemId": {
            "type": [
              "string",
              "null"
            ]
          },
          "artifactRef": {
            "type": "string",
            "minLength": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "producer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "actorId",
              "actorKind",
              "sessionId"
            ],
            "properties": {
              "actorId": {
                "type": "string"
              },
              "actorKind": {
                "enum": [
                  "HUMAN",
                  "AGENT",
                  "SERVICE"
                ]
              },
              "roleId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sessionId": {
                "type": "string"
              }
            }
          },
          "llm": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "used",
              "observability",
              "provider",
              "model",
              "modelVersion"
            ],
            "properties": {
              "used": {
                "type": "boolean"
              },
              "observability": {
                "enum": [
                  "OBSERVED",
                  "PARTIALLY_OBSERVED",
                  "NOT_EXPOSED"
                ]
              },
              "provider": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "model": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "modelVersion": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "safor": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "protocolVersion",
              "kernelVersion",
              "factoryPackageId",
              "factoryVersion",
              "operatingModelPackageId",
              "operatingModelVersion"
            ],
            "properties": {
              "protocolVersion": {
                "const": "0.5.0"
              },
              "kernelVersion": {
                "const": "0.5.0"
              },
              "factoryPackageId": {
                "type": "string"
              },
              "factoryVersion": {
                "type": "string"
              },
              "operatingModelPackageId": {
                "type": "string"
              },
              "operatingModelVersion": {
                "type": "string"
              }
            }
          },
          "inputRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "memoryRevision": {
            "type": [
              "string",
              "integer"
            ]
          },
          "contentIntegrity": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "algorithm": {
                "type": "string"
              },
              "digest": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "v0.5.0/schemas/decision-record.schema.json": {
      "sha": "c202dc2d3e4b5b56cbabb51f4def1e37dd8cdfcb",
      "content": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:safor:decision-record:0.5.0",
        "title": "SAFOR Decision Record 0.5.0",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "schemaVersion",
          "decisionId",
          "decisionType",
          "authorityId",
          "actorId",
          "sessionId",
          "scope",
          "revision",
          "memoryRevision",
          "decision",
          "source",
          "createdAt",
          "evidenceRefs"
        ],
        "properties": {
          "format": {
            "const": "SAFOR_DECISION_RECORD"
          },
          "schemaVersion": {
            "const": "0.5.0"
          },
          "decisionId": {
            "type": "string"
          },
          "decisionType": {
            "type": "string"
          },
          "authorityId": {
            "type": "string"
          },
          "actorId": {
            "type": "string"
          },
          "sessionId": {
            "type": "string"
          },
          "scope": {
            "type": "object"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "memoryRevision": {
            "type": [
              "string",
              "integer"
            ]
          },
          "decision": {
            "type": "string"
          },
          "source": {
            "enum": [
              "DIRECT_HUMAN_INPUT",
