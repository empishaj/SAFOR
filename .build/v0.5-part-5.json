    "v0.5.0/schemas/interaction-menu.schema.json": {
      "sha": "9ac24cadf990eb0548472a5ea8a69fb3d28f0fdb",
      "content": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:safor:interaction-menu:0.5.0",
        "title": "SAFOR Interaction Menu 0.5.0",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "schemaVersion",
          "menuId",
          "context",
          "presentation",
          "items"
        ],
        "properties": {
          "format": {
            "const": "SAFOR_INTERACTION_MENU"
          },
          "schemaVersion": {
            "const": "0.5.0"
          },
          "menuId": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "projectId",
              "projectTitle",
              "mode",
              "status",
              "headline",
              "summary"
            ],
            "properties": {
              "projectId": {
                "type": "string"
              },
              "projectTitle": {
                "type": "string"
              },
              "mode": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "headline": {
                "type": "string",
                "minLength": 1,
                "maxLength": 90
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 280
              },
              "progressLabel": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 80
              },
              "currentWorkLabel": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 100
              }
            }
          },
          "presentation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "preferredSurface",
              "fallbackSurface",
              "visualProfile"
            ],
            "properties": {
              "preferredSurface": {
                "enum": [
                  "NATIVE_ACTIONS",
                  "NATIVE_SINGLE_SELECT",
                  "NATIVE_MULTI_SELECT",
                  "NATIVE_RICH_CARDS",
                  "NATIVE_MARKDOWN"
                ]
              },
              "fallbackSurface": {
                "const": "NATIVE_MARKDOWN"
              },
              "visualProfile": {
                "const": "SAFOR_CHAT_NATIVE"
              }
            }
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "$ref": "#/$defs/item"
            }
          }
        },
        "$defs": {
          "item": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "intent",
              "kind",
              "enabled",
              "requiresConfirmation",
              "visibilityRule"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 42
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 120
              },
              "intent": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "PRIMARY",
                  "SECONDARY",
                  "UTILITY",
                  "DANGER"
                ]
              },
              "enabled": {
                "type": "boolean"
              },
              "requiresConfirmation": {
                "type": "boolean"
              },
              "visibilityRule": {
                "type": "string",
                "minLength": 1
              },
              "badge": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 24
              }
            }
          }
        }
      }
    },
    "v0.5.0/schemas/self-healing-record.schema.json": {
      "sha": "c6a6ae84de4380dee160de946e3f07fb6d759c29",
      "content": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:safor:self-healing-record:0.5.0",
        "title": "SAFOR Self-Healing Record 0.5.0",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repairId",
          "failureClass",
          "failureFingerprint",
          "subjectRef",
          "sessionId",
          "status",
          "proposedAction",
          "authorityBasis",
          "attemptNumber",
          "preMemoryRevision",
          "postMemoryRevision",
          "preStateRefs",
          "successEvidenceRequirements",
          "evidenceRefs",
          "startedAt",
          "endedAt",
          "outcome"
        ],
        "properties": {
          "repairId": {
            "type": "string",
            "minLength": 1
          },
          "failureClass": {
            "type": "string",
            "pattern": "^SH-[0-9]{2}$"
          },
          "failureFingerprint": {
            "type": "string",
            "minLength": 1
          },
          "subjectRef": {
            "type": "string",
            "minLength": 1
          },
          "sessionId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PLANNED",
              "RUNNING",
              "VERIFYING",
              "SUCCEEDED",
              "FAILED",
              "ESCALATED",
              "CANCELED"
            ]
          },
          "proposedAction": {
            "type": "string",
            "minLength": 1
          },
          "authorityBasis": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "attemptNumber": {
            "type": "integer",
            "minimum": 1
          },
          "preMemoryRevision": {
            "type": [
              "string",
              "integer",
              "null"
            ]
          },
          "postMemoryRevision": {
            "type": [
              "string",
              "integer",
              "null"
            ]
          },
          "preStateRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "successEvidenceRequirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rollbackRef": {
            "type": [
              "string",
              "null"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "endedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "outcome": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
