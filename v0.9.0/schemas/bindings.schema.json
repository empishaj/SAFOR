{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:safor:bindings:0.9.0",
  "title": "SAFOR Project Bindings 0.9.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "revision",
    "kernel",
    "operatingModel",
    "factory",
    "providerAdapters",
    "actorAssignments"
  ],
  "properties": {
    "format": {
      "const": "SAFOR_PROJECT_BINDINGS"
    },
    "schemaVersion": {
      "const": "0.9.0"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "kernel": {
      "$ref": "#/$defs/binding"
    },
    "operatingModel": {
      "$ref": "#/$defs/binding"
    },
    "factory": {
      "$ref": "#/$defs/binding"
    },
    "providerAdapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "actorAssignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "roleId",
          "actorId",
          "actorKind"
        ],
        "properties": {
          "roleId": {
            "type": "string"
          },
          "actorId": {
            "type": "string"
          },
          "actorKind": {
            "enum": [
              "HUMAN",
              "AGENT",
              "SERVICE"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId",
        "version",
        "sourceRef",
        "snapshotRef"
      ],
      "properties": {
        "packageId": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "sourceRef": {
          "type": "string"
        },
        "snapshotRef": {
          "type": "string"
        }
      }
    }
  }
}
