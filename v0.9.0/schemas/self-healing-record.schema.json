{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:safor:self-healing-record:0.9.0",
  "title": "SAFOR Self-Healing Record 0.9.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repairId",
    "failureClass",
    "failureFingerprint",
    "moduleKey",
    "moduleProfileId",
    "moduleAuthorityType",
    "moduleRepairability",
    "moduleSourceRef",
    "subjectRef",
    "status",
    "profileDecision",
    "proposedAction",
    "authorityBasis",
    "attemptNumber",
    "preStateRefs",
    "successEvidenceRequirements",
    "evidenceRefs",
    "startedAt",
    "endedAt",
    "outcome"
  ],
  "properties": {
    "repairId": {
      "type": "string",
      "minLength": 1
    },
    "failureClass": {
      "type": "string",
      "pattern": "^SH-[0-9]{2}$"
    },
    "failureFingerprint": {
      "type": "string",
      "minLength": 1
    },
    "subjectRef": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PLANNED",
        "RUNNING",
        "VERIFYING",
        "SUCCEEDED",
        "FAILED",
        "ESCALATED",
        "CANCELED",
        "RECONCILE_REQUIRED"
      ]
    },
    "proposedAction": {
      "type": "string",
      "minLength": 1
    },
    "authorityBasis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "attemptNumber": {
      "type": "integer",
      "minimum": 1
    },
    "preStateRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "successEvidenceRequirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollbackRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "endedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "outcome": {
      "type": [
        "string",
        "null"
      ]
    },
    "moduleKey": {
      "type": "string",
      "minLength": 1
    },
    "moduleProfileId": {
      "type": "string",
      "pattern": "^MRP-[A-Z0-9_-]+$"
    },
    "moduleAuthorityType": {
      "enum": [
        "EMBEDDED_BOOTSTRAP_AUTHORITY",
        "PINNED_CANONICAL_SOURCE",
        "DERIVED_RUNTIME_PROJECTION",
        "EXTERNAL_PROVIDER_BOUND"
      ]
    },
    "moduleRepairability": {
      "enum": [
        "IMMUTABLE_VALIDATE_ONLY",
        "RESTORE_FROM_VERIFIED_SOURCE",
        "REGENERATE_DERIVED_ONLY",
        "REBIND_EXTERNAL_CAPABILITY"
      ]
    },
    "moduleSourceRef": {
      "type": "string",
      "minLength": 1
    },
    "profileDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failureClassAction",
        "profileAllowedActions",
        "selectedAction",
        "selectionReason"
      ],
      "properties": {
        "failureClassAction": {
          "type": "string",
          "minLength": 1
        },
        "profileAllowedActions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "selectedAction": {
          "type": [
            "string",
            "null"
          ]
        },
        "selectionReason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
