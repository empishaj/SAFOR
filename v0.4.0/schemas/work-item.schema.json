{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:saf:work-item:0.4.0",
  "title": "SAF Domain-Agnostic Work Item 0.4.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "valueStreamId",
    "type",
    "objective",
    "status",
    "requiredCapabilities",
    "authorityRequirements",
    "inputs",
    "expectedOutputs",
    "acceptanceCriteria",
    "dependencies",
    "assignment",
    "review",
    "evidenceRequirements",
    "valueContribution"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "valueStreamId": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "description": "Factory-defined work-item type. The MASTER kernel must not enumerate domain types."
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PLANNED",
        "READY",
        "ASSIGNED",
        "IN_PROGRESS",
        "HANDOFF_READY",
        "IN_REVIEW",
        "CHANGES_REQUIRED",
        "ACCEPTED",
        "BLOCKED",
        "CANCELED"
      ]
    },
    "requiredCapabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "authorityRequirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "expectedOutputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performerActorId",
        "reviewerActorIds"
      ],
      "properties": {
        "performerActorId": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewerActorIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "independencePolicy",
        "status",
        "evidenceRefs"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "independencePolicy": {
          "type": "string"
        },
        "status": {
          "enum": [
            "NOT_REQUIRED",
            "NOT_STARTED",
            "PENDING",
            "CHANGES_REQUIRED",
            "APPROVED"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidenceRequirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "valueContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidenceRefs",
        "outcomeRefs"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_DELIVERED",
            "DELIVERED_CONTRIBUTION"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outcomeRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "expectedType": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
