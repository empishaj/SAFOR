    "separationOfDuties": [
      {
        "id": "SOD-TECH-REVIEW",
        "rule": "When a factory work item requires independent technical review, the approving reviewer actor must differ from the contribution author actor."
      },
      {
        "id": "SOD-SECURITY",
        "rule": "Security evidence may not be substituted by the implementation author's self-attestation when independent security review is required."
      }
