{
  "format": "SAFOR_PACKAGE_DISTRIBUTION_MODEL",
  "schemaVersion": "0.14.0",
  "id": "safor-package-distribution",
  "purpose": "Separate public Framework distribution from independently selectable, chat-loadable Factory and Operating Model JSON packages with per-package access and immutable compatibility binding.",
  "principles": {
    "frameworkDoesNotOwnDomainPackages": true,
    "paidContentExcludedFromPublicFramework": true,
    "publicMetadataMayDescribePaidPackages": true,
    "freePackagesMayResolveFromCanonicalPublicRepo": true,
    "loadedPackagesPinnedBeforeUse": true,
    "packageSourceNeverImplicitProjectWorkspace": true,
    "entitlementSeparateFromOrganizationalAuthority": true,
    "factoryAndOperatingModelIndependentlySelectable": true,
    "creationProfilesProvideDefaultsOnly": true,
    "accessEvaluatedPerSelectedPackage": true,
    "mixedFreeAndPaidPairAllowed": true,
    "entitlementEvidenceExternalToPackageArtifact": true,
    "domainPackageIntegrityRequired": true,
    "compatibilityDecisionRequiredBeforeBinding": true,
    "websiteStarterIsFreePublic": true,
    "softwareSaasRequiresPaidFactoryAndOperatingModel": true,
    "creationProfileMayConstrainSelectedAccessModes": true,
    "commercialDeliveryEvidenceRequiredForEntitledSource": true,
    "deliveryArtifactDigestMustMatchPackageIntegrity": true,
    "trustedDeliveryVerifierRequired": true,
    "deliveryEvidenceExternalToPackageArtifact": true
  },
  "sourceClasses": {
    "PUBLIC_CANONICAL_REPOSITORY": {
      "allowedAccessModes": [
        "FREE_PUBLIC"
      ],
      "canonicalRepository": "empishaj/SAFOR",
      "mutableRefMayNotBePersistedAsPin": true,
      "requireImmutableProviderRevisionAndBlob": true
    },
    "HUMAN_LOADED_PACKAGE": {
      "allowedAccessModes": [
        "FREE_PUBLIC",
        "PAID_ENTITLEMENT_REQUIRED"
      ],
      "rule": "Loaded package content must validate. Paid content may be manually supplied by the HUMAN, but it still requires strict active entitlement verification; manual loading never self-authorizes use."
    },
    "ENTITLED_PACKAGE_SOURCE": {
      "allowedAccessModes": [
        "PAID_ENTITLEMENT_REQUIRED"
      ],
      "requires": [
        "STRICT_VERIFIED_ENTITLEMENT",
        "SAFOR_COMMERCIAL_PACKAGE_DELIVERY_EVIDENCE",
        "TRUSTED_DELIVERY_VERIFIER",
        "DELIVERY_TIME_VALID",
        "DELIVERY_PACKAGE_VERSION_MATCH",
        "DELIVERY_ARTIFACT_DIGEST_MATCH"
      ],
      "rule": "Resolve package bytes only after strict entitlement verification. Delivery evidence must bind the entitlement, exact package/version and artifact digest. Package bytes remain separate from the public Framework."
    },
    "PROJECT_PINNED_SNAPSHOT": {
      "discoveryAllowed": false,
      "rule": "May reproduce an already approved project binding only; never expands package access."
    }
  },
  "resolutionOrder": [
    "STRICT_ENTITLEMENT_VERIFICATION_FOR_PAID_SELECTION",
    "EXPLICIT_HUMAN_LOADED_PACKAGE",
    "VERIFIED_ENTITLED_PACKAGE_SOURCE_WITH_DELIVERY_EVIDENCE",
    "PUBLIC_CANONICAL_REPOSITORY_FOR_FREE_PUBLIC_ONLY"
  ],
  "freeStarterProfile": {
    "creationType": "WEBSITE",
    "defaultFactoryPackageId": "safor.factory.website-delivery",
    "defaultOperatingModelPackageId": "safor.om.website-team",
    "sourceClass": "PUBLIC_CANONICAL_REPOSITORY",
    "autoResolveDefaultsWhenNotExplicitlyOverridden": true
  },
  "paidPathRule": "A PAID_ENTITLEMENT_REQUIRED selected package is never resolved from PUBLIC_CANONICAL_REPOSITORY; its model content is never embedded in the public Framework bundle and it must carry separately verifiable entitlement evidence before use.",
  "selectionRule": "Resolve creation-profile defaults, apply HUMAN-approved overrides, then enforce the profile selectedPackageAccessPolicy before package access. WEBSITE allows compatible free/paid composition; SOFTWARE_SAAS and BOOK require both selected packages to be paid and independently entitled.",
  "mixedAccessRule": "Mixed FREE_PUBLIC and PAID_ENTITLEMENT_REQUIRED packages are permitted only when the active creation profile allows ANY_COMPATIBLE_ACCESS. Profiles marked BOTH_PAID_ENTITLEMENT_REQUIRED reject any free selected member.",
  "commercialCreationProfiles": {
    "SOFTWARE_SAAS": {
      "selectedPackageAccessPolicy": "BOTH_PAID_ENTITLEMENT_REQUIRED",
      "defaultFactoryPackageId": "safor.factory.software-delivery",
      "defaultOperatingModelPackageId": "safor.om.saas-engineering",
      "publicModelResolutionForbidden": true
    },
    "BOOK": {
      "selectedPackageAccessPolicy": "BOTH_PAID_ENTITLEMENT_REQUIRED",
      "defaultFactoryPackageId": "safor.factory.book-production",
      "defaultOperatingModelPackageId": "safor.om.book-authoring",
      "publicModelResolutionForbidden": true
    }
  },
  "commercialDeliveryContract": {
    "sequence": [
      "VERIFY_COMMERCIAL_BASIS_AND_ENTITLEMENT",
      "VERIFY_ENTITLEMENT_STATUS_TIME_SUBJECT_AND_TRUST",
      "AUTHORIZE_ENTITLED_SOURCE_READ",
      "VERIFY_DELIVERY_EVIDENCE",
      "VERIFY_DOMAIN_PACKAGE_DIGEST",
      "CONTINUE_TO_PACKAGE_COMPATIBILITY_AND_BINDING"
    ],
    "noPublicFallback": true,
    "noDeliveryWithoutEntitlement": true,
    "noBindingFromExpiredDeliveryEvidence": true,
    "noDigestSubstitution": true,
    "humanLoadedLicensedArtifactSupported": true
  }
}
