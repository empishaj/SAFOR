{
  "format": "SAFOR_INITIALIZATION_MODEL",
  "schemaVersion": "0.14.0",
  "id": "SAFOR-GUIDED-INITIALIZATION-0.14",
  "purpose": "Guided initialization for the declarative SAFOR chat product, project workspace and one-time chat-bound agent identities; no customer-installed runtime is required.",
  "entryBehavior": {
    "autoStartAfterBootstrapLoad": true,
    "firstHumanSurface": "CREATION_TYPE_SELECTION_MENU",
    "noProjectWorkBeforeComplete": true,
    "completionPredicate": "FRAMEWORK_VERIFIED_AND_PACKAGES_RESOLVED_AND_COMPATIBLE_AND_PROJECT_WORKSPACE_VERIFIED_AND_CONTROL_WORKSPACE_VERIFIED",
    "domainFrameworkDistributionAware": true,
    "preselectedDomainRule": "When the loaded container format is SAFOR_DOMAIN_FRAMEWORK_DISTRIBUTION, use its domain and embedded default Factory/Operating Model as the initial selection and suppress redundant creation-type selection."
  },
  "sequence": [
    {
      "id": "INIT-00",
      "operation": "VERIFY_EMBEDDED_MODULE_RECOVERY_BASELINE",
      "title": "SAFOR Runtime prüfen",
      "requiresProvider": false,
      "passOutcome": "MODULE_RECOVERY_BASELINE_VERIFIED",
      "failOutcome": "STOP",
      "checks": [
        "EMBEDDED_MODULE_KEYS_MATCH_RECOVERY_PROFILE_KEYS_EXACTLY",
        "ONE_UNIQUE_PROFILE_PER_MODULE",
        "MODULE_AND_INTEGRITY_MANIFEST_PROFILE_IDS_MATCH",
        "SELF_HEALING_CONTROL_MODULES_PRESENT_AND_STRUCTURALLY_VALID",
        "REFERENCE_RESOLUTION_TARGETS_EXIST",
        "KERNEL_SCHEMA_AND_BUNDLE_VERSIONS_AGREE"
      ],
      "selfHealingRef": "module-self-healing-model.json"
    },
    {
      "id": "INIT-00A",
      "operation": "VERIFY_DETERMINISTIC_CONTROL_BASELINE",
      "title": "Control Kernel prüfen",
      "requiresProvider": false,
      "passOutcome": "DETERMINISTIC_CONTROL_BASELINE_VERIFIED",
      "failOutcome": "STOP",
      "checks": [
        "DETERMINISTIC_CONTROL_MODULES_PRESENT_AND_PINNED",
        "ACCEPTANCE_MODEL_AND_SCHEMAS_PRESENT_AND_PINNED",
        "COMPOSABLE_PACKAGE_MODEL_PRESENT",
        "DOMAIN_PACKAGE_AND_SELECTION_SCHEMAS_PRESENT",
        "PACKAGE_DISTRIBUTION_MODEL_PRESENT",
        "ENTITLEMENT_MODEL_PRESENT",
        "WORKSPACE_MODEL_PRESENT",
        "PUBLIC_FRAMEWORK_CONTAINS_NO_PAID_DOMAIN_PACKAGE_CONTENT"
      ],
      "deterministicControlRef": "deterministic-control-model.json"
    },
    {
      "id": "INIT-01",
      "operation": "SELECT_CREATION_TYPE",
      "humanDecision": "CREATION_TYPE_SELECTION",
      "title": "Was möchtest du erstellen?",
      "menu": {
        "type": "SINGLE_SELECT",
        "options": [
          {
            "id": "WEBSITE",
            "label": "Website",
            "accessLabel": "Kostenlos"
          },
          {
            "id": "SOFTWARE_SAAS",
            "label": "Software / SaaS",
            "accessLabel": "Factory + Operating Model Lizenz erforderlich"
          },
          {
            "id": "BOOK",
            "label": "Buch",
            "accessLabel": "Factory + Operating Model Lizenz erforderlich"
          }
        ]
      },
      "rule": "Generic SAFOR-FRAMEWORK asks for a creation type. A domain-specific SAFOR_DOMAIN_FRAMEWORK_DISTRIBUTION already fixes domain and creation type, so this HUMAN question is suppressed.",
      "skipWhen": "CONTAINER_FORMAT == SAFOR_DOMAIN_FRAMEWORK_DISTRIBUTION",
      "preselectedOutcome": "DOMAIN_AND_CREATION_TYPE_PRESELECTED"
    },
    {
      "id": "INIT-02",
      "operation": "RESOLVE_PACKAGE_SELECTION_PROFILE",
      "title": "Factory und Operating Model auswählen",
      "modelRefs": [
        "package-catalog.json",
        "composable-package-model.json"
      ],
      "outcomes": [
        "DEFAULT_PACKAGE_CANDIDATES_RESOLVED",
        "HUMAN_PACKAGE_OVERRIDE_REQUIRED"
      ],
      "rule": "Domain distribution defaults are embedded and immediately available; replacement is explicit and never changes the active domain implicitly.",
      "rules": [
        "For a generic Framework, resolve Creation Profile defaults.",
        "For SAFOR_DOMAIN_FRAMEWORK_DISTRIBUTION, use embeddedDomainModules.factory and embeddedDomainModules.operatingModel as the default binding.",
        "A later HUMAN-loaded or entitled replacement may replace Factory only, Operating Model only, or both.",
        "Every replacement must support the active domainId and Creation Type and must pass bidirectional counterpart/package-family compatibility."
      ]
    },
    {
      "id": "INIT-03",
      "operation": "RESOLVE_SELECTED_FACTORY_AND_OPERATING_MODEL_ACCESS",
      "title": "Paket-Zugriff getrennt prüfen",
      "rules": [
        "Resolve access separately for selected Factory and selected Operating Model.",
        "WEBSITE defaults are FREE_PUBLIC and may resolve from canonical public SAFOR Git at immutable revision/blob.",
        "SOFTWARE_SAAS and BOOK require BOTH selected packages to be PAID_ENTITLEMENT_REQUIRED; a free override cannot satisfy those creation profiles.",
        "Every paid package requires strict entitlement verification against explicit evaluatedAt, subjectRef, trusted issuer IDs and trusted entitlement verifier IDs.",
        "Entitlement status must be ACTIVE, commercial basis evidence must exist, SKU must match the grant, validity must cover evaluatedAt, and subject/package/version must match exactly.",
        "ENTITLED_PACKAGE_SOURCE additionally requires verified delivery evidence binding entitlementId, packageId, version and artifact digest, from a trusted delivery verifier and inside its delivery validity window.",
        "HUMAN_LOADED_PACKAGE remains supported for licensed manual delivery but never bypasses strict entitlement verification.",
        "Paid package model content may not be read from the public canonical repository."
      ],
      "failOutcomes": {
        "missingPaidPackage": "PACKAGE_ACCESS_REQUIRED",
        "entitlementUnverified": "PACKAGE_ENTITLEMENT_UNVERIFIED",
        "publicPaidResolutionAttempt": "STOP",
        "creationProfilePaidPairViolation": "CREATION_PROFILE_REQUIRES_BOTH_PAID_PACKAGES",
        "entitlementStatusInvalid": "PACKAGE_ENTITLEMENT_STATUS_INVALID",
        "entitlementExpired": "PACKAGE_ENTITLEMENT_EXPIRED",
        "entitlementSubjectMismatch": "PACKAGE_ENTITLEMENT_SUBJECT_MISMATCH",
        "entitlementIssuerUntrusted": "PACKAGE_ENTITLEMENT_ISSUER_UNTRUSTED",
        "entitlementVerifierUntrusted": "PACKAGE_ENTITLEMENT_VERIFIER_UNTRUSTED",
        "deliveryEvidenceMissing": "COMMERCIAL_PACKAGE_DELIVERY_EVIDENCE_REQUIRED",
        "deliveryEvidenceInvalid": "COMMERCIAL_PACKAGE_DELIVERY_EVIDENCE_INVALID",
        "deliveryExpired": "COMMERCIAL_PACKAGE_DELIVERY_EXPIRED",
        "deliveryDigestMismatch": "COMMERCIAL_PACKAGE_DELIVERY_DIGEST_MISMATCH"
      }
    },
    {
      "id": "INIT-04",
      "operation": "VERIFY_PACKAGE_INTEGRITY_AND_ACCESS",
      "title": "Domain-Pakete verifizieren",
      "checks": [
        "SAFOR_DOMAIN_PACKAGE_SHAPE",
        "PACKAGE_ID_KIND_MATCH",
        "DECLARED_CONTRACT_SHA256",
        "IMMUTABLE_SOURCE_REVISION_OR_TRUSTED_ARTIFACT_VERIFICATION",
        "FRAMEWORK_VERSION_RANGE",
        "CREATION_TYPE_SUPPORT",
        "ACCESS_MODE",
        "ENTITLEMENT_WHEN_REQUIRED",
        "ENTITLEMENT_STATUS_TIME_SUBJECT_AND_TRUST_WHEN_REQUIRED",
        "COMMERCIAL_BASIS_EVIDENCE_WHEN_REQUIRED",
        "ENTITLED_SOURCE_DELIVERY_EVIDENCE_WHEN_REQUIRED",
        "DELIVERY_ARTIFACT_DIGEST_MATCH_WHEN_REQUIRED"
      ],
      "rule": "Factory and Operating Model are independently bindable only after package integrity, creation/framework scope, strict commercial entitlement and protected-source delivery evidence (when applicable) have been proven."
    },
    {
      "id": "INIT-05",
      "operation": "VERIFY_FACTORY_OPERATING_MODEL_COMPATIBILITY",
      "title": "Factory und Operating Model kompatibel binden",
      "checks": [
        "FACTORY_KIND_VALID",
        "OPERATING_MODEL_KIND_VALID",
        "FACTORY_AND_OPERATING_MODEL_SUPPORT_ACTIVE_DOMAIN_ID",
        "FACTORY_AND_OPERATING_MODEL_SUPPORT_ACTIVE_CREATION_TYPE",
        "FACTORY_PACKAGE_FAMILY_PRESENT_FOR_V2",
        "OPERATING_MODEL_PACKAGE_FAMILY_PRESENT_FOR_V2",
        "FACTORY_REQUIRED_OPERATING_MODEL_FAMILY_ALLOWED",
        "OPERATING_MODEL_REQUIRED_FACTORY_FAMILY_ALLOWED",
        "FACTORY_REQUIRED_CAPABILITIES_COVERED_BY_OPERATING_MODEL",
        "FACTORY_REQUIRED_AUTHORITIES_COVERED_BY_OPERATING_MODEL",
        "FACTORY_REQUIRED_WORK_ITEM_AND_ARTIFACT_TYPES_COVERED_WHEN_DECLARED",
        "OPERATING_MODEL_REQUIRED_FACTORY_WORK_ITEM_AND_ARTIFACT_TYPES_COVERED_WHEN_DECLARED",
        "DECLARED_COUNTERPART_RESTRICTIONS_SATISFIED_BIDIRECTIONALLY",
        "NO_FACTORY_ROLE_ID_COUPLING",
        "NO_OPERATING_MODEL_FLOW_OWNERSHIP"
      ],
      "failOutcome": "FACTORY_OPERATING_MODEL_INCOMPATIBLE",
      "rule": "Compatibility is bidirectional and domain-bound. A Factory may constrain acceptable Operating Model families/capabilities; an Operating Model may constrain acceptable Factory families/work-item/artifact contracts. Cross-domain pairing is rejected."
    },
    {
      "id": "INIT-05A",
      "operation": "MATERIALIZE_PACKAGE_SELECTION_AND_COMPATIBILITY_DECISION",
      "title": "Arbeitsmodell festschreiben",
      "schemas": [
        "schemas/package-selection.schema.json",
        "schemas/package-compatibility-decision.schema.json"
      ],
      "requires": [
        "PACKAGE_ACCESS_RESOLVED",
        "DOMAIN_PACKAGES_INTEGRITY_VERIFIED",
        "FACTORY_OPERATING_MODEL_COMPATIBLE"
      ],
      "outcome": "DOMAIN_PACKAGE_BINDING_READY",
      "rule": "Persist the selected Factory and Operating Model plus a COMPATIBLE decision before immutable project bindings are materialized."
    },
    {
      "id": "INIT-06",
      "operation": "SELECT_PROJECT_WORKSPACE_TYPE",
      "humanDecision": "PROJECT_WORKSPACE_SELECTION",
      "title": "Wo liegt dein Projekt?",
      "menu": {
        "type": "SINGLE_SELECT",
        "options": [
          {
            "id": "REMOTE_GIT",
            "label": "In meinem Git-Repository"
          },
          {
            "id": "LOCAL_GIT",
            "label": "Lokal auf meinem Rechner"
          }
        ]
      },
      "rule": "Project location is HUMAN-controlled and independent from package source/access."
    },
    {
      "id": "INIT-07R",
      "when": "PROJECT_WORKSPACE_TYPE == REMOTE_GIT",
      "operation": "SELECT_REMOTE_PROVIDER",
      "humanDecision": "PROVIDER_SELECTION",
      "title": "Welchen Git-Anbieter nutzt du?",
      "menu": {
        "type": "SINGLE_SELECT",
        "options": [
          {
            "id": "GITHUB",
            "label": "GitHub",
            "providerPackageId": "safor.provider.github"
          },
          {
            "id": "GITLAB",
            "label": "GitLab",
            "providerPackageId": "safor.provider.gitlab"
          }
        ]
      }
    },
    {
      "id": "INIT-08R",
      "when": "PROJECT_WORKSPACE_TYPE == REMOTE_GIT",
      "operation": "VERIFY_REMOTE_PROVIDER_ACCESS",
      "requires": [
        "provider.identity.read",
        "provider.namespace.list",
        "provider.repository.list",
        "provider.repository.read",
        "provider.artifact.read",
        "provider.artifact.write",
        "provider.history.read",
        "provider.branch.read",
        "provider.branch.write"
      ],
      "failOutcome": "WAITING_HUMAN_PROVIDER_ACCESS"
    },
    {
      "id": "INIT-09R",
      "when": "PROJECT_WORKSPACE_TYPE == REMOTE_GIT",
      "operation": "SELECT_REMOTE_OWNER_AND_PROJECT",
      "humanDecision": "REMOTE_PROJECT_SELECTION",
      "title": "Welches deiner Projekte verwenden wir?",
      "rules": [
        "Project repository must be HUMAN/HUMAN-organization controlled.",
        "Canonical SAFOR repository is forbidden as project repository.",
        "Commercial package source is forbidden as project repository.",
        "Existing or new project is allowed subject to actual provider rights and setup approval."
      ]
    },
    {
      "id": "INIT-10R",
      "when": "PROJECT_WORKSPACE_TYPE == REMOTE_GIT",
      "operation": "VERIFY_AND_BIND_REMOTE_CONTROL_WORKSPACE",
      "target": "{selectedOwner}/safor-memory",
      "strategy": "REMOTE_SEPARATE_SAFOR_MEMORY",
      "requires": [
        "provider.repository.read",
        "provider.artifact.read",
        "provider.artifact.write"
      ],
      "failOutcome": "WAITING_HUMAN_CONTROL_WORKSPACE",
      "rule": "Remote safor-memory remains HUMAN-controlled control storage; it is never a project work-artifact repository."
    },
    {
      "id": "INIT-07L",
      "when": "PROJECT_WORKSPACE_TYPE == LOCAL_GIT",
      "operation": "VERIFY_LOCAL_HOST_CAPABILITIES",
      "requires": [
        "workspace.local.read",
        "workspace.local.write",
        "workspace.git.repository.read",
        "workspace.git.history.read",
        "workspace.git.branch.read",
        "workspace.git.branch.write",
        "workspace.git.commit.write"
      ],
      "failOutcome": "WAITING_HUMAN_LOCAL_HOST_ACCESS",
      "rule": "Do not claim local capability unless the host actually exposes filesystem and Git operations."
    },
    {
      "id": "INIT-08L",
      "when": "PROJECT_WORKSPACE_TYPE == LOCAL_GIT",
      "operation": "SELECT_OR_DEFINE_LOCAL_GIT_PROJECT",
      "humanDecision": "LOCAL_PROJECT_SELECTION",
      "title": "Welchen lokalen Git-Projektordner verwenden wir?",
      "checks": [
        "PATH_HUMAN_SELECTED_OR_APPROVED",
        "GIT_REPOSITORY_PRESENT_OR_SETUP_EXPLICITLY_APPROVED",
        "READ_WRITE_PROVEN",
        "CANONICAL_SAFOR_SOURCE_NOT_TARGET"
      ]
    },
    {
      "id": "INIT-09L",
      "when": "PROJECT_WORKSPACE_TYPE == LOCAL_GIT",
      "operation": "BIND_LOCAL_CONTROL_WORKSPACE",
      "strategy": "LOCAL_MASTER_CONTROL_ROOT",
      "target": ".safor/",
      "rule": "The .safor/ root is MASTER-only, Git-tracked and excluded from worker write scopes."
    },
    {
      "id": "INIT-11",
      "operation": "APPROVE_AND_MATERIALIZE_PROJECT",
      "humanDecision": "SETUP_APPROVAL",
      "title": "Projekt starten",
      "rule": "Materialize project/control only in the HUMAN-selected project/control workspaces. Package sources and canonical SAFOR repository remain read-only sources.",
      "completionOutcome": "INITIALIZATION_COMPLETE"
    }
  ],
  "packageModelRefs": [
    "package-catalog.json",
    "package-distribution-model.json",
    "commercial-entitlement-model.json",
    "composable-package-model.json"
  ],
  "workspaceModelRef": "workspace-model.json",
  "humanDecisionGateModelRef": "human-decision-gate-model.json",
  "humanCognitiveLoadPolicyRef": "interaction-model.json#humanCognitiveLoadPolicy",
  "executionEnvironmentContract": {
    "modelRef": "chat-execution-model.json",
    "primaryMode": "DECLARATIVE_LLM_CHAT",
    "customerInstalledRuntimeRequired": false,
    "optionalReferenceRuntimeDoesNotBlockInitialization": true
  },
  "agentBootstrapContract": {
    "modelRef": "agent-bootstrap-model.json",
    "masterPreparesIdentityAndPrompt": true,
    "humanInsertsPromptOnce": true,
    "futureActivation": "HUMAN_GO_ONLY",
    "jobPromptCopyingForbiddenAfterBinding": true
  },
  "agentChatBootstrap": {
    "modelRef": "agent-activation-model.json",
    "oneTimeInitializationTemplateRef": "templates/agent-initialization.template.json",
    "normalActivation": "HUMAN_GO_REQUIRED",
    "automaticChatWakeupForbidden": true,
    "reidentificationFailClosed": true
  },
  "resumeContract": {
    "readCurrentAuthorityPointerFirst": true,
    "detectPartialInitialization": true,
    "idempotentMaterializationRequired": true,
    "duplicateActiveAuthorityForbidden": true,
    "onUnknownExternalEffect": "RECONCILE_REQUIRED"
  }
}
