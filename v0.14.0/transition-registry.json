{
  "format": "SAFOR_TRANSITION_REGISTRY",
  "schemaVersion": "0.14.0",
  "id": "safor-transition-registry",
  "purpose": "Executable rc.1 transition slice for deterministic SAFOR governance.",
  "deterministicSelection": {
    "sort": [
      "priority DESC",
      "transitionId ASC"
    ],
    "maximumApplicableTransitions": 1,
    "zeroMatchOutcome": "NO_TRANSITION",
    "multipleMatchOutcome": "AMBIGUOUS_TRANSITION_CONTROL_FAILURE"
  },
  "transitions": [
    {
      "transitionId": "WORK_ITEM_BECOMES_READY",
      "priority": 100,
      "aggregate": "VALUE_STREAM",
      "subjectType": "WORK_ITEM",
      "eventTypes": [
        "WORK_ITEM_READINESS_REEVALUATION_REQUESTED",
        "DEPENDENCY_ACCEPTED",
        "MANDATE_GRANTED",
        "INPUT_AVAILABLE"
      ],
      "fromStatus": [
        "PLANNED",
        "BLOCKED"
      ],
      "guards": {
        "all": [
          {
            "predicate": "EVENT_SEQUENCE_CONTIGUOUS"
          },
          {
            "predicate": "SUBJECT_WORK_ITEM_EXISTS"
          },
          {
            "predicate": "ALL_DEPENDENCIES_ACCEPTED"
          },
          {
            "predicate": "ACTIVE_MANDATE_COVERS_WORK_ITEM"
          },
          {
            "predicate": "REQUIRED_INPUTS_RESOLVABLE"
          },
          {
            "predicate": "RESOURCE_DECLARATION_COMPLETE"
          }
        ]
      },
      "effects": [
        {
          "op": "SET",
          "path": "$subject.status",
          "value": "READY"
        },
        {
          "op": "SET_FROM_EVENT",
          "path": "$subject.execution.readySince",
          "eventPath": "occurredAt"
        },
        {
          "op": "INCREMENT",
          "path": "$aggregate.revision",
          "by": 1
        }
      ],
      "effectIntents": []
    },
    {
      "transitionId": "CONTROL_PROJECT_PAUSED",
      "priority": 200,
      "aggregate": "CONTROL",
      "subjectType": "PROJECT",
      "eventTypes": [
        "PAUSE_PROJECT_REQUESTED"
      ],
      "fromStatus": [
        "READY",
        "RUNNING",
        "WAITING_EXTERNAL",
        "RECONCILE_REQUIRED",
        "BLOCKED"
      ],
      "guards": {
        "all": [
          {
            "predicate": "EVENT_SEQUENCE_CONTIGUOUS"
          },
          {
            "predicate": "FIELD_IN",
            "args": {
              "path": "$aggregate.mode",
              "values": [
                "BOOTSTRAP",
                "INITIALIZING",
                "PLANNING",
                "AWAITING_AUTHORIZATION",
                "EXECUTING",
                "WAITING_OUTCOME",
                "RECOVERING"
              ]
            }
          }
        ]
      },
      "effects": [
        {
          "op": "SET_FROM_STATE",
          "path": "$aggregate.resumeMode",
          "statePath": "$aggregate.mode"
        },
        {
          "op": "SET",
          "path": "$aggregate.mode",
          "value": "PAUSED"
        },
        {
          "op": "SET",
          "path": "$aggregate.status",
          "value": "WAITING_HUMAN"
        },
        {
          "op": "INCREMENT",
          "path": "$aggregate.stateRevision",
          "by": 1
        }
      ],
      "effectIntents": []
    },
    {
      "transitionId": "CONTROL_PROJECT_RESUMED_FROM_PAUSE",
      "priority": 300,
      "aggregate": "CONTROL",
      "subjectType": "PROJECT",
      "eventTypes": [
        "RESUME_PROJECT_REQUESTED"
      ],
      "fromStatus": [
        "WAITING_HUMAN"
      ],
      "guards": {
        "all": [
          {
            "predicate": "EVENT_SEQUENCE_CONTIGUOUS"
          },
          {
            "predicate": "FIELD_EQUALS",
            "args": {
              "path": "$aggregate.mode",
              "value": "PAUSED"
            }
          },
          {
            "predicate": "FIELD_IN",
            "args": {
              "path": "$aggregate.resumeMode",
              "values": [
                "BOOTSTRAP",
                "INITIALIZING",
                "PLANNING",
                "AWAITING_AUTHORIZATION",
                "EXECUTING",
                "WAITING_OUTCOME",
                "RECOVERING"
              ]
            }
          }
        ]
      },
      "effects": [
        {
          "op": "SET_FROM_STATE",
          "path": "$aggregate.mode",
          "statePath": "$aggregate.resumeMode"
        },
        {
          "op": "SET",
          "path": "$aggregate.resumeMode",
          "value": null
        },
        {
          "op": "SET",
          "path": "$aggregate.status",
          "value": "READY"
        },
        {
          "op": "INCREMENT",
          "path": "$aggregate.stateRevision",
          "by": 1
        }
      ],
      "effectIntents": []
    },
    {
      "transitionId": "CONTROL_PROJECT_STOPPED",
      "priority": 1000,
      "aggregate": "CONTROL",
      "subjectType": "PROJECT",
      "eventTypes": [
        "STOP_PROJECT_REQUESTED"
      ],
      "fromStatus": [
        "READY",
        "RUNNING",
        "WAITING_HUMAN",
        "WAITING_EXTERNAL",
        "RECONCILE_REQUIRED",
        "BLOCKED",
        "FAILED"
      ],
      "guards": {
        "all": [
          {
            "predicate": "EVENT_SEQUENCE_CONTIGUOUS"
          }
        ]
      },
      "effects": [
        {
          "op": "REVOKE_ACTIVE_MANDATES",
          "path": "$aggregate.mandates",
          "eventPath": "occurredAt"
        },
        {
          "op": "SET",
          "path": "$aggregate.mode",
          "value": "STOPPED"
        },
        {
          "op": "SET",
          "path": "$aggregate.status",
          "value": "WAITING_HUMAN"
        },
        {
          "op": "SET",
          "path": "$aggregate.resumeMode",
          "value": null
        },
        {
          "op": "INCREMENT",
          "path": "$aggregate.stateRevision",
          "by": 1
        }
      ],
      "effectIntents": []
    },
    {
      "transitionId": "CONTROL_RESUME_FROM_STOP_REQUIRES_AUTHORIZATION",
      "priority": 200,
      "aggregate": "CONTROL",
      "subjectType": "PROJECT",
      "eventTypes": [
        "RESUME_PROJECT_REQUESTED"
      ],
      "fromStatus": [
        "WAITING_HUMAN"
      ],
      "guards": {
        "all": [
          {
            "predicate": "EVENT_SEQUENCE_CONTIGUOUS"
          },
          {
            "predicate": "FIELD_EQUALS",
            "args": {
              "path": "$aggregate.mode",
              "value": "STOPPED"
            }
          }
        ]
      },
      "effects": [
        {
          "op": "SET",
          "path": "$aggregate.mode",
          "value": "AWAITING_AUTHORIZATION"
        },
        {
          "op": "SET",
          "path": "$aggregate.status",
          "value": "WAITING_HUMAN"
        },
        {
          "op": "SET",
          "path": "$aggregate.resumeMode",
          "value": null
        },
        {
          "op": "INCREMENT",
          "path": "$aggregate.stateRevision",
          "by": 1
        }
      ],
      "effectIntents": []
    },
    {
      "transitionId": "CONTROL_RECONCILE_UNKNOWN_EXTERNAL_MUTATION",
      "priority": 900,
      "aggregate": "CONTROL",
      "subjectType": "PROJECT",
      "eventTypes": [
        "EXTERNAL_MUTATION_OUTCOME_UNKNOWN"
      ],
      "fromStatus": [
        "READY",
        "RUNNING",
        "WAITING_HUMAN",
        "WAITING_EXTERNAL",
        "BLOCKED"
      ],
      "guards": {
        "all": [
          {
            "predicate": "EVENT_SEQUENCE_CONTIGUOUS"
          }
        ]
      },
      "effects": [
        {
          "op": "SET",
          "path": "$aggregate.status",
          "value": "RECONCILE_REQUIRED"
        },
        {
          "op": "SET",
          "path": "$aggregate.mode",
          "value": "RECOVERING"
        },
        {
          "op": "INCREMENT",
          "path": "$aggregate.stateRevision",
          "by": 1
        }
      ],
      "effectIntents": [
        {
          "effectType": "PROVIDER_READBACK",
          "reason": "RECONCILE_UNKNOWN_EXTERNAL_MUTATION",
          "payload": {}
        }
      ]
    },
    {
      "transitionId": "ACCEPTANCE_CONTRACT_REGISTERED",
      "priority": 500,
      "aggregate": "ACCEPTANCE",
      "subjectType": "WORK_ITEM",
      "eventTypes": [
        "ACCEPTANCE_CONTRACT_REGISTERED"
      ],
      "fromStatus": [
        "PLANNED",
        "READY",
        "ASSIGNED",
        "IN_PROGRESS",
        "HANDOFF_READY",
        "IN_REVIEW",
        "CHANGES_REQUIRED",
        "BLOCKED"
      ],
      "guards": {
        "all": [
          {
            "predicate": "EVENT_SEQUENCE_CONTIGUOUS"
          },
          {
            "predicate": "SUBJECT_WORK_ITEM_EXISTS"
          },
          {
            "predicate": "ACCEPTANCE_CONTRACT_NOT_REGISTERED"
          },
          {
            "predicate": "ACCEPTANCE_CONTRACT_VALID_FOR_SUBJECT"
          }
        ]
      },
      "effects": [
        {
          "op": "APPEND_FROM_EVENT",
          "path": "$aggregate.contracts",
          "eventPath": "payload.contract"
        },
        {
          "op": "INCREMENT",
          "path": "$aggregate.revision",
          "by": 1
        }
      ],
      "effectIntents": []
    },
    {
      "transitionId": "ACCEPTANCE_EVIDENCE_RECORDED",
      "priority": 400,
      "aggregate": "ACCEPTANCE",
      "subjectType": "WORK_ITEM",
      "eventTypes": [
        "EVIDENCE_RECORDED"
      ],
      "fromStatus": [
        "PLANNED",
        "READY",
        "ASSIGNED",
        "IN_PROGRESS",
        "HANDOFF_READY",
        "IN_REVIEW",
        "CHANGES_REQUIRED",
        "BLOCKED"
      ],
      "guards": {
        "all": [
          {
            "predicate": "EVENT_SEQUENCE_CONTIGUOUS"
          },
          {
            "predicate": "SUBJECT_WORK_ITEM_EXISTS"
          },
          {
            "predicate": "EVIDENCE_RECORD_NOT_REGISTERED"
          },
          {
            "predicate": "EVIDENCE_RECORD_VALID_FOR_SUBJECT"
          }
        ]
      },
      "effects": [
        {
          "op": "APPEND_FROM_EVENT",
          "path": "$aggregate.evidenceRecords",
          "eventPath": "payload.record"
        },
        {
          "op": "INCREMENT",
          "path": "$aggregate.revision",
          "by": 1
        }
      ],
      "effectIntents": []
    },
    {
      "transitionId": "ACCEPTANCE_REVIEW_APPROVED_RECORDED",
      "priority": 600,
      "aggregate": "VALUE_STREAM",
      "subjectType": "WORK_ITEM",
      "eventTypes": [
        "REVIEW_APPROVED_RECORDED"
      ],
      "fromStatus": [
        "HANDOFF_READY",
        "IN_REVIEW"
      ],
      "guards": {
        "all": [
          {
            "predicate": "EVENT_SEQUENCE_CONTIGUOUS"
          },
          {
            "predicate": "SUBJECT_WORK_ITEM_EXISTS"
          },
          {
            "predicate": "ACTIVE_ACCEPTANCE_CONTRACT_EXISTS"
          },
          {
            "predicate": "REVIEW_RECORD_VALID_FOR_SUBJECT"
          },
          {
            "predicate": "REVIEW_RECORD_NOT_REGISTERED"
          },
          {
            "predicate": "REVIEW_EVENT_INDEPENDENCE_VALID"
          }
        ]
      },
      "effects": [
        {
          "op": "APPEND_FROM_EVENT",
          "path": "$acceptance.reviewDecisions",
          "eventPath": "payload.record"
        },
        {
          "op": "INCREMENT",
          "path": "$acceptance.revision",
          "by": 1
        },
        {
          "op": "SET",
          "path": "$subject.review.status",
          "value": "APPROVED"
        },
        {
          "op": "SET",
          "path": "$subject.status",
          "value": "IN_REVIEW"
        },
        {
          "op": "INCREMENT",
          "path": "$aggregate.revision",
          "by": 1
        }
      ],
      "effectIntents": []
    },
    {
      "transitionId": "ACCEPTANCE_REVIEW_CHANGES_REQUIRED_RECORDED",
      "priority": 700,
      "aggregate": "VALUE_STREAM",
      "subjectType": "WORK_ITEM",
      "eventTypes": [
        "REVIEW_CHANGES_REQUIRED_RECORDED"
      ],
      "fromStatus": [
        "HANDOFF_READY",
        "IN_REVIEW"
      ],
      "guards": {
        "all": [
          {
            "predicate": "EVENT_SEQUENCE_CONTIGUOUS"
          },
          {
            "predicate": "SUBJECT_WORK_ITEM_EXISTS"
          },
          {
            "predicate": "ACTIVE_ACCEPTANCE_CONTRACT_EXISTS"
          },
          {
            "predicate": "REVIEW_RECORD_NOT_REGISTERED"
          },
          {
            "predicate": "REVIEW_RECORD_VALID_FOR_SUBJECT"
          }
        ]
      },
      "effects": [
        {
          "op": "APPEND_FROM_EVENT",
          "path": "$acceptance.reviewDecisions",
          "eventPath": "payload.record"
        },
        {
          "op": "INCREMENT",
          "path": "$acceptance.revision",
          "by": 1
        },
        {
          "op": "SET",
          "path": "$subject.review.status",
          "value": "CHANGES_REQUIRED"
        },
        {
          "op": "SET",
          "path": "$subject.status",
          "value": "CHANGES_REQUIRED"
        },
        {
          "op": "INCREMENT",
          "path": "$aggregate.revision",
          "by": 1
        }
      ],
      "effectIntents": []
    },
    {
      "transitionId": "ACCEPTANCE_AUTHORITY_APPROVED_RECORDED",
      "priority": 400,
      "aggregate": "ACCEPTANCE",
      "subjectType": "WORK_ITEM",
      "eventTypes": [
        "AUTHORITY_APPROVED_RECORDED"
      ],
      "fromStatus": [
        "PLANNED",
        "READY",
        "ASSIGNED",
        "IN_PROGRESS",
        "HANDOFF_READY",
        "IN_REVIEW",
        "CHANGES_REQUIRED",
        "BLOCKED"
      ],
      "guards": {
        "all": [
          {
            "predicate": "EVENT_SEQUENCE_CONTIGUOUS"
          },
          {
            "predicate": "SUBJECT_WORK_ITEM_EXISTS"
          },
          {
            "predicate": "ACTIVE_ACCEPTANCE_CONTRACT_EXISTS"
          },
          {
            "predicate": "AUTHORITY_DECISION_NOT_REGISTERED"
          },
          {
            "predicate": "AUTHORITY_DECISION_VALID_FOR_SUBJECT"
          }
        ]
      },
      "effects": [
        {
          "op": "APPEND_FROM_EVENT",
          "path": "$aggregate.authorityDecisions",
          "eventPath": "payload.record"
        },
        {
          "op": "INCREMENT",
          "path": "$aggregate.revision",
          "by": 1
        }
      ],
      "effectIntents": []
    },
    {
      "transitionId": "ACCEPTANCE_AUTHORITY_REJECTED_RECORDED",
      "priority": 400,
      "aggregate": "ACCEPTANCE",
      "subjectType": "WORK_ITEM",
      "eventTypes": [
        "AUTHORITY_REJECTED_RECORDED"
      ],
      "fromStatus": [
        "PLANNED",
        "READY",
        "ASSIGNED",
        "IN_PROGRESS",
        "HANDOFF_READY",
        "IN_REVIEW",
        "CHANGES_REQUIRED",
        "BLOCKED"
      ],
      "guards": {
        "all": [
          {
            "predicate": "EVENT_SEQUENCE_CONTIGUOUS"
          },
          {
            "predicate": "SUBJECT_WORK_ITEM_EXISTS"
          },
          {
            "predicate": "ACTIVE_ACCEPTANCE_CONTRACT_EXISTS"
          },
          {
            "predicate": "AUTHORITY_DECISION_NOT_REGISTERED"
          },
          {
            "predicate": "AUTHORITY_DECISION_VALID_FOR_SUBJECT"
          }
        ]
      },
      "effects": [
        {
          "op": "APPEND_FROM_EVENT",
          "path": "$aggregate.authorityDecisions",
          "eventPath": "payload.record"
        },
        {
          "op": "INCREMENT",
          "path": "$aggregate.revision",
          "by": 1
        }
      ],
      "effectIntents": []
    },
    {
      "transitionId": "WORK_ITEM_ACCEPTED",
      "priority": 1000,
      "aggregate": "VALUE_STREAM",
      "subjectType": "WORK_ITEM",
      "eventTypes": [
        "ACCEPTANCE_REEVALUATION_REQUESTED"
      ],
      "fromStatus": [
        "HANDOFF_READY",
        "IN_REVIEW"
      ],
      "guards": {
        "all": [
          {
            "predicate": "EVENT_SEQUENCE_CONTIGUOUS"
          },
          {
            "predicate": "SUBJECT_WORK_ITEM_EXISTS"
          },
          {
            "predicate": "ACTIVE_ACCEPTANCE_CONTRACT_EXISTS"
          },
          {
            "predicate": "REQUIRED_EVIDENCE_SATISFIED"
          },
          {
            "predicate": "REQUIRED_REVIEWS_SATISFIED"
          },
          {
            "predicate": "REVIEW_INDEPENDENCE_SATISFIED"
          },
          {
            "predicate": "REQUIRED_AUTHORITIES_SATISFIED"
          },
          {
            "predicate": "NO_REJECTING_AUTHORITY_DECISION"
          },
          {
            "predicate": "ALL_ACCEPTANCE_CRITERIA_SATISFIED"
          }
        ]
      },
      "effects": [
        {
          "op": "SET",
          "path": "$subject.status",
          "value": "ACCEPTED"
        },
        {
          "op": "INCREMENT",
          "path": "$aggregate.revision",
          "by": 1
        }
      ],
      "effectIntents": []
    }
  ]
}
