{
  "format": "SAFOR_AGENT_ACTIVATION_MODEL",
  "schemaVersion": "0.14.0",
  "id": "SAFOR-INBOX-PULL-HUMAN-GO-ACTIVATION",
  "purpose": "Define one-time agent identity bootstrap and subsequent deliberate HUMAN-GO activation in which the agent pulls its assigned job from its personal Git inbox.",
  "scope": {
    "normalChatAgents": true,
    "serviceAgentsSeparate": true,
    "endCustomerRuntimeInstallationRequired": false,
    "normativeRulesEmbeddedInFramework": true,
    "referenceRuntimeOptionalForVerification": true
  },
  "identityInvariants": [
    "A CHAT_AGENT has one stable agentId and a separate HUMAN-readable displayName.",
    "The agent identity is bound to projectId, masterId, controlRepository, workspaceRoot and personal inbox path.",
    "The immutable inboxIndexRef proves the personal inbox bootstrap binding; it is provenance only and never the source for later job discovery.",
    "The stable inboxIndexLocation identifies the mutable MASTER-owned personal inbox projection; current jobs are always read from this location with provider readback.",
    "The one-time initialization prompt establishes which pinned identity and personal inbox this chat must use; host session attestation is not required.",
    "The agent identity must never be inferred from job content, display name, repository location or an arbitrary inbox entry.",
    "An inactive identity, stale identityRevision, foreign inbox or foreign job assignment fails closed before claim."
  ],
  "initializationProtocol": {
    "performedOncePerContinuedChat": false,
    "preparedBy": "MASTER",
    "humanAction": "PASTE_MASTER_GENERATED_INITIALIZATION_PROMPT_ONCE",
    "requiredBindings": [
      "CONTROL_REPOSITORY",
      "PROJECT_ID",
      "AGENT_ID",
      "DISPLAY_NAME",
      "IDENTITY_REF",
      "AGENT_STATE_REF",
      "INBOX_INDEX_REF",
      "INBOX_INDEX_LOCATION",
      "COMMUNICATION_CONTRACT_REF"
    ],
    "validationSteps": [
      "READ_PINNED_IDENTITY",
      "VERIFY_IDENTITY_BLOB",
      "VERIFY_PROJECT_AND_MASTER_BINDING",
      "VERIFY_IDENTITY_STATUS_ACTIVE",
      "VERIFY_PERSONAL_INBOX_BOOTSTRAP_REF",
      "VERIFY_PERSONAL_INBOX_LOCATION",
      "READ_AGENT_STATE",
      "READ_CURRENT_PERSONAL_INBOX_INDEX_FROM_LOCATION",
      "VERIFY_CURRENT_INBOX_PROJECT_AGENT_AND_IDENTITY_REVISION",
      "CONFIRM_READY_FOR_HUMAN_GO"
    ],
    "jobPromptTransportRequired": false,
    "onValidationFailure": "IDENTITY_OR_INBOX_REINITIALIZATION_REQUIRED",
    "performedOncePerAgentChatBootstrap": true
  },
  "chatAgentActivationContract": {
    "activationMode": "HUMAN_GO_REQUIRED",
    "acceptedHumanMessage": "GO",
    "trimWhitespace": true,
    "caseSensitive": false,
    "additionalTextAllowed": false,
    "source": "DIRECT_HUMAN_INPUT_IN_INITIALIZED_AGENT_CHAT",
    "backgroundWakeupAssumed": false,
    "gitEventActivationAllowed": false,
    "pollingActivationAllowed": false,
    "automationActivationAllowed": false,
    "hostTriggerActivationAllowed": false,
    "schedulerMayActivateChat": false,
    "schedulerOutcomeBeforeGo": "WAITING_HUMAN_GO",
    "activationEvidenceRequiredBeforeClaim": true,
    "activationEvidenceAuthority": "DIRECT_HUMAN_GO_BOUND_TO_PINNED_IDENTITY_AND_PERSONAL_INBOX",
    "claimMode": "ATOMIC_AGENT_STATE_CLAIM_WITH_SINGLE_USE_GO_EVIDENCE",
    "stringSubstringEvidenceForbidden": true,
    "hostSessionAttestationRequired": false,
    "currentInboxSource": "BOUND_MUTABLE_INBOX_INDEX_LOCATION",
    "bootstrapInboxBlobMayBecomeStaleAfterDispatch": true,
    "bootstrapInboxBlobNeverUsedForCurrentJobDiscovery": true
  },
  "onHumanGo": {
    "allowedReadsInOrder": [
      "PINNED_IDENTITY",
      "AGENT_STATE",
      "CURRENT_PERSONAL_INBOX_INDEX_AT_BOUND_LOCATION",
      "SELECTED_INBOX_JOB_CONTRACT",
      "SELECTED_MASTER_JOB_STATE",
      "JOB_REFERENCED_INPUTS_ONLY"
    ],
    "forbiddenDiscovery": [
      "GLOBAL_REPOSITORY_SEARCH",
      "OTHER_AGENT_INBOX_READ",
      "PROJECT_TREE_FULL_SCAN",
      "UNREFERENCED_ARTIFACT_DISCOVERY"
    ],
    "preClaimChecks": [
      "IDENTITY_ACTIVE",
      "IDENTITY_REVISION_MATCH",
      "PERSONAL_INBOX_PROJECT_AND_AGENT_MATCH",
      "CURRENT_INBOX_READ_FROM_BOUND_LOCATION",
      "DISCOVERABLE_JOB_AVAILABLE",
      "JOB_AGENT_ASSIGNMENT_MATCH",
      "JOB_IDENTITY_REVISION_MATCH",
      "JOB_DISPATCH_REVISION_MATCH",
      "HUMAN_GO_EVIDENCE_BOUND_TO_SELECTED_JOB",
      "ROLE_AND_SKILL_MATCH",
      "MANDATE_ACTIVE",
      "MASTER_JOB_STATE_READ_ONLY_AND_WAITING_HUMAN_GO",
      "AGENT_STATE_CLAIM_TARGET_BOUND",
      "ACTUAL_PROVIDER_RIGHTS_SUFFICIENT"
    ],
    "failClosed": true
  },
  "reidentificationProtocol": {
    "triggers": [
      "PINNED_IDENTITY_UNAVAILABLE_OR_BLOB_MISMATCH",
      "IDENTITY_REVISION_MISMATCH",
      "CONTROL_REPOSITORY_UNAVAILABLE",
      "PERSONAL_INBOX_PROJECT_OR_AGENT_MISMATCH",
      "AGENT_CANNOT_PROVE_PINNED_IDENTITY",
      "PERSONAL_INBOX_LOCATION_MISMATCH"
    ],
    "effect": [
      "NO_JOB_CLAIM",
      "NO_PRODUCT_MUTATION",
      "NO_RESPONSE_PATH_GUESSING",
      "EMIT_MINIMAL_REINITIALIZATION_STATUS"
    ],
    "requiredHumanPath": "RELOAD_MASTER_GENERATED_AGENT_INITIALIZATION_PROMPT"
  },
  "goEvidenceContract": {
    "format": "SAFOR_HUMAN_GO_EVIDENCE",
    "schemaVersion": "0.14.0",
    "requiredFields": [
      "activationId",
      "projectId",
      "agentId",
      "identityRevision",
      "targetJobId",
      "targetDispatchRevision",
      "intent",
      "source",
      "observedAt",
      "singleUse",
      "jobPromptTransported"
    ],
    "constants": {
      "intent": "GO",
      "source": "DIRECT_HUMAN_INPUT_IN_INITIALIZED_AGENT_CHAT",
      "singleUse": true,
      "jobPromptTransported": false
    },
    "schemaRef": "schemas/human-go-evidence.schema.json"
  },
  "atomicClaimContract": {
    "expectedAgentState": "WAITING_HUMAN_GO",
    "masterJobStateRequired": "WAITING_HUMAN_GO",
    "claimStateOwner": "AGENT",
    "claimStateTarget": "agents/{agentId}/state.json",
    "masterJobStateMutationAllowed": false,
    "requiredExpectedAgentStateRevision": true,
    "evidenceBindingFields": [
      "projectId",
      "agentId",
      "identityRevision",
      "targetJobId",
      "targetDispatchRevision",
      "activationId"
    ],
    "singleUseEnforced": true,
    "providerCompareAndSwapRequired": true,
    "onConflict": "RECONCILE_REQUIRED",
    "authoritativeSequence": [
      "READ_AGENT_STATE_AT_EXPECTED_REVISION",
      "READ_MASTER_JOB_STATE_READ_ONLY",
      "VALIDATE_GO_EVIDENCE_AND_JOB_BINDINGS",
      "BUILD_EXACT_PROPOSED_AGENT_CLAIM_STATE",
      "PERSIST_ACTIVATION_CONSUMPTION_INSIDE_PROPOSED_AGENT_STATE",
      "CALCULATE_CANONICAL_PROPOSED_AGENT_STATE_DIGEST",
      "CAS_COMMIT_EXACT_PROPOSED_AGENT_STATE_AT_EXPECTED_REVISION",
      "PROVIDER_READBACK_FULL_COMMITTED_AGENT_STATE",
      "VERIFY_CANONICAL_STATE_DIGEST_AND_BINDINGS",
      "MARK_CLAIM_AUTHORITY_FROM_PROVIDER_EVIDENCE"
    ],
    "inMemoryConsumptionAuthoritative": false,
    "claimSuccessRequiresProviderReadback": true,
    "casFailureOutcome": "RECONCILE_REQUIRED",
    "activationConsumptionAuthority": "CAS_COMMITTED_AGENT_STATE_VERIFIED_BY_PROVIDER_READBACK",
    "claimSuccessRequires": [
      "CAS_SUCCEEDED",
      "FULL_COMMITTED_AGENT_STATE_READ_BACK",
      "READBACK_STATE_EQUALS_PROPOSED_AGENT_STATE",
      "CANONICAL_STATE_DIGEST_MATCH",
      "PROJECT_JOB_AGENT_IDENTITY_DISPATCH_BINDINGS_MATCH",
      "ACTIVATION_ID_PRESENT_IN_AGENT_STATE_CONSUMED_ACTIVATION_IDS",
      "CURRENT_JOB_CLAIM_ID_EQUALS_ACTIVATION_ID",
      "AGENT_RUNTIME_STATUS_IS_RUNNING",
      "MASTER_JOB_STATE_NOT_MUTATED_BY_AGENT",
      "READBACK_REF_PRESENT",
      "READBACK_BLOB_IDENTITY_PRESENT"
    ],
    "persistActivationConsumptionInsideCasState": true,
    "authoritativeReturnType": "SAFOR_CONFIRMED_GO_CLAIM",
    "proposedStateIsNonAuthoritativeUntilReadback": true,
    "inboxJobIsAuthoritativeDispatch": true,
    "masterLifecycleReconciliation": "MASTER_LATER_RECONCILES_CLAIMED_RUNNING_RESPONSE_STATE_FROM_PROVIDER_CONFIRMED_AGENT_CLAIM_AND_RESPONSE_EVIDENCE",
    "hostSessionBindingRequired": false
  }
}
