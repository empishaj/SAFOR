{
  "format": "SAFOR_AGENT_ACTIVATION_MODEL",
  "schemaVersion": "0.14.0",
  "id": "SAFOR-INBOX-PULL-HUMAN-GO-ACTIVATION",
  "purpose": "Define one-time agent identity bootstrap and subsequent deliberate HUMAN-GO activation in which the agent pulls its assigned job from its personal Git inbox.",
  "scope": {
    "normalChatAgents": true,
    "serviceAgentsSeparate": true,
    "endCustomerRuntimeInstallationRequired": false,
    "normativeRulesEmbeddedInFramework": true,
    "referenceRuntimeOptionalForVerification": true
  },
  "identityInvariants": [
    "A CHAT_AGENT has one stable agentId and a separate HUMAN-readable displayName.",
    "The agent identity is bound to projectId, masterId, controlRepository, workspaceRoot and personal inbox path.",
    "The immutable inboxIndexRef proves the personal inbox bootstrap binding; it is provenance only and never the source for later job discovery.",
    "The stable inboxIndexLocation identifies the mutable MASTER-owned personal inbox projection; current jobs are always read from this location with provider readback.",
    "The one-time initialization prompt establishes which pinned identity and personal inbox this chat must use; host session attestation is not required.",
    "The agent identity must never be inferred from job content, display name, repository location or an arbitrary inbox entry.",
    "An inactive identity, stale identityRevision, foreign inbox or foreign job assignment fails closed before claim."
  ],
  "initializationProtocol": {
    "performedOncePerContinuedChat": false,
    "preparedBy": "MASTER",
    "humanAction": "PASTE_MASTER_GENERATED_INITIALIZATION_PROMPT_ONCE",
    "requiredBindings": [
      "CONTROL_REPOSITORY",
      "PROJECT_ID",
      "AGENT_ID",
      "DISPLAY_NAME",
      "IDENTITY_REF",
      "AGENT_STATE_REF",
      "INBOX_INDEX_REF",
      "INBOX_INDEX_LOCATION",
      "COMMUNICATION_CONTRACT_REF"
    ],
    "validationSteps": [
      "READ_PINNED_IDENTITY",
      "VERIFY_IDENTITY_BLOB",
      "VERIFY_PROJECT_AND_MASTER_BINDING",
      "VERIFY_IDENTITY_STATUS_ACTIVE",
      "VERIFY_PERSONAL_INBOX_BOOTSTRAP_REF",
      "VERIFY_PERSONAL_INBOX_LOCATION",
      "READ_AGENT_STATE",
      "READ_CURRENT_PERSONAL_INBOX_INDEX_FROM_LOCATION",
      "VERIFY_CURRENT_INBOX_PROJECT_AGENT_AND_IDENTITY_REVISION",
      "CONFIRM_READY_FOR_HUMAN_GO"
    ],
    "jobPromptTransportRequired": false,
    "onValidationFailure": "IDENTITY_OR_INBOX_REINITIALIZATION_REQUIRED",
    "performedOncePerAgentChatBootstrap": true,
    "reidentificationBootstrapStateMutationAllowed": false,
    "reidentificationReadyEvidenceRecordedByMaster": true,
    "reidentificationReadyEvidenceSchemaRef": "schemas/agent-reidentification-evidence.schema.json",
    "reidentificationStateTemplateRef": "templates/agent-state-reidentification-ready.template.json"
  },
  "chatAgentActivationContract": {
    "activationMode": "HUMAN_GO_REQUIRED",
    "acceptedHumanMessage": "GO",
    "trimWhitespace": true,
    "caseSensitive": false,
    "additionalTextAllowed": false,
    "source": "DIRECT_HUMAN_INPUT_IN_INITIALIZED_AGENT_CHAT",
    "backgroundWakeupAssumed": false,
    "gitEventActivationAllowed": false,
    "pollingActivationAllowed": false,
    "automationActivationAllowed": false,
    "hostTriggerActivationAllowed": false,
    "schedulerMayActivateChat": false,
    "schedulerOutcomeBeforeGo": "WAITING_HUMAN_GO",
    "activationEvidenceRequiredBeforeClaim": true,
    "activationEvidenceAuthority": "DIRECT_HUMAN_GO_BOUND_TO_PINNED_IDENTITY_AND_PERSONAL_INBOX",
    "claimMode": "ATOMIC_AGENT_STATE_CLAIM_WITH_SINGLE_USE_GO_EVIDENCE",
    "stringSubstringEvidenceForbidden": true,
    "hostSessionAttestationRequired": false,
    "currentInboxSource": "BOUND_MUTABLE_INBOX_INDEX_LOCATION",
    "bootstrapInboxBlobMayBecomeStaleAfterDispatch": true,
    "bootstrapInboxBlobNeverUsedForCurrentJobDiscovery": true,
    "masterMayActivateChat": false,
    "masterMaySynthesizeHumanGo": false,
    "masterMayCreateHumanGoEvidence": false,
    "activationAuthority": "HUMAN_ONLY",
    "currentInboxSnapshotBlobIsStableAcrossDispatch": false,
    "currentInboxSnapshotPurpose": "INITIALIZATION_OBSERVATION_ONLY",
    "inboxContentChangeAfterMasterDispatch": "NORMAL_RELOAD_FROM_BOUND_MUTABLE_LOCATION",
    "inboxBlobChangeAloneRequiresReidentification": false
  },
  "onHumanGo": {
    "allowedReadsInOrder": [
      "PINNED_IDENTITY",
      "AGENT_STATE",
      "CURRENT_PERSONAL_INBOX_INDEX_AT_BOUND_LOCATION",
      "SELECTED_INBOX_JOB_CONTRACT",
      "PINNED_AGENT_JOB_CONTRACT_MODEL_FROM_ACTIVATION_MODEL",
      "PINNED_AGENT_JOB_SCHEMA_FROM_ACTIVATION_MODEL",
      "SELECTED_MASTER_JOB_STATE",
      "JOB_REFERENCED_INPUTS_ONLY",
      "BOUND_HUMAN_GO_EVIDENCE_TEMPLATE_AND_SCHEMA",
      "BOUND_AGENT_STATE_SCHEMA_AND_CLAIM_TEMPLATE"
    ],
    "forbiddenDiscovery": [
      "GLOBAL_REPOSITORY_SEARCH",
      "OTHER_AGENT_INBOX_READ",
      "PROJECT_TREE_FULL_SCAN",
      "UNREFERENCED_ARTIFACT_DISCOVERY"
    ],
    "preClaimChecks": [
      "IDENTITY_ACTIVE",
      "IDENTITY_REVISION_MATCH",
      "PERSONAL_INBOX_PROJECT_AND_AGENT_MATCH",
      "CURRENT_INBOX_READ_FROM_BOUND_LOCATION",
      "DISCOVERABLE_JOB_AVAILABLE",
      "JOB_AGENT_ASSIGNMENT_MATCH",
      "JOB_IDENTITY_REVISION_MATCH",
      "JOB_DISPATCH_REVISION_MATCH",
      "JOB_CLAIM_AND_RESPONSE_BINDINGS_COMPLETE",
      "AGENT_JOB_CONTRACT_MODEL_VALID",
      "AGENT_JOB_SCHEMA_VALID",
      "JOB_CONTRACT_POINTER_EXACT_MATCH",
      "HUMAN_GO_EVIDENCE_BOUND_TO_SELECTED_JOB",
      "ROLE_AND_SKILL_MATCH",
      "MANDATE_ACTIVE",
      "MASTER_JOB_STATE_READ_ONLY_AND_WAITING_HUMAN_GO",
      "AGENT_STATE_CLAIM_TARGET_BOUND",
      "ACTUAL_PROVIDER_RIGHTS_SUFFICIENT",
      "HUMAN_GO_EVIDENCE_SCHEMA_AND_TEMPLATE_PINNED",
      "AGENT_STATE_SCHEMA_AND_CLAIM_TEMPLATE_PINNED",
      "PROPOSED_GO_EVIDENCE_VALIDATES_BEFORE_PERSISTENCE",
      "PERSISTED_GO_EVIDENCE_PROVIDER_READBACK_VALID",
      "PROPOSED_AGENT_STATE_VALIDATES_BEFORE_CAS"
    ],
    "failClosed": true,
    "invalidJobContractOutcome": "BLOCKED_NO_CLAIM_NO_PRODUCT_MUTATION",
    "jobValidationAuthority": {
      "authority": "PINNED_SCHEMA_PLUS_PINNED_CONTRACT_MODEL",
      "refSource": "SAME_REPOSITORY_AND_REF_AS_PINNED_ACTIVATION_MODEL",
      "schemaPath": "v0.14.0/schemas/agent-job.schema.json",
      "contractModelPath": "v0.14.0/agent-job-contract-model.json",
      "referenceValidatorPath": "runtime/agent_jobs.py",
      "referenceValidatorRequiredForNormalChatUse": false,
      "referenceValidatorRole": "CI_AND_REFERENCE_VERIFICATION",
      "globalSearchRequired": false,
      "failClosedIfSchemaOrContractModelUnavailable": true
    },
    "preSelectionAgentStateHandling": {
      "normalReadyStatuses": [
        "IDLE",
        "WAITING_HUMAN_GO"
      ],
      "onSettledPriorExecution": [
        "READ_PRIOR_CURRENT_JOB_BINDING_FROM_AGENT_STATE",
        "READ_PRIOR_MASTER_JOB_STATE_READ_ONLY",
        "IF_PRIOR_AGENT_STATE_BLOCKED_READ_AND_VALIDATE_LAST_TYPED_BLOCKING_RESPONSE",
        "IF_PRIOR_AGENT_STATE_BLOCKED_REQUIRE_PRIOR_MASTER_JOB_REJECTED_CANCELED_OR_SUPERSEDED",
        "REQUIRE_PRIOR_MASTER_JOB_TERMINALLY_SETTLED",
        "LOAD_PINNED_SETTLED_REARM_STATE_TEMPLATE",
        "BUILD_REARMED_AGENT_STATE",
        "PRESERVE_CONSUMED_ACTIVATION_IDS_AND_LAST_RESPONSE_REF",
        "CLEAR_SESSION_AND_CURRENT_JOB",
        "VALIDATE_REARMED_AGENT_STATE",
        "CAS_REARM_AGENT_STATE_AT_EXPECTED_REVISION",
        "PROVIDER_READBACK_REARMED_AGENT_STATE",
        "CONTINUE_SAME_DIRECT_HUMAN_GO_WITH_CURRENT_PERSONAL_INBOX"
      ],
      "settledMasterStatuses": [
        "REJECTED",
        "ACCEPTED",
        "INTEGRATED",
        "CANCELED",
        "SUPERSEDED"
      ],
      "rearmStateOwner": "AGENT",
      "masterMayWriteAgentState": false,
      "newHumanGoConsumptionDuringRearm": false,
      "secondHumanGoRequired": false,
      "onUnsettledPriorMasterJob": "BLOCKED_NO_NEW_JOB_CLAIM",
      "rearmForbiddenDuringInitialization": true,
      "rearmRequiresSeparateDirectHumanGo": true,
      "rearmHumanInputSource": "DIRECT_HUMAN_INPUT_IN_INITIALIZED_AGENT_CHAT",
      "rearmHumanMessage": "GO",
      "rearmStateMustRetainAllRequiredTopLevelFields": true,
      "rearmSessionAndCurrentJobRepresentation": "EXPLICIT_NULL",
      "readyStatusForbiddenIfPersistedStateInvalid": true,
      "reidentificationStatus": "REIDENTIFICATION_REQUIRED",
      "onReidentifiedAgent": [
        "READ_PINNED_REIDENTIFICATION_EVIDENCE_FROM_SELECTED_JOB_INPUTS",
        "VALIDATE_REIDENTIFICATION_EVIDENCE_IDENTITY_AND_BOOTSTRAP_BINDINGS",
        "LOAD_PINNED_REIDENTIFICATION_READY_STATE_TEMPLATE",
        "BUILD_REIDENTIFIED_WAITING_STATE",
        "PRESERVE_CONSUMED_ACTIVATION_IDS_AND_LAST_RESPONSE_REF",
        "CLEAR_SESSION_AND_CURRENT_JOB",
        "VALIDATE_REIDENTIFIED_WAITING_STATE",
        "CAS_REIDENTIFIED_WAITING_STATE_AT_EXPECTED_REVISION",
        "PROVIDER_READBACK_REIDENTIFIED_WAITING_STATE",
        "CONTINUE_SAME_DIRECT_HUMAN_GO_WITH_CURRENT_PERSONAL_INBOX"
      ],
      "reidentificationStateOwner": "AGENT",
      "masterMayWriteReidentificationState": false,
      "reidentificationEvidenceExpectedType": "SAFOR_AGENT_REIDENTIFICATION_EVIDENCE",
      "reidentificationEvidenceSchemaRef": "schemas/agent-reidentification-evidence.schema.json",
      "reidentificationStateTemplateRef": "templates/agent-state-reidentification-ready.template.json",
      "reidentificationRearmConsumesHumanGo": false,
      "reidentificationSecondHumanGoRequired": false,
      "reidentificationRearmRequiresProviderCasAndReadback": true,
      "reidentificationOnMissingOrInvalidEvidence": "BLOCKED_NO_NEW_JOB_CLAIM",
      "settledPriorExecutionStatuses": [
        "RESULT_SUBMITTED",
        "BLOCKED"
      ],
      "blockedPriorExecutionRequirements": {
        "requiredLastResponseTypes": [
          "JOB_ERROR",
          "CLARIFICATION_REQUEST",
          "CAPABILITY_MISMATCH"
        ],
        "providerReadbackOfBlockingResponseRequired": true,
        "responseMustMatchPriorJobAgentAndIdentity": true,
        "allowedPriorMasterStatuses": [
          "REJECTED",
          "CANCELED",
          "SUPERSEDED"
        ],
        "priorMasterResponseRefRequired": true,
        "rule": "A BLOCKED Agent State is rearmable only after the typed blocking response is provider-read-back and the prior MASTER Job is terminally resolved as REJECTED, CANCELED or SUPERSEDED. ACCEPTED or INTEGRATED may never settle a BLOCKED execution for rearm."
      },
      "settledRearmStateTemplateRef": "templates/agent-state-settled-rearm.template.json"
    }
  },
  "reidentificationProtocol": {
    "triggers": [
      "PINNED_IDENTITY_UNAVAILABLE_OR_BLOB_MISMATCH",
      "IDENTITY_REVISION_MISMATCH",
      "CONTROL_REPOSITORY_UNAVAILABLE",
      "PERSONAL_INBOX_PROJECT_OR_AGENT_MISMATCH",
      "AGENT_CANNOT_PROVE_PINNED_IDENTITY",
      "PERSONAL_INBOX_LOCATION_MISMATCH"
    ],
    "effect": [
      "NO_JOB_CLAIM",
      "NO_PRODUCT_MUTATION",
      "NO_RESPONSE_PATH_GUESSING",
      "EMIT_MINIMAL_REINITIALIZATION_STATUS"
    ],
    "requiredHumanPath": "RELOAD_MASTER_GENERATED_AGENT_INITIALIZATION_PROMPT",
    "successfulBootstrap": [
      "MASTER_RECORDS_HUMAN_REPORTED_EXACT_READY_ACKNOWLEDGEMENT_AS_IMMUTABLE_REIDENTIFICATION_EVIDENCE",
      "MASTER_MUST_NOT_MUTATE_AGENT_STATE",
      "NEXT_DISPATCHED_JOB_PINS_REIDENTIFICATION_EVIDENCE_AS_READ_ONLY_INPUT",
      "AGENT_STATE_REMAINS_REIDENTIFICATION_REQUIRED_UNTIL_LATER_DIRECT_HUMAN_GO"
    ],
    "onLaterHumanGo": [
      "AGENT_VALIDATES_PINNED_REIDENTIFICATION_EVIDENCE",
      "AGENT_CAS_REARMS_OWN_STATE_TO_WAITING_HUMAN_GO_WITHOUT_CONSUMING_GO",
      "AGENT_READS_BACK_AND_VALIDATES_REARMED_STATE",
      "SAME_DIRECT_HUMAN_GO_CONTINUES_TO_NORMAL_JOB_ACTIVATION"
    ],
    "evidenceFormat": "SAFOR_AGENT_REIDENTIFICATION_EVIDENCE",
    "evidenceSchemaRef": "schemas/agent-reidentification-evidence.schema.json",
    "stateTemplateRef": "templates/agent-state-reidentification-ready.template.json",
    "initializationStateMutationForbidden": true,
    "masterStateMutationForbidden": true,
    "secondHumanGoRequired": false
  },
  "goEvidenceContract": {
    "format": "SAFOR_HUMAN_GO_EVIDENCE",
    "schemaVersion": "0.14.0",
    "requiredFields": [
      "activationId",
      "projectId",
      "agentId",
      "identityRevision",
      "targetJobId",
      "targetDispatchRevision",
      "intent",
      "source",
      "observedAt",
      "singleUse",
      "jobPromptTransported"
    ],
    "constants": {
      "intent": "GO",
      "source": "DIRECT_HUMAN_INPUT_IN_INITIALIZED_AGENT_CHAT",
      "singleUse": true,
      "jobPromptTransported": false
    },
    "schemaRef": "schemas/human-go-evidence.schema.json",
    "templateRef": "templates/human-go-evidence.template.json",
    "persistence": {
      "pathPattern": "agents/{agentId}/evidence/{jobId}/human-go-{activationId}.json",
      "owner": "AGENT",
      "requiredBeforeClaim": true,
      "providerReadbackRequired": true,
      "schemaValidationRequiredBeforeWrite": true,
      "schemaValidationRequiredAfterReadback": true
    }
  },
  "atomicClaimContract": {
    "expectedAgentState": "WAITING_HUMAN_GO",
    "masterJobStateRequired": "WAITING_HUMAN_GO",
    "claimStateOwner": "AGENT",
    "claimStateTarget": "agents/{agentId}/state.json",
    "masterJobStateMutationAllowed": false,
