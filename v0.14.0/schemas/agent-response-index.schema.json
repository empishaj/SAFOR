{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:safor:agent-response-index:0.14.0",
  "title": "SAFOR Agent Response Index 0.14.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "projectId",
    "agentId",
    "identityRevision",
    "revision",
    "authoritativeAcceptance",
    "entries",
    "updatedAt"
  ],
  "properties": {
    "format": {"const": "SAFOR_AGENT_RESPONSE_INDEX"},
    "schemaVersion": {"const": "0.14.0"},
    "projectId": {"type": "string", "minLength": 1},
    "agentId": {"type": "string", "minLength": 3},
    "identityRevision": {"type": "integer", "minimum": 1},
    "revision": {"type": "integer", "minimum": 1},
    "authoritativeAcceptance": {"const": false},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "updatedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "path", "blobSha"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "blobSha": {"type": "string", "minLength": 7}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["responseId", "responseType", "jobId", "responseRef", "createdAt", "responseState", "resolutionRef"],
      "properties": {
        "responseId": {"type": "string", "minLength": 1},
        "responseType": {"enum": ["JOB_RESULT", "JOB_ERROR", "CLARIFICATION_REQUEST", "CAPABILITY_MISMATCH", "IMPROVEMENT_PROPOSAL"]},
        "jobId": {"type": "string", "minLength": 1},
        "responseRef": {"$ref": "#/$defs/pointer"},
        "createdAt": {"type": "string", "format": "date-time"},
        "responseState": {"enum": ["SUBMITTED", "ACKNOWLEDGED", "RESOLVED", "SUPERSEDED", "CLOSED"]},
        "resolutionRef": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/pointer"}]}
      }
    }
  }
}
