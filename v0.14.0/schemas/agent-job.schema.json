{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:safor:agent-job:0.14.0",
  "title": "SAFOR Canonical Agent Job Contract 0.14.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "identity",
    "lineage",
    "provenance",
    "assignment",
    "domainContext",
    "roleContract",
    "skills",
    "task",
    "dependencies",
    "inputs",
    "authorization",
    "workspace",
    "scheduling",
    "outputContract",
    "responseContracts",
    "communicationContract",
    "verificationContract",
    "constraints",
    "humanReadableProjection"
  ],
  "properties": {
    "format": {
      "const": "SAFOR_AGENT_JOB"
    },
    "schemaVersion": {
      "const": "0.14.0"
    },
    "identity": {
      "$ref": "#/$defs/jobIdentity"
    },
    "lineage": {
      "$ref": "#/$defs/lineage"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "assignment": {
      "$ref": "#/$defs/assignment"
    },
    "domainContext": {
      "$ref": "#/$defs/domainContext"
    },
    "roleContract": {
      "$ref": "#/$defs/roleContract"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/skill"
      }
    },
    "task": {
      "$ref": "#/$defs/task"
    },
    "dependencies": {
      "$ref": "#/$defs/dependencies"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "authorization": {
      "$ref": "#/$defs/authorization"
    },
    "workspace": {
      "$ref": "#/$defs/workspace"
    },
    "scheduling": {
      "$ref": "#/$defs/scheduling"
    },
    "outputContract": {
      "$ref": "#/$defs/outputContract"
    },
    "responseContracts": {
      "$ref": "#/$defs/responseContracts"
    },
    "communicationContract": {
      "$ref": "#/$defs/communicationContract"
    },
    "verificationContract": {
      "$ref": "#/$defs/verificationContract"
    },
    "constraints": {
      "$ref": "#/$defs/constraints"
    },
    "humanReadableProjection": {
      "$ref": "#/$defs/pointer"
    }
  },
  "$defs": {
    "pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref",
        "path",
        "blobSha"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "blobSha": {
          "type": "string",
          "minLength": 7
        }
      }
    },
    "writeTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryClass",
        "repository",
        "branch",
        "pathPattern",
        "allowedOperations"
      ],
      "properties": {
        "repositoryClass": {
          "enum": [
            "WORK_REPOSITORY",
            "CONTROL_REPOSITORY"
          ]
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "pathPattern": {
          "type": "string",
          "minLength": 1
        },
        "allowedOperations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "READ",
              "CREATE",
              "MODIFY",
              "COMMIT",
              "PUSH",
              "OPEN_CHANGE_REQUEST",
              "UPDATE_INDEX",
              "COMPARE_AND_SWAP"
            ]
          }
        }
      }
    },
    "jobIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "jobKey",
        "jobType",
        "contractRevision",
        "immutableAfterPublication"
      ],
      "properties": {
        "jobId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "jobKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "jobType": {
          "type": "string",
          "minLength": 1
        },
        "contractRevision": {
          "type": "integer",
          "minimum": 1
        },
        "immutableAfterPublication": {
          "const": true
        }
      }
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planSequence",
        "packageSequence",
        "dispatchSequence",
        "attempt",
        "reworkCycle"
      ],
      "properties": {
        "planSequence": {
          "type": "integer",
          "minimum": 1
        },
        "packageSequence": {
          "type": "integer",
          "minimum": 1
        },
        "dispatchSequence": {
          "type": "integer",
          "minimum": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "reworkCycle": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "valueStreamId",
        "packageId",
        "packageRevision",
        "workItemId",
        "workItemRevision",
        "parentWorkItemId",
        "rootPackageId",
        "sequence",
        "supersedesJobId",
        "triggerConflictRef"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "valueStreamId": {
          "type": "string",
          "minLength": 1
        },
        "packageId": {
          "type": "string",
          "minLength": 1
        },
        "packageRevision": {
          "type": "integer",
          "minimum": 1
        },
        "workItemId": {
          "type": "string",
          "minLength": 1
        },
        "workItemRevision": {
          "type": "integer",
          "minimum": 1
        },
        "parentWorkItemId": {
          "type": [
            "string",
            "null"
          ]
        },
        "rootPackageId": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "$ref": "#/$defs/sequence"
        },
        "supersedesJobId": {
          "type": [
            "string",
            "null"
          ]
        },
        "triggerConflictRef": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/pointer"
            }
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "createdAt",
        "issuedAt",
        "masterId",
        "masterVersion",
        "masterRunId",
        "masterStateRevision",
        "planningRef",
        "mandateRef"
      ],
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "masterId": {
          "type": "string",
          "minLength": 1
        },
        "masterVersion": {
          "type": "string",
          "minLength": 1
        },
        "masterRunId": {
          "type": "string",
          "minLength": 1
        },
        "masterStateRevision": {
          "type": "integer",
          "minimum": 0
        },
        "planningRef": {
          "$ref": "#/$defs/pointer"
        },
        "mandateRef": {
          "$ref": "#/$defs/pointer"
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentId",
        "displayName",
        "identityRevision",
        "identityRef",
        "assignmentMode",
        "assignmentReason"
      ],
      "properties": {
        "agentId": {
          "type": "string",
          "minLength": 3
        },
        "displayName": {
          "type": "string",
          "minLength": 3
        },
        "identityRevision": {
          "type": "integer",
          "minimum": 1
        },
        "identityRef": {
          "$ref": "#/$defs/pointer"
        },
        "assignmentMode": {
          "const": "EXCLUSIVE"
        },
        "assignmentReason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "domainContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creationType",
        "domainId",
        "factoryRef",
        "operatingModelRef",
        "compatibilityDecisionRef"
      ],
      "properties": {
        "creationType": {
          "type": "string",
          "minLength": 1
        },
        "domainId": {
          "type": "string",
          "minLength": 1
        },
        "factoryRef": {
          "$ref": "#/$defs/pointer"
        },
        "operatingModelRef": {
          "$ref": "#/$defs/pointer"
        },
        "compatibilityDecisionRef": {
          "$ref": "#/$defs/pointer"
        }
      }
    },
    "roleContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleId",
        "roleName",
        "roleDefinitionRef",
        "mission",
        "responsibilities",
        "mustNotActAs",
        "decisionRights",
        "authorityExpansionAllowed"
      ],
      "properties": {
        "roleId": {
          "type": "string",
          "minLength": 1
        },
        "roleName": {
          "type": "string",
          "minLength": 1
        },
        "roleDefinitionRef": {
          "$ref": "#/$defs/pointer"
        },
        "mission": {
          "type": "string",
          "minLength": 1
        },
        "responsibilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mustNotActAs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "decisionRights": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "authorityExpansionAllowed": {
          "const": false
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skillId",
        "skillVersion",
        "mandatory",
        "description",
        "executionInstructions",
        "useFor",
        "skillRef",
        "requiredLevel"
      ],
      "properties": {
        "skillId": {
          "type": "string",
          "minLength": 1
        },
        "skillVersion": {
          "type": "string",
          "minLength": 1
        },
        "mandatory": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "executionInstructions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "useFor": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "skillRef": {
          "$ref": "#/$defs/pointer"
        },
        "requiredLevel": {
          "enum": [
            "BASIC",
            "PROFICIENT",
            "EXPERT"
          ]
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "objective",
        "instruction",
        "expectedOutcome",
        "completionDefinition",
        "inScope",
        "outOfScope",
        "assumptions",
        "acceptanceCriteria"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "expectedOutcome": {
          "type": "string",
          "minLength": 1
        },
        "completionDefinition": {
          "type": "string",
          "minLength": 1
        },
        "inScope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outOfScope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredWorkItems",
        "dependencyPredicate"
      ],
      "properties": {
        "requiredWorkItems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pointer"
          }
        },
        "dependencyPredicate": {
          "const": "ALL_REQUIRED_ACCEPTED"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputId",
        "artifactRef",
        "mode",
        "expectedType",
        "purpose"
      ],
      "properties": {
        "inputId": {
          "type": "string",
          "minLength": 1
        },
        "artifactRef": {
          "$ref": "#/$defs/pointer"
        },
        "mode": {
          "const": "READ_ONLY"
        },
        "expectedType": {
          "type": [
            "string",
            "null"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repositoryPermission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryClass",
        "repository",
        "read",
        "write",
        "branchCreate",
        "commit",
        "push",
        "changeRequestCreate",
        "merge",
        "deploy"
      ],
      "properties": {
        "repositoryClass": {
          "enum": [
            "WORK_REPOSITORY",
            "CONTROL_REPOSITORY"
          ]
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "read": {
          "type": "boolean"
        },
        "write": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed",
            "allowedBranches",
            "allowedPaths"
          ],
          "properties": {
            "allowed": {
              "type": "boolean"
            },
            "allowedBranches": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "allowedPaths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "branchCreate": {
          "type": "boolean"
        },
        "commit": {
          "type": "boolean"
        },
        "push": {
          "type": "boolean"
        },
        "changeRequestCreate": {
          "type": "boolean"
        },
        "merge": {
          "const": false
        },
        "deploy": {
          "const": false
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityBasis",
        "actualProviderRightsMustBeVerified",
        "repositoryPermissions",
        "responseWriteDoesNotGrantProductWrite",
        "productWriteDoesNotGrantResponseWrite",
        "explicitlyForbidden"
      ],
      "properties": {
        "authorityBasis": {
          "$ref": "#/$defs/pointer"
        },
        "actualProviderRightsMustBeVerified": {
          "const": true
        },
        "repositoryPermissions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/repositoryPermission"
          }
        },
        "responseWriteDoesNotGrantProductWrite": {
          "const": true
        },
        "productWriteDoesNotGrantResponseWrite": {
          "const": true
        },
        "explicitlyForbidden": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "productWorkspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceClass",
        "repository",
        "defaultBranch",
        "jobBranch",
        "baseCommitSha",
        "allowedPaths",
        "mutating"
      ],
      "properties": {
        "workspaceClass": {
          "enum": [
            "REMOTE_GIT",
            "LOCAL_GIT"
          ]
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "defaultBranch": {
          "type": "string",
          "minLength": 1
        },
        "jobBranch": {
          "type": "string",
          "minLength": 1
        },
        "baseCommitSha": {
          "type": "string",
          "minLength": 7
        },
        "allowedPaths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mutating": {
          "type": "boolean"
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productWorkspace",
        "responseWorkspace",
        "readSet",
        "exclusiveKeys"
      ],
      "properties": {
        "productWorkspace": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/productWorkspace"
            }
          ]
        },
        "responseWorkspace": {
          "$ref": "#/$defs/writeTarget"
        },
        "readSet": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pointer"
          }
        },
        "exclusiveKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "scheduling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "dispatchRevision",
        "dispatchState",
        "dispatchWaveRef",
        "resourceLeaseRefs",
        "activationMode",
        "claimPolicy"
      ],
      "properties": {
        "priority": {
          "type": "integer"
        },
        "dispatchRevision": {
          "type": "integer",
          "minimum": 1
        },
        "dispatchState": {
          "const": "WAITING_HUMAN_GO"
        },
        "dispatchWaveRef": {
          "$ref": "#/$defs/pointer"
        },
        "resourceLeaseRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pointer"
          }
        },
        "activationMode": {
          "const": "HUMAN_GO_REQUIRED"
        },
        "claimPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exclusiveAgentClaim",
            "optimisticConcurrencyRequired",
            "humanGoEvidenceRequired",
            "claimStateTarget",
            "claimAuthority"
          ],
          "properties": {
            "exclusiveAgentClaim": {
              "const": true
            },
            "optimisticConcurrencyRequired": {
              "const": true
            },
            "humanGoEvidenceRequired": {
              "const": true
            },
            "claimStateTarget": {
              "$ref": "#/$defs/writeTarget"
            },
            "claimAuthority": {
              "const": "AGENT_STATE_PROVIDER_CAS_READBACK",
              "description": "Claim authority is the exact provider-confirmed CAS of the assigned agent's own state.json; master/jobs remains read-only to the agent."
            }
          }
        }
      }
    },
    "outputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredOutputs",
        "productWriteTarget"
      ],
      "properties": {
        "requiredOutputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "productWriteTarget": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/writeTarget"
            }
          ]
        }
      }
    },
    "responseBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responseType",
        "templateRef",
        "schemaRef",
        "writeTarget",
        "required"
      ],
      "properties": {
        "responseType": {
          "enum": [
            "JOB_RESULT",
            "JOB_ERROR",
            "CLARIFICATION_REQUEST",
            "CAPABILITY_MISMATCH",
            "IMPROVEMENT_PROPOSAL"
          ]
        },
        "templateRef": {
          "$ref": "#/$defs/pointer"
        },
        "schemaRef": {
          "$ref": "#/$defs/pointer"
        },
        "writeTarget": {
          "$ref": "#/$defs/writeTarget"
        },
        "required": {
          "const": true
        }
      }
    },
    "responseContracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "JOB_RESULT",
        "JOB_ERROR",
        "CLARIFICATION_REQUEST",
        "CAPABILITY_MISMATCH",
        "IMPROVEMENT_PROPOSAL",
        "responseIndexTarget",
        "resolutionSchemaRef"
      ],
      "properties": {
        "JOB_RESULT": {
          "$ref": "#/$defs/responseBinding"
        },
        "JOB_ERROR": {
          "$ref": "#/$defs/responseBinding"
        },
        "CLARIFICATION_REQUEST": {
          "$ref": "#/$defs/responseBinding"
        },
        "CAPABILITY_MISMATCH": {
          "$ref": "#/$defs/responseBinding"
        },
        "IMPROVEMENT_PROPOSAL": {
          "$ref": "#/$defs/responseBinding"
        },
        "responseIndexTarget": {
          "$ref": "#/$defs/writeTarget"
        },
        "resolutionSchemaRef": {
          "$ref": "#/$defs/pointer"
        }
      }
    },
    "communicationContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelRef",
        "chatOutputSchemaRef",
        "humanDomainConversationAllowed",
        "detailedReportsInGit",
        "allowedStatuses"
      ],
      "properties": {
        "modelRef": {
          "$ref": "#/$defs/pointer"
        },
        "chatOutputSchemaRef": {
          "$ref": "#/$defs/pointer"
        },
        "humanDomainConversationAllowed": {
          "const": false
        },
        "detailedReportsInGit": {
          "const": true
        },
        "allowedStatuses": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "READY",
              "STARTED",
              "SUBMITTED",
              "BLOCKED",
              "REIDENTIFICATION_REQUIRED"
            ]
          }
        }
      }
    },
    "verificationContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptanceCriteria",
        "evidenceRequirements",
        "independentReviewRequired",
        "reviewerMustDifferFromAuthor",
        "acceptanceAuthority",
        "integrationAuthority"
