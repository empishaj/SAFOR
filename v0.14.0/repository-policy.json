{
  "kind": "SAFOR_REPOSITORY_BOUNDARY_POLICY",
  "version": "0.14.0",
  "policyId": "SAFOR-WORKSPACE-BOUNDARY-V3",
  "denyByDefault": true,
  "principles": {
    "controlPlaneSeparatedFromWorkArtifacts": true,
    "providerNeutral": true,
    "projectScopedControl": true,
    "workerMayNotMutateControlStateByDefault": true,
    "packagesAreReadOnlyAfterProjectPinning": true,
    "actualProviderRightsOverrideDeclaredIntent": true,
    "agentWorkspaceOwnershipSeparated": true,
    "humanOwnsProjectWorkspace": true,
    "productRepositoryNeverImplicitProjectWorkspace": true,
    "packageSourceNeverImplicitProjectWorkspace": true,
    "localGitIsFirstClassProjectWorkspace": true,
    "controlStrategyDependsOnWorkspaceType": true,
    "entitlementDoesNotGrantAuthority": true
  },
  "repositoryClasses": {
    "CONTROL_REPOSITORY": {
      "purpose": "Remote SAFOR control repository for REMOTE_GIT projects. Persists project bindings, state, decisions, evidence, package snapshots, agent workspaces, MASTER jobs and audit records.",
      "allowedRoots": [
        "projects/",
        "factory/"
      ],
      "forbiddenContentClasses": [
        "DOMAIN_EXECUTABLE_ARTIFACT"
      ],
      "requiredName": "safor-memory",
      "appliesWhen": "PROJECT_WORKSPACE_TYPE == REMOTE_GIT"
    },
    "WORK_REPOSITORY": {
      "purpose": "HUMAN-owned remote Git repository containing Factory-produced domain work artifacts. It must never be the canonical SAFOR product repository or a commercial package source.",
      "forbiddenPrefixes": [
        "factory/",
        "safor-master/",
        "control-plane/",
        "projects/",
        "agents/",
        "contracts/",
        ".saf/"
      ],
      "forbiddenNames": [
        "SAFOR-MASTER.json",
        "master-state.json",
        "launch-prompt.md",
        "work-contract.json"
      ],
      "agentMutationPolicy": {
        "directDefaultBranchWrite": false,
        "requiredBranchPattern": "safor/job/{jobKey}/{agentKey}",
        "immutableBaseCommitRequired": true,
        "allowedPathsMustMatchJobContract": true,
        "crossJobBranchWrite": false,
        "mergeAuthority": "MASTER_OR_EXPLICIT_AUTHORITY",
        "resultTraceRequired": [
          "baseCommitSha",
          "branch",
          "commitShas",
          "headCommitSha",
          "changedPaths",
          "providerReadbackRef"
        ]
      }
    },
    "FACTORY_RUNTIME_CODE_REPOSITORY": {
      "purpose": "Optional dedicated implementation repository for executable SAFOR runtime/adapters.",
      "status": "UNBOUND_BY_DEFAULT"
    },
    "LOCAL_GIT_WORKSPACE": {
      "purpose": "HUMAN-owned local Git repository containing domain work artifacts plus a protected MASTER-only .safor/ control root.",
      "requiredControlRoot": ".safor/",
      "controlRootOwnership": "MASTER_ONLY",
      "workerForbiddenPrefixes": [
        ".safor/"
      ],
      "gitRequired": true,
      "mutationPolicy": {
        "directDefaultBranchWrite": false,
        "requiredBranchPattern": "safor/job/{jobKey}/{agentKey}",
        "immutableBaseCommitRequired": true,
        "allowedPathsMustMatchJobContract": true,
        "crossJobBranchWrite": false,
        "mergeAuthority": "MASTER_OR_EXPLICIT_AUTHORITY",
        "resultTraceRequired": [
          "baseCommitSha",
          "branch",
          "commitShas",
          "headCommitSha",
          "changedPaths",
          "providerReadbackRef"
        ]
      }
    }
  },
  "projectControlLayout": {
    "remote": {
      "root": "projects/{projectSlug}/",
      "permittedPrefixes": [
        "packages/",
        "state/",
        "decisions/",
        "evidence/",
        "artifacts/",
        "work-items/",
        "agents/",
        "audit/",
        "master/jobs/",
        "master/scheduler/",
        "master/dispatch-waves/",
        "master/resource-leases/"
      ],
      "requiredFiles": [
        "project.json",
        "bindings.json",
        "state/control.json",
        "state/value-stream.json",
        "state/execution.json",
        "agents/index.json",
        "master/scheduler/state.json"
      ]
    },
    "local": {
      "root": ".safor/",
      "permittedPrefixes": [
        "packages/",
        "state/",
        "decisions/",
        "evidence/",
        "artifacts/",
        "work-items/",
        "agents/",
        "audit/",
        "master/jobs/",
        "master/scheduler/",
        "master/dispatch-waves/",
        "master/resource-leases/"
      ],
      "requiredFiles": [
        "project.json",
        "bindings.json",
        "workspace.json",
        "state/control.json",
        "state/value-stream.json",
        "state/execution.json",
        "agents/index.json",
        "master/scheduler/state.json"
      ],
      "workerWritesForbidden": true
    }
  },
  "reconciliation": {
    "readCurrentProviderRevisionBeforeWrite": true,
    "compareExpectedRevision": true,
    "requireProviderReadback": true,
    "unknownMutationOutcome": "RECONCILE_REQUIRED",
    "blockOnUnexpectedHistoryRewrite": true
  },
  "note": "Domain work artifact classes are defined by the bound FACTORY package. This policy intentionally contains no software-specific source/test/config taxonomy.",
  "selfHealingSafety": {
    "allowed": "Only verified, bounded, non-destructive repairs within existing authorization.",
    "forbidden": [
      "force_push",
      "history_rewrite",
      "repository_delete",
      "authoritative_state_delete_without_verified_restore",
      "gate_bypass",
      "review_bypass",
      "mandate_expansion",
      "invented_evidence"
    ],
    "requireReadbackAfterRepair": true,
    "requireReconciliationBeforeRetryOnUnknownEffect": true
  },
  "controlRepositoryRequirement": {
    "mandatoryWhen": "PROJECT_WORKSPACE_TYPE == REMOTE_GIT",
    "exactName": "safor-memory",
    "locationPattern": "{selectedOwner}/safor-memory",
    "mustPreExist": true,
    "autoCreate": false,
    "accessRequired": [
      "READ",
      "WRITE"
    ],
    "onMissingOrInsufficientAccess": "WAITING_HUMAN_CONTROL_WORKSPACE",
    "localAlternative": {
      "when": "PROJECT_WORKSPACE_TYPE == LOCAL_GIT",
      "strategy": "LOCAL_MASTER_CONTROL_ROOT",
      "root": ".safor/",
      "masterOnly": true,
      "gitTracked": true
    },
    "rule": "Historical compatibility projection only; current execution uses controlWorkspacePolicy.",
    "status": "DEPRECATED_NON_EXECUTABLE",
    "supersededBy": "controlWorkspacePolicy"
  },
  "agentWorkspaceOwnership": {
    "modelRef": "agent-workspace-model.json",
    "masterOwned": [
      "agents/index.json",
      "agents/{agentId}/identity.json",
      "agents/{agentId}/inbox/index.json",
      "agents/{agentId}/inbox/{jobId}.json",
      "agents/{agentId}/inbox/{jobId}.md",
      "master/jobs/{jobId}.json",
      "master/scheduler/state.json",
      "master/dispatch-waves/{waveId}.json",
      "master/resource-leases/{leaseId}.json"
    ],
    "agentOwned": [
      "agents/{agentId}/state.json",
      "agents/{agentId}/outbox/{jobId}.result.json",
      "agents/{agentId}/evidence/{jobId}/",
      "agents/{agentId}/audit/",
      "agents/{agentId}/outbox/{jobId}.result.md"
    ],
    "rule": "Agent protocol writes are restricted to the agent's own state/outbox/evidence/audit workspace. Agents may not mutate registry, identity, inbox index, canonical job JSON, HUMAN job Markdown, scheduler state, dispatch waves, resource leases or MASTER job lifecycle artifacts.",
    "actualRightsRule": "Provider-observed permissions remain authoritative; workspace ownership is a SAFOR policy boundary, not a credential or permission grant.",
    "discoveryRule": "MASTER maintains agents/{agentId}/inbox/index.json as a non-authoritative discoverability projection. Agents read that fixed path, then verify the referenced job contract and master/jobs/{jobId}.json before claim; directory enumeration is not required.",
    "humanReadableResultRule": "Every agent job persists both outbox/{jobId}.result.json and outbox/{jobId}.result.md. The JSON pins the Markdown blob and control-repository commit.",
    "gitTraceRule": "Every mutating agent job must use only MASTER-declared dedicated job branches, report resulting commit SHAs and changed paths, and provide provider readback evidence. Direct default-branch mutation by an agent is forbidden.",
    "humanReadableJobRule": "MASTER creates agents/{agentId}/inbox/{jobId}.md as a non-authoritative projection of the immutable JSON job contract. JSON pins the Markdown blob identity. Both artifacts require provider readback before the job is exposed as READY.",
    "jobAuthorizationRule": "Repository/provider permissions declared in a job are maximum permitted scope only. Actual host/provider rights and active mandate/policy must independently allow every operation.",
    "returnRouteRule": "Job outputContract fixes machine result, HUMAN result, evidence and audit destinations before dispatch; ad-hoc return paths are forbidden."
  },
  "multiAgentScheduling": {
    "modelRef": "multi-agent-scheduler-model.json",
    "masterOwned": [
      "master/scheduler/state.json",
      "master/dispatch-waves/{waveId}.json",
      "master/resource-leases/{leaseId}.json"
    ],
    "mutationIsolation": "DEDICATED_JOB_BRANCH_PLUS_CONFLICT_DOMAIN_LEASE",
    "defaultAgentConcurrentJobs": 1,
    "unknownConflict": "SERIALIZE",
    "directAgentDefaultBranchWrite": false,
    "silentLeaseReassignment": false
  },
  "canonicalJobContract": {
    "modelRef": "agent-job-contract-model.json",
    "jsonPath": "agents/{agentId}/inbox/{jobId}.json",
    "humanPath": "agents/{agentId}/inbox/{jobId}.md",
    "jsonAuthoritative": true,
    "markdownAuthoritative": false,
    "immutableAfterDispatch": true,
    "providerReadbackBeforeReady": true,
    "agentMutationForbidden": true
  },
  "controlWorkspacePolicy": {
    "discriminator": "PROJECT_WORKSPACE_TYPE",
    "REMOTE_GIT": {
      "strategy": "REMOTE_SEPARATE_SAFOR_MEMORY",
      "target": "{selectedOwner}/safor-memory",
      "mustPreExist": true,
      "mustBeReadable": true,
      "mustBeWritable": true,
      "autoCreate": false,
      "onMissingOrInsufficientAccess": "WAITING_HUMAN_CONTROL_WORKSPACE"
    },
    "LOCAL_GIT": {
      "strategy": "LOCAL_MASTER_CONTROL_ROOT",
      "target": ".safor/",
      "mustBeGitTracked": true,
      "masterOnly": true,
      "workerWritesForbidden": true,
      "remoteMemoryRequired": false,
      "onMissingCapabilities": "WAITING_HUMAN_LOCAL_HOST_ACCESS"
    },
    "rule": "Exactly one branch applies. Remote and local control prerequisites must never be combined."
  }
}
