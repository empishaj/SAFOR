{
  "format": "SAFOR_MIGRATION_MODEL",
  "schemaVersion": "0.14.0",
  "id": "SAFOR-LOSSLESS-ACTIVE-AUTHORITY-MIGRATION",
  "purpose": "Migrate mixed SAF/SAFOR/AWC project histories to one active v0.14 authority chain without deleting or rewriting historical artifacts.",
  "principles": {
    "historyPreserved": true,
    "sourceArtifactsImmutable": true,
    "oneActiveAuthorityPerAggregate": true,
    "legacyArtifactsCannotDispatchOrClaim": true,
    "migrationRequiresEvidence": true,
    "repositoryAliasesCanonicalizedInNewRefsOnly": true,
    "noSilentFormatConversion": true,
    "providerReadbackRequired": true
  },
  "dispositions": {
    "ACTIVE": "The v0.14 artifact is the sole current authority for its aggregate.",
    "MIGRATED_ACTIVE": "A newly materialized v0.14 artifact is active and records its legacy sources.",
    "LEGACY_SNAPSHOT": "Historical artifact retained for audit; never used for new claim, dispatch or mutable authority.",
    "SUPERSEDED": "Historical operational artifact replaced by a pinned newer artifact or job; retained and linked."
  },
  "legacyFormats": [
    "SAF_MASTER_STATE",
    "SAF_AGENT_IDENTITY",
    "SAF_AGENT_INBOX_ENTRY",
    "SAF_AGENT_OUTBOX_ENTRY",
    "SAF_WORK_CONTRACT",
    "AWC_CONTRACT",
    "SAFOR_AGENT_IDENTITY@0.10.0",
    "SAFOR_AGENT_JOB@0.10.0",
    "SAFOR_AGENT_RESULT@0.10.0",
    "SAFOR_AGENT_JOB_STATE@0.10.0"
  ],
  "authorityAggregates": [
    "CONTROL_STATE",
    "AGENT_REGISTRY",
    "AGENT_IDENTITY",
    "AGENT_STATE",
    "INBOX_INDEX",
    "MASTER_JOB_STATE",
    "SCHEDULER_STATE",
    "PROJECT_STATUS_INDEX"
  ],
  "repositoryCanonicalization": {
    "canonicalPattern": "{owner}/safor-memory",
    "knownLegacyAliases": [
      "{owner}/saf-memory"
    ],
    "rule": "New v0.14 pointers use the verified canonical repository identity. Historical strings remain unchanged in source snapshots and are linked through alias evidence."
  },
  "migrationProtocol": [
    "READ_IMMUTABLE_PROJECT_INVENTORY",
    "CLASSIFY_EVERY_SOURCE_ARTIFACT",
    "VERIFY_CANONICAL_CONTROL_REPOSITORY",
    "MATERIALIZE_V014_ACTIVE_AGGREGATES",
    "REGISTER_ALL_ACTIVE_AND_LEGACY_AGENTS",
    "DISABLE_LEGACY_DISPATCH_AND_CLAIM",
    "WRITE_MIGRATION_MANIFEST_AND_EVIDENCE",
    "READ_BACK_ALL_NEW_ARTIFACTS",
    "ACTIVATE_EXACTLY_ONE_AUTHORITY_CHAIN"
  ],
  "creationTypeMigration": {
    "vocabularyRef": "creation-type-vocabulary.json",
    "legacyValue": "SOFTWARE_WEBSITE",
    "mode": "EXPLICIT_CONTEXTUAL_MIGRATION_ONLY",
    "requirements": [
      "PIN_SOURCE_PROJECT_DESCRIPTOR_AND_BINDINGS",
      "CLASSIFY_FROM_DOMAIN_AND_BOUND_FACTORY",
      "REQUIRE_HUMAN_DECISION_WHEN_AMBIGUOUS",
      "WRITE_NON_DESTRUCTIVE_MIGRATION_MANIFEST",
      "PRESERVE_LEGACY_ARTIFACTS",
      "PROVIDER_READBACK_REQUIRED"
    ],
    "outcomes": [
      "MIGRATED_TO_WEBSITE",
      "MIGRATED_TO_SOFTWARE_SAAS",
      "MIGRATION_DECISION_REQUIRED"
    ]
  }
}
