{
  "format": "SAFOR_AGENT_JOB_CONTRACT_MODEL",
  "schemaVersion": "0.14.0",
  "id": "SAFOR-CANONICAL-AGENT-JOB-CONTRACT",
  "purpose": "Define one immutable, self-contained, agent-bound job with HUMAN-GO activation, pinned inputs, explicit product and response write scopes, five typed response contracts and minimal chat communication.",
  "authority": {
    "authoritativeArtifact": "agents/{agentId}/inbox/{jobId}.json",
    "humanProjection": "agents/{agentId}/inbox/{jobId}.md",
    "masterLifecycle": "master/jobs/{jobId}.json",
    "rule": "JSON is authoritative; the Markdown projection cannot expand scope, rights, role, skills or outputs."
  },
  "creationProtocol": [
    "DERIVE_FROM_APPROVED_ATOMIC_WORK_ITEM",
    "ALLOCATE_NEW_UUIDV7_JOB_ID",
    "BIND_AGENT_IDENTITY_REVISION_AND_DISPLAY_NAME",
    "BIND_DOMAIN_FACTORY_AND_OPERATING_MODEL_CONTEXT",
    "BIND_EXPLICIT_ROLE_AND_VERSIONED_SKILLS",
    "PIN_ALL_INPUTS",
    "ALLOCATE_DEDICATED_PRODUCT_BRANCH_WHEN_MUTATING",
    "DECLARE_SEPARATE_PRODUCT_AND_RESPONSE_WRITE_SCOPES",
    "RESOLVE_PINNED_AUTHORITY_BASIS_RECORD",
    "REQUIRE_AUTHORITY_BASIS_ACTIVE",
    "REQUIRE_AUTHORITY_BASIS_COVERS_JOB_REPOSITORIES_BRANCHES_PATHS_AND_HUMAN_GO",
    "VERIFY_ACTUAL_PROVIDER_RIGHTS_SEPARATELY_FROM_MANDATE_COVERAGE",
    "BIND_HUMAN_GO_EVIDENCE_SCHEMA_TEMPLATE_AND_WRITE_TARGET",
    "BIND_AGENT_STATE_SCHEMA_CLAIM_AND_RESULT_SUBMITTED_TEMPLATES",
    "BIND_SETTLED_AGENT_REARM_STATE_TEMPLATE",
    "REQUIRE_PRE_CAS_AND_POST_READBACK_AGENT_STATE_SCHEMA_VALIDATION",
    "REQUIRE_PRE_WRITE_AND_POST_READBACK_RESPONSE_SCHEMA_VALIDATION",
    "BIND_ALL_FIVE_RESPONSE_TEMPLATES",
    "BIND_MINIMAL_AGENT_CHAT_CONTRACT",
    "DECLARE_VERIFICATION_REVIEW_AND_ACCEPTANCE",
    "RENDER_AND_READ_BACK_JSON_AND_MARKDOWN",
    "PUBLISH_AS_WAITING_HUMAN_GO"
  ],
  "activation": {
    "normalChatAgentMode": "HUMAN_GO_REQUIRED",
    "preGoLifecycle": "WAITING_HUMAN_GO",
    "claimRequiresGoEvidence": true,
    "jobPromptTransportRequired": false,
    "automaticChatActivationForbidden": true,
    "claimStateTarget": "agents/{agentId}/state.json",
    "claimAuthority": "AGENT_STATE_PROVIDER_CAS_READBACK",
    "masterJobStateAccessDuringClaim": "READ_ONLY",
    "humanGoEvidenceSchema": "schemas/human-go-evidence.schema.json",
    "humanGoEvidenceTemplate": "templates/human-go-evidence.template.json",
    "agentStateSchema": "schemas/agent-state.schema.json",
    "claimStateTemplate": "templates/agent-state-claim.template.json",
    "resultSubmittedStateTemplate": "templates/agent-state-result-submitted.template.json",
    "goEvidencePersistenceRequiredBeforeClaim": true,
    "goEvidenceProviderReadbackRequired": true,
    "preCasSchemaValidationRequired": true,
    "postReadbackSchemaValidationRequired": true,
    "freeformClaimStateConstructionForbidden": true,
    "settledRearmStateTemplate": "templates/agent-state-settled-rearm.template.json",
    "freeformSettledRearmStateConstructionForbidden": true
  },
  "writeSeparation": {
    "productArtifacts": "WORK_REPOSITORY on dedicated branch and allowed paths",
    "responses": "CONTROL_REPOSITORY on explicit response paths",
    "onePermissionNeverImpliesTheOther": true,
    "agentMayWriteMasterLifecycle": false,
    "agentClaimState": "Agent may CAS only its own agents/{agentId}/state.json using the exact prebound claim target.",
    "masterLifecycleReconciliation": "MASTER reconciles master/jobs/{jobId}.json from verified claim/response evidence and retains sole verification/acceptance authority.",
    "schemaValidationDoesNotGrantProviderRights": true
  },
  "responses": {
    "requiredTypes": [
      "JOB_RESULT",
      "JOB_ERROR",
      "CLARIFICATION_REQUEST",
      "CAPABILITY_MISMATCH",
      "IMPROVEMENT_PROPOSAL"
    ],
    "schema": "schemas/agent-response.schema.json",
    "masterResolution": "schemas/agent-response-resolution.schema.json",
    "responseIndex": "schemas/agent-response-index.schema.json",
    "templateBoundPerType": true,
    "preWriteSchemaValidationRequired": true,
    "providerReadbackRequired": true,
    "postReadbackSchemaValidationRequired": true,
    "freeformResponseEnvelopeForbidden": true,
    "submittedChatStatusRequiresValidatedReadback": true
  },
  "immutability": {
    "afterPublication": true,
    "scopeChange": "SUPERSEDING_JOB_REQUIRED",
    "roleOrSkillChange": "NEW_JOB_REQUIRED",
    "authorizationExpansion": "NEW_HUMAN_AUTHORITY_AND_NEW_JOB_REQUIRED",
    "rework": "NEW_JOB_ID_WITH_SUPERSEDES_AND_CONFLICT_REF",
    "historicalJobIdReuseForbidden": true,
    "persistenceTemplateBindingsImmutableAfterPublication": true
  },
  "lifecycleSeparation": [
    "WAITING_HUMAN_GO",
    "GO_OBSERVED",
    "CLAIMED",
    "RUNNING",
    "RESPONSE_SUBMITTED",
    "VERIFIED",
    "ACCEPTED",
    "INTEGRATED"
  ],
  "authorityCoverage": {
    "requiredBeforePublication": true,
    "authorityBasisSource": "JOB.authorization.authorityBasis",
    "provenanceMandateRefMustMatchAuthorityBasisPointer": true,
    "activeStatusRequired": true,
    "requiredBindings": [
      "projectId",
      "agentId",
      "allowedControlBranch",
      "allowedProductRepository",
      "allowedProductBranch_or_allowedProductBranches",
      "allowedProductPaths",
      "humanGoRequired",
      "humanOnlyActivation",
      "masterMayActivateAgent",
      "mergeAllowed",
      "deployAllowed"
    ],
    "coverageChecks": [
      "PROJECT_MATCH",
      "AGENT_MATCH",
      "CONTROL_BRANCH_COVERS_ALL_CONTROL_WRITES",
      "PRODUCT_REPOSITORY_MATCH",
      "PRODUCT_BRANCH_COVERS_JOB_WORKSPACE_PERMISSION_AND_OUTPUT_TARGET",
      "PRODUCT_PATHS_COVER_JOB_PERMISSION_WORKSPACE_AND_OUTPUT_TARGET",
      "HUMAN_GO_REQUIRED",
      "HUMAN_ONLY_ACTIVATION_REQUIRED",
      "MASTER_AGENT_ACTIVATION_FORBIDDEN",
      "MERGE_FORBIDDEN",
      "DEPLOY_FORBIDDEN"
    ],
    "providerRightsAreSeparateFromMandateCoverage": true,
    "onCoverageFailure": "DO_NOT_PUBLISH_OR_DISPATCH_JOB",
    "reworkBranchChangeRequiresCoveringSupersedingAuthorityIfPriorMandateIsExactBranchOnly": true
  }
}
