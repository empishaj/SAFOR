{
  "format": "SAFOR_INITIALIZATION_MODEL",
  "schemaVersion": "0.12.0",
  "id": "SAFOR-GUIDED-INITIALIZATION",
  "purpose": "Resolve SAFOR operation mode before any mutating work, then follow mode-specific initialization: Framework/schema DESIGN, isolated VALIDATION, or HUMAN project EXECUTION.",
  "entryBehavior": {
    "autoStartAfterBootstrapLoad": true,
    "firstHumanSurface": "MODE_DEPENDENT",
    "noProjectWorkBeforeComplete": true,
    "completionPredicate": "OPERATION_MODE_RESOLVED_AND_MODE_SPECIFIC_CONTEXT_VERIFIED"
  },
  "sequence": [
    {
      "id": "INIT-00",
      "operation": "VERIFY_EMBEDDED_MODULE_RECOVERY_BASELINE",
      "title": "SAFOR Runtime prüfen",
      "requiresProvider": false,
      "passOutcome": "MODULE_RECOVERY_BASELINE_VERIFIED",
      "failOutcome": "STOP",
      "checks": [
        "EMBEDDED_MODULE_KEYS_MATCH_RECOVERY_PROFILE_KEYS_EXACTLY",
        "ONE_UNIQUE_PROFILE_PER_MODULE",
        "MODULE_AND_INTEGRITY_MANIFEST_PROFILE_IDS_MATCH",
        "SELF_HEALING_CONTROL_MODULES_PRESENT_AND_STRUCTURALLY_VALID",
        "REFERENCE_RESOLUTION_TARGETS_EXIST",
        "KERNEL_SCHEMA_AND_BUNDLE_VERSIONS_AGREE"
      ],
      "selfHealingRef": "module-self-healing-model.json"
    },
    {
      "id": "INIT-00A",
      "operation": "VERIFY_DETERMINISTIC_CONTROL_BASELINE",
      "title": "Control Kernel prüfen",
      "requiresProvider": false,
      "passOutcome": "DETERMINISTIC_CONTROL_BASELINE_VERIFIED",
      "failOutcome": "STOP",
      "checks": [
        "DETERMINISTIC_CONTROL_MODULES_PRESENT_AND_PINNED",
        "ACCEPTANCE_MODEL_AND_SCHEMAS_PRESENT_AND_PINNED",
        "PACKAGE_DISTRIBUTION_MODEL_PRESENT",
        "ENTITLEMENT_MODEL_PRESENT",
        "WORKSPACE_MODEL_PRESENT",
        "PUBLIC_FRAMEWORK_CONTAINS_NO_PAID_DOMAIN_PACKAGE_CONTENT"
      ],
      "deterministicControlRef": "deterministic-control-model.json"
    },
    {
      "id": "INIT-00B",
      "operation": "VERIFY_OPERATION_MODE_AND_AGENT_RUNTIME_BASELINE",
      "title": "Betriebsmodus und Agent Runtime prüfen",
      "requiresProvider": false,
      "passOutcome": "MODE_RUNTIME_BASELINE_VERIFIED",
      "failOutcome": "STOP",
      "checks": [
        "OPERATION_MODE_MODEL_PRESENT_AND_PINNED",
        "AGENT_RUNTIME_MODEL_PRESENT_AND_PINNED",
        "OPERATION_MODE_BINDING_SCHEMA_PRESENT",
        "AGENT_RUNTIME_BINDING_SCHEMA_PRESENT",
        "HUMAN_DECISION_GATE_FORBIDS_ROUTINE_AGENT_ACTIVATION",
        "AGENT_WORKSPACE_BINDS_RUNTIME_ADAPTER"
      ],
      "operationModeModelRef": "operation-mode-model.json",
      "agentRuntimeModelRef": "agent-runtime-model.json"
    },
    {
      "id": "INIT-00C",
      "operation": "RESOLVE_OPERATION_MODE",
      "title": "Arbeitsmodus bestimmen",
      "requiresProvider": false,
      "modelRef": "operation-mode-model.json",
      "rule": "Derive DESIGN, VALIDATION or EXECUTION from explicit HUMAN intent and target context before any mutating effect. Ask only when materially ambiguous. Never silently downgrade EXECUTION to VALIDATION.",
      "humanDecisionDefault": false,
      "askHumanOnlyWhen": "MODE_CANNOT_BE_DERIVED_SAFELY_FROM_INTENT_AND_TARGET_CONTEXT",
      "outcomes": [
        "DESIGN",
        "VALIDATION",
        "EXECUTION"
      ]
    },
    {
      "id": "INIT-D01",
      "when": "OPERATION_MODE == DESIGN",
      "operation": "BIND_DESIGN_TARGET",
      "title": "SAFOR-Entwicklungsziel binden",
      "rule": "Bind the explicitly intended Framework/schema/package development target. Canonical SAFOR repository is allowed here as a development target because this is not a HUMAN project workspace.",
      "completionOutcome": "DESIGN_CONTEXT_READY"
    },
    {
      "id": "INIT-V01",
      "when": "OPERATION_MODE == VALIDATION",
      "operation": "BIND_ISOLATED_VALIDATION_TARGET",
      "title": "Isolierten Prüfkontext binden",
      "rule": "Validation target must be explicitly isolated/non-production and must not inherit production project authority.",
      "completionOutcome": "VALIDATION_TARGET_BOUND"
    },
    {
      "id": "INIT-V02",
      "when": "OPERATION_MODE == VALIDATION",
      "operation": "BIND_VALIDATION_AGENT_RUNTIME",
      "title": "Test-Runtime prüfen",
      "modelRef": "agent-runtime-model.json",
      "rule": "Manual HUMAN activation is permitted only if the selected validation explicitly tests a MANUAL_TEST_HARNESS. Otherwise derive or bind an automated runtime when available.",
      "completionOutcome": "VALIDATION_RUNTIME_READY"
    },
    {
      "id": "INIT-E00",
      "when": "OPERATION_MODE == EXECUTION",
      "operation": "VERIFY_EXECUTION_AGENT_RUNTIME_POLICY",
      "title": "Agent Runtime für Ausführung prüfen",
      "modelRef": "agent-runtime-model.json",
      "rule": "Do not require an Agent Runtime until AGENT execution is actually needed, but record that EXECUTION permits only HOST_NATIVE_AUTOMATIC or EXTERNAL_AUTOMATION for AGENT dispatch. HUMAN_MANUAL_TEST_ONLY can never become production fallback.",
      "completionOutcome": "EXECUTION_RUNTIME_POLICY_READY"
    },
    {
      "id": "INIT-01",
      "operation": "SELECT_CREATION_TYPE",
      "humanDecision": "CREATION_TYPE_SELECTION",
      "title": "Was möchtest du erstellen?",
      "menu": {
        "type": "SINGLE_SELECT",
        "options": [
          {
            "id": "SOFTWARE_WEBSITE",
            "label": "Software / Website",
            "accessLabel": "Kostenlos"
          },
          {
            "id": "BOOK",
            "label": "Buch",
            "accessLabel": "Lizenz erforderlich"
          }
        ]
      },
      "rule": "Creation type determines required package IDs, not project location and not organizational authority.",
      "when": "OPERATION_MODE == EXECUTION"
    },
    {
      "id": "INIT-02",
      "operation": "RESOLVE_PACKAGE_ACCESS_PROFILE",
      "title": "Arbeitsmodell prüfen",
      "modelRefs": [
        "package-catalog.json",
        "package-distribution-model.json",
        "commercial-entitlement-model.json"
      ],
      "outcomes": [
        "FREE_PUBLIC_RESOLUTION",
        "PAID_PACKAGE_ACCESS_CHECK"
      ],
      "rule": "Never infer paid entitlement from package possession or HUMAN statement.",
      "when": "OPERATION_MODE == EXECUTION"
    },
    {
      "id": "INIT-03",
      "operation": "RESOLVE_REQUIRED_FACTORY_AND_OPERATING_MODEL",
      "title": "Factory und Operating Model laden",
      "rules": [
        "Explicit HUMAN-loaded valid package may be used.",
        "SOFTWARE_WEBSITE may auto-resolve its FREE_PUBLIC Factory/OM from canonical public SAFOR Git.",
        "BOOK may resolve only from HUMAN_LOADED_PACKAGE or ENTITLED_PACKAGE_SOURCE with verified entitlement.",
        "Paid package model content may not be read from the public canonical repository."
      ],
      "failOutcomes": {
        "missingPaidPackage": "PACKAGE_ACCESS_REQUIRED",
        "entitlementUnverified": "PACKAGE_ENTITLEMENT_UNVERIFIED",
        "publicPaidResolutionAttempt": "STOP"
      },
      "when": "OPERATION_MODE == EXECUTION"
    },
    {
      "id": "INIT-04",
      "operation": "VERIFY_PACKAGE_INTEGRITY_AND_ACCESS",
      "title": "Pakete verifizieren",
      "checks": [
        "EXACT_PACKAGE_ID_VERSION",
        "IMMUTABLE_SOURCE_REVISION",
        "BLOB_IDENTITY",
        "KERNEL_COMPATIBILITY",
        "ACCESS_MODE",
        "ENTITLEMENT_WHEN_REQUIRED"
      ],
      "rule": "A package is not bindable until source, integrity and access evidence are proven.",
      "when": "OPERATION_MODE == EXECUTION"
    },
    {
      "id": "INIT-05",
      "operation": "VERIFY_FACTORY_OPERATING_MODEL_COMPATIBILITY",
      "title": "Arbeitsmodell abstimmen",
      "checks": [
        "FACTORY_REQUIRED_CAPABILITIES_COVERED_BY_OPERATING_MODEL",
        "REQUIRED_AUTHORITIES_RESOLVABLE",
        "NO_FACTORY_ROLE_ID_COUPLING",
        "NO_OPERATING_MODEL_FLOW_OWNERSHIP"
      ],
      "failOutcome": "PACKAGE_COMBINATION_INCOMPATIBLE",
      "when": "OPERATION_MODE == EXECUTION"
    },
    {
      "id": "INIT-06",
      "operation": "SELECT_PROJECT_WORKSPACE_TYPE",
      "humanDecision": "PROJECT_WORKSPACE_SELECTION",
      "title": "Wo liegt dein Projekt?",
      "menu": {
        "type": "SINGLE_SELECT",
        "options": [
          {
            "id": "REMOTE_GIT",
            "label": "In meinem Git-Repository"
          },
          {
            "id": "LOCAL_GIT",
            "label": "Lokal auf meinem Rechner"
          }
        ]
      },
      "rule": "Project location is HUMAN-controlled and independent from package source/access.",
      "when": "OPERATION_MODE == EXECUTION"
    },
    {
      "id": "INIT-07R",
      "when": "OPERATION_MODE == EXECUTION AND (PROJECT_WORKSPACE_TYPE == REMOTE_GIT)",
      "operation": "SELECT_REMOTE_PROVIDER",
      "humanDecision": "PROVIDER_SELECTION",
      "title": "Welchen Git-Anbieter nutzt du?",
      "menu": {
        "type": "SINGLE_SELECT",
        "options": [
          {
            "id": "GITHUB",
            "label": "GitHub",
            "providerPackageId": "safor.provider.github"
          },
          {
            "id": "GITLAB",
            "label": "GitLab",
            "providerPackageId": "safor.provider.gitlab"
          }
        ]
      }
    },
    {
      "id": "INIT-08R",
      "when": "OPERATION_MODE == EXECUTION AND (PROJECT_WORKSPACE_TYPE == REMOTE_GIT)",
      "operation": "VERIFY_REMOTE_PROVIDER_ACCESS",
      "requires": [
        "provider.identity.read",
        "provider.namespace.list",
        "provider.repository.list",
        "provider.repository.read",
        "provider.artifact.read",
        "provider.artifact.write",
        "provider.history.read",
        "provider.branch.read",
        "provider.branch.write"
      ],
      "failOutcome": "WAITING_HUMAN_PROVIDER_ACCESS"
    },
    {
      "id": "INIT-09R",
      "when": "OPERATION_MODE == EXECUTION AND (PROJECT_WORKSPACE_TYPE == REMOTE_GIT)",
      "operation": "SELECT_REMOTE_OWNER_AND_PROJECT",
      "humanDecision": "REMOTE_PROJECT_SELECTION",
      "title": "Welches deiner Projekte verwenden wir?",
      "rules": [
        "Project repository must be HUMAN/HUMAN-organization controlled.",
        "Canonical SAFOR repository is forbidden as project repository.",
        "Commercial package source is forbidden as project repository.",
        "Existing or new project is allowed subject to actual provider rights and setup approval."
      ]
    },
    {
      "id": "INIT-10R",
      "when": "OPERATION_MODE == EXECUTION AND (PROJECT_WORKSPACE_TYPE == REMOTE_GIT)",
      "operation": "VERIFY_AND_BIND_REMOTE_CONTROL_WORKSPACE",
      "target": "{selectedOwner}/safor-memory",
      "strategy": "REMOTE_SEPARATE_SAFOR_MEMORY",
      "requires": [
        "provider.repository.read",
        "provider.artifact.read",
        "provider.artifact.write"
      ],
      "failOutcome": "WAITING_HUMAN_CONTROL_WORKSPACE",
      "rule": "Remote safor-memory remains HUMAN-controlled control storage; it is never a project work-artifact repository."
    },
    {
      "id": "INIT-07L",
      "when": "OPERATION_MODE == EXECUTION AND (PROJECT_WORKSPACE_TYPE == LOCAL_GIT)",
      "operation": "VERIFY_LOCAL_HOST_CAPABILITIES",
      "requires": [
        "workspace.local.read",
        "workspace.local.write",
        "workspace.git.repository.read",
        "workspace.git.history.read",
        "workspace.git.branch.read",
        "workspace.git.branch.write",
        "workspace.git.commit.write"
      ],
      "failOutcome": "WAITING_HUMAN_LOCAL_HOST_ACCESS",
      "rule": "Do not claim local capability unless the host actually exposes filesystem and Git operations."
    },
    {
      "id": "INIT-08L",
      "when": "OPERATION_MODE == EXECUTION AND (PROJECT_WORKSPACE_TYPE == LOCAL_GIT)",
      "operation": "SELECT_OR_DEFINE_LOCAL_GIT_PROJECT",
      "humanDecision": "LOCAL_PROJECT_SELECTION",
      "title": "Welchen lokalen Git-Projektordner verwenden wir?",
      "checks": [
        "PATH_HUMAN_SELECTED_OR_APPROVED",
        "GIT_REPOSITORY_PRESENT_OR_SETUP_EXPLICITLY_APPROVED",
        "READ_WRITE_PROVEN",
        "CANONICAL_SAFOR_SOURCE_NOT_TARGET"
      ]
    },
    {
      "id": "INIT-09L",
      "when": "OPERATION_MODE == EXECUTION AND (PROJECT_WORKSPACE_TYPE == LOCAL_GIT)",
      "operation": "BIND_LOCAL_CONTROL_WORKSPACE",
      "strategy": "LOCAL_MASTER_CONTROL_ROOT",
      "target": ".safor/",
      "rule": "The .safor/ root is MASTER-only, Git-tracked and excluded from worker write scopes."
    },
    {
      "id": "INIT-11",
      "operation": "APPROVE_AND_MATERIALIZE_PROJECT",
      "humanDecision": "SETUP_APPROVAL",
      "title": "Projekt starten",
      "rule": "Materialize project/control only in the HUMAN-selected project/control workspaces. Package sources and canonical SAFOR repository remain read-only sources.",
      "completionOutcome": "INITIALIZATION_COMPLETE",
      "when": "OPERATION_MODE == EXECUTION"
    }
  ],
  "packageModelRefs": {
    "registry": "package-registry.json",
    "catalog": "package-catalog.json",
    "distribution": "package-distribution-model.json",
    "entitlement": "commercial-entitlement-model.json"
  },
  "workspaceModelRef": "workspace-model.json",
  "humanDecisionGateModelRef": "human-decision-gate-model.json",
  "humanCognitiveLoadPolicyRef": "interaction-model.json#humanCognitiveLoadPolicy",
  "operationModeModelRef": "operation-mode-model.json",
  "agentRuntimeModelRef": "agent-runtime-model.json",
  "modeSpecificCompletion": {
    "DESIGN": "DESIGN_CONTEXT_READY",
    "VALIDATION": "VALIDATION_TARGET_BOUND_AND_VALIDATION_RUNTIME_READY",
    "EXECUTION": "FRAMEWORK_VERIFIED_AND_PACKAGES_RESOLVED_AND_COMPATIBLE_AND_PROJECT_WORKSPACE_VERIFIED_AND_CONTROL_WORKSPACE_VERIFIED"
  },
  "modeHumanGovernance": {
    "deriveBeforeAsk": true,
    "oneDecisionContextPerTurn": true,
    "missingExecutionAutomationIsNotHumanWorkflow": true,
    "manualActivationVisibleOnlyInExplicitValidationHarness": true,
    "executionToValidationSilentFallbackForbidden": true
  }
}
