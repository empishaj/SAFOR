{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safor.dev/schemas/0.12.0/operation-mode-binding.schema.json",
  "title": "SAFOR Operation Mode Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "bindingRevision",
    "mode",
    "basis",
    "intentRef",
    "target",
    "evidenceRefs"
  ],
  "properties": {
    "format": {
      "const": "SAFOR_OPERATION_MODE_BINDING"
    },
    "schemaVersion": {
      "const": "0.12.0"
    },
    "bindingRevision": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "enum": [
        "DESIGN",
        "VALIDATION",
        "EXECUTION"
      ]
    },
    "basis": {
      "enum": [
        "DERIVED_POLICY",
        "HUMAN_SELECTED"
      ]
    },
    "intentRef": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "targetClass",
            "targetRef",
            "isolated"
          ],
          "properties": {
            "targetClass": {
              "enum": [
                "FRAMEWORK_REPOSITORY",
                "PACKAGE_DEVELOPMENT_WORKSPACE"
              ]
            },
            "targetRef": {
              "type": "string",
              "minLength": 1
            },
            "isolated": {
              "const": false
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "targetClass",
            "targetRef",
            "isolated"
          ],
          "properties": {
            "targetClass": {
              "const": "ISOLATED_TEST_WORKSPACE"
            },
            "targetRef": {
              "type": "string",
              "minLength": 1
            },
            "isolated": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "targetClass",
            "targetRef",
            "isolated"
          ],
          "properties": {
            "targetClass": {
              "const": "HUMAN_PROJECT"
            },
            "targetRef": {
              "type": "string",
              "minLength": 1
            },
            "isolated": {
              "const": false
            }
          }
        }
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "DESIGN"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "properties": {
              "targetClass": {
                "enum": [
                  "FRAMEWORK_REPOSITORY",
                  "PACKAGE_DEVELOPMENT_WORKSPACE"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "VALIDATION"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "properties": {
              "targetClass": {
                "const": "ISOLATED_TEST_WORKSPACE"
              },
              "isolated": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "EXECUTION"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "properties": {
              "targetClass": {
                "const": "HUMAN_PROJECT"
              },
              "isolated": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
