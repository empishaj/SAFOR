{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safor.dev/schemas/0.12.0/agent-job.schema.json",
  "title": "SAFOR Agent Job Contract 0.12.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "identity",
    "lineage",
    "provenance",
    "assignment",
    "roleContract",
    "skills",
    "task",
    "dependencies",
    "inputs",
    "authorization",
    "workspace",
    "runtime",
    "scheduling",
    "outputContract",
    "verificationContract",
    "constraints",
    "humanReadableProjection"
  ],
  "properties": {
    "format": {
      "const": "SAFOR_AGENT_JOB"
    },
    "schemaVersion": {
      "const": "0.12.0"
    },
    "identity": {
      "$ref": "#/$defs/jobIdentity"
    },
    "lineage": {
      "$ref": "#/$defs/lineage"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "assignment": {
      "$ref": "#/$defs/assignment"
    },
    "roleContract": {
      "$ref": "#/$defs/roleContract"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/skill"
      }
    },
    "task": {
      "$ref": "#/$defs/task"
    },
    "dependencies": {
      "$ref": "#/$defs/dependencies"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "authorization": {
      "$ref": "#/$defs/authorization"
    },
    "workspace": {
      "$ref": "#/$defs/workspace"
    },
    "scheduling": {
      "$ref": "#/$defs/scheduling"
    },
    "outputContract": {
      "$ref": "#/$defs/outputContract"
    },
    "verificationContract": {
      "$ref": "#/$defs/verificationContract"
    },
    "constraints": {
      "$ref": "#/$defs/constraints"
    },
    "humanReadableProjection": {
      "$ref": "#/$defs/humanReadableProjection"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    }
  },
  "$defs": {
    "jobIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "jobKey",
        "jobType",
        "contractRevision",
        "immutableAfterDispatch"
      ],
      "properties": {
        "jobId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "jobKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "jobType": {
          "type": "string",
          "minLength": 1
        },
        "contractRevision": {
          "type": "integer",
          "minimum": 1
        },
        "immutableAfterDispatch": {
          "const": true
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "valueStreamId",
        "packageId",
        "packageRevision",
        "packageSequence",
        "workItemId",
        "workItemRevision",
        "parentWorkItemId",
        "rootPackageId",
        "sequence",
        "supersedesJobId"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "valueStreamId": {
          "type": "string",
          "minLength": 1
        },
        "packageId": {
          "type": "string",
          "minLength": 1
        },
        "packageRevision": {
          "type": "integer",
          "minimum": 1
        },
        "packageSequence": {
          "type": "integer",
          "minimum": 1
        },
        "workItemId": {
          "type": "string",
          "minLength": 1
        },
        "workItemRevision": {
          "type": "integer",
          "minimum": 1
        },
        "parentWorkItemId": {
          "type": [
            "string",
            "null"
          ]
        },
        "rootPackageId": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "$ref": "#/$defs/sequence"
        },
        "supersedesJobId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planSequence",
        "dispatchSequence",
        "attempt",
        "reworkCycle"
      ],
      "properties": {
        "planSequence": {
          "type": "integer",
          "minimum": 1
        },
        "dispatchSequence": {
          "type": "integer",
          "minimum": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "reworkCycle": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "createdAt",
        "issuedAt",
        "createdBy",
        "planningRef",
        "executionStateRef",
        "mandateRef"
      ],
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdBy": {
          "$ref": "#/$defs/masterProvenance"
        },
        "planningRef": {
          "type": "string",
          "minLength": 1
        },
        "executionStateRef": {
          "type": "string",
          "minLength": 1
        },
        "mandateRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "masterProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "masterId",
        "masterVersion",
        "masterRunId",
        "masterStateRevision"
      ],
      "properties": {
        "masterId": {
          "type": "string",
          "minLength": 1
        },
        "masterVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
        },
        "masterRunId": {
          "type": "string",
          "minLength": 1
        },
        "masterStateRevision": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentId",
        "agentName",
        "actorKind",
        "identityRevision",
        "identityRef",
        "assignmentMode",
        "assignmentReason"
      ],
      "properties": {
        "agentId": {
          "type": "string",
          "minLength": 1
        },
        "agentName": {
          "type": "string",
          "minLength": 1
        },
        "actorKind": {
          "const": "AGENT"
        },
        "identityRevision": {
          "type": "integer",
          "minimum": 1
        },
        "identityRef": {
          "type": "string",
          "minLength": 1
        },
        "assignmentMode": {
          "const": "EXCLUSIVE"
        },
        "assignmentReason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "roleContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleId",
        "roleName",
        "roleDefinitionRef",
        "roleDefinitionBlobSha",
        "mission",
        "responsibilities",
        "mustNotActAs",
        "decisionRights",
        "authorityExpansionAllowed"
      ],
      "properties": {
        "roleId": {
          "type": "string",
          "minLength": 1
        },
        "roleName": {
          "type": "string",
          "minLength": 1
        },
        "roleDefinitionRef": {
          "type": "string",
          "minLength": 1
        },
        "roleDefinitionBlobSha": {
          "type": "string",
          "minLength": 1
        },
        "mission": {
          "type": "string",
          "minLength": 1
        },
        "responsibilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mustNotActAs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "decisionRights": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "authorityExpansionAllowed": {
          "const": false
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skillId",
        "skillVersion",
        "mandatory",
        "description",
        "executionInstructions",
        "useFor",
        "skillRef",
        "skillBlobSha",
        "requiredLevel"
      ],
      "properties": {
        "skillId": {
          "type": "string",
          "minLength": 1
        },
        "skillVersion": {
          "type": "string",
          "minLength": 1
        },
        "mandatory": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "executionInstructions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "useFor": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "skillRef": {
          "type": "string",
          "minLength": 1
        },
        "skillBlobSha": {
          "type": "string",
          "minLength": 1
        },
        "requiredLevel": {
          "enum": [
            "BASIC",
            "PROFICIENT",
            "EXPERT"
          ]
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "objective",
        "instruction",
        "expectedOutcome",
        "completionDefinition",
        "inScope",
        "outOfScope"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "expectedOutcome": {
          "type": "string",
          "minLength": 1
        },
        "completionDefinition": {
          "type": "string",
          "minLength": 1
        },
        "inScope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outOfScope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredWorkItems",
        "dependencyPredicate"
      ],
      "properties": {
        "requiredWorkItems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          }
        },
        "dependencyPredicate": {
          "const": "ALL_REQUIRED_ACCEPTED"
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workItemId",
        "requiredStatus",
        "acceptanceRef",
        "acceptanceBlobSha"
      ],
      "properties": {
        "workItemId": {
          "type": "string",
          "minLength": 1
        },
        "requiredStatus": {
          "const": "ACCEPTED"
        },
        "acceptanceRef": {
          "type": "string",
          "minLength": 1
        },
        "acceptanceBlobSha": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputId",
        "repository",
        "path",
        "commitSha",
        "blobSha",
        "mode",
        "expectedType",
        "purpose"
      ],
      "properties": {
        "inputId": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "commitSha": {
          "type": "string",
          "minLength": 1
        },
        "blobSha": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "const": "READ_ONLY"
        },
        "expectedType": {
          "type": [
            "string",
            "null"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityBasis",
        "actualProviderRightsMustBeVerified",
        "providerCapabilities",
        "repositoryPermissions",
        "explicitlyForbidden"
      ],
      "properties": {
        "authorityBasis": {
          "$ref": "#/$defs/authorityBasis"
        },
        "actualProviderRightsMustBeVerified": {
          "const": true
        },
        "providerCapabilities": {
          "$ref": "#/$defs/providerCapabilities"
        },
        "repositoryPermissions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/repositoryPermission"
          }
        },
        "explicitlyForbidden": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "authorityBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mandateRef",
        "mandateBlobSha",
        "mandateMustRemainActive"
      ],
      "properties": {
        "mandateRef": {
          "type": "string",
          "minLength": 1
        },
        "mandateBlobSha": {
          "type": "string",
          "minLength": 1
        },
        "mandateMustRemainActive": {
          "const": true
        }
      }
    },
    "providerCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "forbidden"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "repositoryPermission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "read",
        "write",
        "branchCreate",
        "commit",
        "push",
        "changeRequestCreate",
        "merge",
        "deploy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "read": {
          "type": "boolean"
        },
        "write": {
          "$ref": "#/$defs/writePermission"
        },
        "branchCreate": {
          "type": "boolean"
        },
        "commit": {
          "type": "boolean"
        },
        "push": {
          "type": "boolean"
        },
        "changeRequestCreate": {
          "type": "boolean"
        },
        "merge": {
          "type": "boolean"
        },
        "deploy": {
          "type": "boolean"
        }
      }
    },
    "writePermission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "branchOnly",
        "allowedPaths"
      ],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "branchOnly": {
          "type": "boolean"
        },
        "allowedPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceAccessSource",
        "readSet",
        "writeSet",
        "exclusiveKeys",
        "gitWorkspaces"
      ],
      "properties": {
        "resourceAccessSource": {
          "$ref": "#/$defs/resourceAccessSource"
        },
        "readSet": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/readResource"
          }
        },
        "writeSet": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/writeResource"
          }
        },
        "exclusiveKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gitWorkspaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gitWorkspace"
          }
        }
      }
    },
    "resourceAccessSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workItemRef",
        "workItemBlobSha"
      ],
      "properties": {
        "workItemRef": {
          "type": "string",
          "minLength": 1
        },
        "workItemBlobSha": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "readResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "path",
        "immutableRevision"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "immutableRevision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "writeResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "path",
        "conflictDomain"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "conflictDomain": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gitWorkspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "baseCommitSha",
        "jobKey",
        "agentKey",
        "branch",
        "allowedPaths",
        "directDefaultBranchWrite",
        "crossJobBranchWrite",
        "mergeAuthority"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "baseCommitSha": {
          "type": "string",
          "minLength": 1
        },
        "jobKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "agentKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "branch": {
          "type": "string",
          "pattern": "^safor/job/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
        },
        "allowedPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "directDefaultBranchWrite": {
          "const": false
        },
        "crossJobBranchWrite": {
          "const": false
        },
        "mergeAuthority": {
          "const": "MASTER_OR_EXPLICIT_AUTHORITY"
        }
      }
    },
    "scheduling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "dispatchRevision",
        "dispatchState",
        "dispatchWaveRef",
        "resourceLeaseRefs",
        "claimPolicy",
        "claimWindow"
      ],
      "properties": {
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "dispatchRevision": {
          "type": "integer",
          "minimum": 1
        },
        "dispatchState": {
          "const": "READY"
        },
        "dispatchWaveRef": {
          "type": "string",
          "minLength": 1
        },
        "resourceLeaseRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "claimPolicy": {
          "$ref": "#/$defs/claimPolicy"
        },
        "claimWindow": {
          "$ref": "#/$defs/claimWindow"
        }
      }
    },
    "claimPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exclusiveAgentClaim",
        "optimisticConcurrencyRequired"
      ],
      "properties": {
        "exclusiveAgentClaim": {
          "const": true
        },
        "optimisticConcurrencyRequired": {
          "const": true
        }
      }
    },
    "claimWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notBefore",
        "claimBy",
        "onExpired"
      ],
      "properties": {
        "notBefore": {
          "type": "string",
          "format": "date-time"
        },
        "claimBy": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "onExpired": {
          "const": "RECONCILE_WITH_MASTER"
        }
      }
    },
    "outputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machineResult",
        "humanReadableResult",
        "evidenceRoot",
        "auditRoot",
        "requiredOutputs",
        "gitTraceRequired"
      ],
      "properties": {
        "machineResult": {
          "$ref": "#/$defs/resultTarget"
        },
        "humanReadableResult": {
          "$ref": "#/$defs/humanResultTarget"
        },
        "evidenceRoot": {
          "$ref": "#/$defs/rootTarget"
        },
        "auditRoot": {
          "$ref": "#/$defs/rootTarget"
        },
        "requiredOutputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requiredOutput"
          }
        },
        "gitTraceRequired": {
          "type": "boolean"
        }
      }
    },
    "resultTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref",
        "schemaRef",
        "required"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "schemaRef": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "const": true
        }
      }
    },
    "humanResultTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref",
        "format",
        "required",
        "requiredSections"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "const": "MARKDOWN"
        },
        "required": {
          "const": true
        },
        "requiredSections": {
          "$ref": "#/$defs/resultSections"
        }
      }
    },
    "resultSections": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "OBJECTIVE",
          "WORK_PERFORMED",
          "ARTIFACTS_CHANGED",
          "GIT_TRACE",
          "VERIFICATION",
          "RESULT",
          "RISKS_AND_LIMITS",
          "OPEN_ITEMS"
        ]
      }
    },
    "rootTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requiredOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outputId",
        "type",
        "required"
      ],
      "properties": {
        "outputId": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "verificationContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptanceCriteria",
        "evidenceRequirements",
        "review",
        "selfAcceptanceAllowed",
        "acceptanceAuthority"
      ],
      "properties": {
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "evidenceRequirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "selfAcceptanceAllowed": {
          "const": false
        },
        "acceptanceAuthority": {
          "const": "MASTER"
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterionId",
        "statement",
        "required"
      ],
      "properties": {
        "criterionId": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "reviewCapability",
        "reviewerAgentId",
        "performerMustDifferFromReviewer"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "reviewCapability": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewerAgentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "performerMustDifferFromReviewer": {
          "type": "boolean"
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mayExpandScope",
        "mayModifyMasterState",
        "mayModifyJobContract",
        "mayModifyAgentIdentity",
        "mayModifyInboxIndex",
        "mayModifySchedulerState",
        "mayModifyResourceLease",
        "mayChangeRole",
        "mayDelegate",
        "mayCreateCommits",
        "mayCreateChangeRequest",
        "mayMerge",
        "mayDeploy",
        "maximumMutationAttempts",
        "stopImmediatelyOn"
      ],
      "properties": {
        "mayExpandScope": {
          "const": false
        },
        "mayModifyMasterState": {
          "const": false
        },
        "mayModifyJobContract": {
          "const": false
        },
        "mayModifyAgentIdentity": {
          "const": false
        },
        "mayModifyInboxIndex": {
          "const": false
        },
        "mayModifySchedulerState": {
          "const": false
        },
        "mayModifyResourceLease": {
          "const": false
        },
        "mayChangeRole": {
          "const": false
        },
        "mayDelegate": {
          "const": false
        },
        "mayCreateCommits": {
          "type": "boolean"
        },
        "mayCreateChangeRequest": {
          "type": "boolean"
        },
        "mayMerge": {
          "type": "boolean"
        },
        "mayDeploy": {
          "type": "boolean"
        },
        "maximumMutationAttempts": {
          "type": "integer",
          "minimum": 0
        },
        "stopImmediatelyOn": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "humanReadableProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref",
        "format",
        "blobSha",
        "authoritative",
        "generatedFromJson",
        "requiredSections",
        "readbackRequiredBeforeReady"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "const": "MARKDOWN"
        },
        "blobSha": {
          "type": "string",
          "minLength": 1
        },
        "authoritative": {
          "const": false
        },
        "generatedFromJson": {
          "const": true
        },
        "requiredSections": {
          "$ref": "#/$defs/jobProjectionSections"
        },
        "readbackRequiredBeforeReady": {
          "const": true
        }
      }
    },
    "jobProjectionSections": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "uniqueItems": true,
      "items": {
        "enum": [
          "JOB_IDENTITY",
          "PACKAGE_AND_SEQUENCE",
          "MASTER_PROVENANCE",
          "ASSIGNMENT",
          "ROLE",
          "SKILLS",
          "TASK",
          "DEPENDENCIES_AND_INPUTS",
          "AUTHORIZATION",
          "WORKSPACE_AND_GIT",
          "OPERATION_MODE_AND_AGENT_RUNTIME",
          "SCHEDULING",
          "EXPECTED_OUTPUTS_AND_RETURN_PATHS",
          "VERIFICATION_AND_REVIEW",
          "CONSTRAINTS_AND_STOP_CONDITIONS"
        ]
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationMode",
        "operationModeRef",
        "agentRuntimeBindingRef",
        "adapterId",
        "activationCapability",
        "activationResponsibility",
        "capabilityEvidenceRefs",
        "jobPromptTransportForbidden",
        "runtimeBindingCannotGrantAuthority"
      ],
      "properties": {
        "operationMode": {
          "enum": [
            "DESIGN",
            "VALIDATION",
            "EXECUTION"
          ]
        },
        "operationModeRef": {
          "type": "string",
          "minLength": 1
        },
        "agentRuntimeBindingRef": {
          "type": "string",
          "minLength": 1
        },
        "adapterId": {
          "type": "string",
          "minLength": 1
        },
        "activationCapability": {
          "enum": [
            "HOST_NATIVE_AUTOMATIC",
            "EXTERNAL_AUTOMATION",
            "HUMAN_MANUAL_TEST_ONLY",
            "UNAVAILABLE"
          ]
        },
        "activationResponsibility": {
          "enum": [
            "SYSTEM_RUNTIME",
            "HUMAN_TEST_HARNESS"
          ]
        },
        "capabilityEvidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "jobPromptTransportForbidden": {
          "const": true
        },
        "runtimeBindingCannotGrantAuthority": {
          "const": true
        },
        "productionEvidenceEligible": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operationMode": {
                "const": "EXECUTION"
              }
            }
          },
          "then": {
            "required": [
              "productionEvidenceEligible"
            ],
            "properties": {
              "activationCapability": {
                "enum": [
                  "HOST_NATIVE_AUTOMATIC",
                  "EXTERNAL_AUTOMATION"
                ]
              },
              "activationResponsibility": {
                "const": "SYSTEM_RUNTIME"
              },
              "productionEvidenceEligible": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operationMode": {
                "const": "VALIDATION"
              },
              "activationCapability": {
                "const": "HUMAN_MANUAL_TEST_ONLY"
              }
            }
          },
          "then": {
            "required": [
              "productionEvidenceEligible"
            ],
            "properties": {
              "activationResponsibility": {
                "const": "HUMAN_TEST_HARNESS"
              },
              "productionEvidenceEligible": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operationMode": {
                "enum": [
                  "DESIGN",
                  "VALIDATION"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "productionEvidenceEligible": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
