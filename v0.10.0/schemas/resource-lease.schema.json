{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:safor:resource-lease:0.10.0",
  "title": "SAFOR Multi-Agent Resource Lease 0.10.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "projectId",
    "leaseId",
    "revision",
    "status",
    "dispatchWaveRef",
    "jobId",
    "agentId",
    "agentSlot",
    "writeConflictDomains",
    "exclusiveKeys",
    "jobBranches",
    "acquiredAt",
    "expiresAt",
    "releaseEvidenceRefs",
    "updatedAt"
  ],
  "properties": {
    "format": {
      "const": "SAFOR_RESOURCE_LEASE"
    },
    "schemaVersion": {
      "const": "0.10.0"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "leaseId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "RESERVED",
        "ACTIVE",
        "RELEASE_PENDING",
        "RELEASED",
        "RECONCILE_REQUIRED"
      ]
    },
    "jobId": {
      "type": "string",
      "minLength": 1
    },
    "agentId": {
      "type": "string",
      "minLength": 1
    },
    "agentSlot": {
      "type": "integer",
      "minimum": 1
    },
    "writeConflictDomains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exclusiveKeys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "jobBranches": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acquiredAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "releaseEvidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "dispatchWaveRef": {
      "type": "string",
      "minLength": 1
    }
  }
}
