{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:safor:interaction-menu:0.10.0",
  "title": "SAFOR Interaction Menu 0.10.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "menuId",
    "context",
    "presentation",
    "items"
  ],
  "properties": {
    "format": {
      "const": "SAFOR_INTERACTION_MENU"
    },
    "schemaVersion": {
      "const": "0.10.0"
    },
    "menuId": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "projectTitle",
        "mode",
        "status",
        "headline",
        "summary",
        "phase",
        "cognitiveLoadTarget",
        "interactionReason",
        "decisionRequired",
        "technicalDetailExposure",
        "decisionGateOutcome",
        "heuristicLoadEstimate",
        "reusedDecisionRef"
      ],
      "properties": {
        "projectId": {
          "type": "string"
        },
        "projectTitle": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 90
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "progressLabel": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "currentWorkLabel": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "phase": {
          "enum": [
            "BOOTSTRAP",
            "DISCOVERY",
            "PLANNING",
            "SCHEDULING",
            "AGENT_COORDINATION",
            "EXECUTION",
            "RECOVERY",
            "OUTCOME",
            "CLOSING"
          ]
        },
        "cognitiveLoadTarget": {
          "enum": [
            "VERY_LOW",
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "interactionReason": {
          "anyOf": [
            {
              "enum": [
                "NON_DERIVABLE_HUMAN_INTENT_OR_CONTEXT",
                "HUMAN_CONTROLLED_TARGET_SELECTION",
                "MATERIAL_ALTERNATIVE_CHOICE",
                "SCOPE_CHANGE_REQUIRED",
                "NEW_OR_EXPANDED_AUTHORITY_REQUIRED",
                "MATERIAL_RISK_ACCEPTANCE_REQUIRED",
                "IRREVERSIBLE_ACTION_REQUIRED",
                "BUSINESS_OR_PRODUCT_DECISION_REQUIRED",
                "GOAL_CONFLICT_REQUIRES_PRIORITY",
                "RECOVERY_CANNOT_PROCEED_SAFELY",
                "BUSINESS_OUTCOME_JUDGMENT_REQUIRED",
                "GOVERNANCE_OR_IDENTITY_APPROVAL_REQUIRED"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "decisionRequired": {
          "type": "boolean"
        },
        "technicalDetailExposure": {
          "enum": [
            "SUMMARY",
            "DETAILS_REQUIRED"
          ]
        },
        "decisionGateOutcome": {
          "enum": [
            "ALLOW_ASK",
            "SUPPRESS_DERIVABLE",
            "REUSE_EXISTING_DECISION",
            "NOT_APPLICABLE"
          ]
        },
        "heuristicLoadEstimate": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "reusedDecisionRef": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferredSurface",
        "fallbackSurface",
        "visualProfile"
      ],
      "properties": {
        "preferredSurface": {
          "enum": [
            "NATIVE_ACTIONS",
            "NATIVE_SINGLE_SELECT",
            "NATIVE_MULTI_SELECT",
            "NATIVE_RICH_CARDS",
            "NATIVE_MARKDOWN"
          ]
        },
        "fallbackSurface": {
          "const": "NATIVE_MARKDOWN"
        },
        "visualProfile": {
          "const": "SAFOR_CHAT_NATIVE"
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "intent",
        "kind",
        "enabled",
        "requiresConfirmation",
        "visibilityRule"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 42
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "PRIMARY",
            "SECONDARY",
            "UTILITY",
            "DANGER"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "requiresConfirmation": {
          "type": "boolean"
        },
        "visibilityRule": {
          "type": "string",
          "minLength": 1
        },
        "badge": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 24
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "context": {
            "properties": {
              "decisionRequired": {
                "const": true
              }
            }
          }
        },
        "required": [
          "context"
        ]
      },
      "then": {
        "properties": {
          "context": {
            "properties": {
              "interactionReason": {
                "enum": [
                  "NON_DERIVABLE_HUMAN_INTENT_OR_CONTEXT",
                  "HUMAN_CONTROLLED_TARGET_SELECTION",
                  "MATERIAL_ALTERNATIVE_CHOICE",
                  "SCOPE_CHANGE_REQUIRED",
                  "NEW_OR_EXPANDED_AUTHORITY_REQUIRED",
                  "MATERIAL_RISK_ACCEPTANCE_REQUIRED",
                  "IRREVERSIBLE_ACTION_REQUIRED",
                  "BUSINESS_OR_PRODUCT_DECISION_REQUIRED",
                  "GOAL_CONFLICT_REQUIRES_PRIORITY",
                  "RECOVERY_CANNOT_PROCEED_SAFELY",
                  "BUSINESS_OUTCOME_JUDGMENT_REQUIRED",
                  "GOVERNANCE_OR_IDENTITY_APPROVAL_REQUIRED"
                ]
              },
              "decisionGateOutcome": {
                "const": "ALLOW_ASK"
              }
            }
          }
        }
      }
    }
  ]
}
