{
  "kind": "SAFOR_REPOSITORY_BOUNDARY_POLICY",
  "version": "0.4.0",
  "policyId": "SAFOR-REPO-BOUNDARY-V2",
  "denyByDefault": true,
  "principles": {
    "controlPlaneSeparatedFromWorkArtifacts": true,
    "providerNeutral": true,
    "projectScopedControl": true,
    "workerMayNotMutateControlStateByDefault": true,
    "packagesAreReadOnlyAfterProjectPinning": true,
    "actualProviderRightsOverrideDeclaredIntent": true
  },
  "repositoryClasses": {
    "CONTROL_REPOSITORY": {
      "purpose": "Persist SAFOR project bindings, control/value-stream/execution states, decisions, evidence, package snapshots and audit records.",
      "allowedRoots": [
        "projects/",
        "factory/"
      ],
      "forbiddenContentClasses": [
        "DOMAIN_EXECUTABLE_ARTIFACT"
      ],
      "requiredName": "safor-memory"
    },
    "WORK_REPOSITORY": {
      "purpose": "Persist domain work artifacts such as source code, manuscripts, research outputs, designs or other factory-defined deliverables.",
      "forbiddenPrefixes": [
        "factory/",
        "safor-master/",
        "control-plane/",
        "projects/",
        "agents/",
        "contracts/",
        ".saf/"
      ],
      "forbiddenNames": [
        "SAFOR-MASTER.json",
        "master-state.json",
        "launch-prompt.md",
        "work-contract.json"
      ]
    },
    "FACTORY_RUNTIME_CODE_REPOSITORY": {
      "purpose": "Optional dedicated implementation repository for executable SAFOR runtime/adapters.",
      "status": "UNBOUND_BY_DEFAULT"
    }
  },
  "projectControlLayout": {
    "root": "projects/{projectSlug}/",
    "permittedPrefixes": [
      "packages/",
      "state/",
      "decisions/",
      "evidence/",
      "artifacts/",
      "work-items/",
      "agents/",
      "audit/"
    ],
    "requiredFiles": [
      "project.json",
      "bindings.json",
      "state/control.json",
      "state/value-stream.json",
      "state/execution.json"
    ]
  },
  "reconciliation": {
    "readCurrentProviderRevisionBeforeWrite": true,
    "compareExpectedRevision": true,
    "requireProviderReadback": true,
    "unknownMutationOutcome": "RECONCILE_REQUIRED",
    "blockOnUnexpectedHistoryRewrite": true
  },
  "note": "Domain work artifact classes are defined by the bound FACTORY package. This policy intentionally contains no software-specific source/test/config taxonomy.",
  "selfHealingSafety": {
    "allowed": "Only verified, bounded, non-destructive repairs within existing authorization.",
    "forbidden": [
      "force_push",
      "history_rewrite",
      "repository_delete",
      "authoritative_state_delete_without_verified_restore",
      "gate_bypass",
      "review_bypass",
      "mandate_expansion",
      "invented_evidence"
    ],
    "requireReadbackAfterRepair": true,
    "requireReconciliationBeforeRetryOnUnknownEffect": true
  },
  "controlRepositoryRequirement": {
    "mandatory": true,
    "exactName": "safor-memory",
    "locationPattern": "{selectedOwner}/safor-memory",
    "mustPreExist": true,
    "autoCreate": false,
    "visibility": "PRIVATE_RECOMMENDED_AND_POLICY_COMPLIANT",
    "accessRequired": [
      "READ",
      "WRITE"
    ],
    "onMissingOrInsufficientAccess": "STOP",
    "rule": "SAFOR may not initialize, select a project, bind packages or execute work unless `{selectedOwner}/safor-memory` exists and read/write access is proven."
  }
}
