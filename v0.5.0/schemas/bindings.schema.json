{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:safor:bindings:0.5.0",
  "title": "SAFOR Project Bindings 0.5.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "revision",
    "kernel",
    "operatingModel",
    "factory",
    "memoryProvider",
    "workProviderAdapters",
    "actorAssignments"
  ],
  "properties": {
    "format": {
      "const": "SAFOR_PROJECT_BINDINGS"
    },
    "schemaVersion": {
      "const": "0.5.0"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "kernel": {
      "$ref": "#/$defs/binding"
    },
    "operatingModel": {
      "$ref": "#/$defs/binding"
    },
    "factory": {
      "$ref": "#/$defs/binding"
    },
    "memoryProvider": {
      "$ref": "#/$defs/binding"
    },
    "workProviderAdapters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "actorAssignments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actor"
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId",
        "version",
        "sourceRef",
        "snapshotRef"
      ],
      "properties": {
        "packageId": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "sourceRef": {
          "type": "string"
        },
        "snapshotRef": {
          "type": "string"
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleId",
        "actorId",
        "actorKind"
      ],
      "properties": {
        "roleId": {
          "type": "string"
        },
        "actorId": {
          "type": "string"
        },
        "actorKind": {
          "enum": [
            "HUMAN",
            "AGENT",
            "SERVICE"
          ]
        }
      }
    }
  }
}
