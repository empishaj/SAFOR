{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:safor:work-item:0.8.0",
  "title": "SAFOR Domain-Agnostic Work Item 0.8.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "valueStreamId",
    "type",
    "objective",
    "status",
    "requiredCapabilities",
    "authorityRequirements",
    "inputs",
    "expectedOutputs",
    "acceptanceCriteria",
    "dependencies",
    "execution",
    "assignment",
    "review",
    "evidenceRequirements",
    "valueContribution"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "valueStreamId": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "description": "Factory-defined work-item type. The MASTER kernel must not enumerate domain types."
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PLANNED",
        "READY",
        "ASSIGNED",
        "IN_PROGRESS",
        "HANDOFF_READY",
        "IN_REVIEW",
        "CHANGES_REQUIRED",
        "ACCEPTED",
        "BLOCKED",
        "CANCELED"
      ]
    },
    "requiredCapabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "authorityRequirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "expectedOutputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performerActorId",
        "reviewerActorIds"
      ],
      "properties": {
        "performerActorId": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewerActorIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "independencePolicy",
        "status",
        "evidenceRefs"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "independencePolicy": {
          "type": "string"
        },
        "status": {
          "enum": [
            "NOT_REQUIRED",
            "NOT_STARTED",
            "PENDING",
            "CHANGES_REQUIRED",
            "APPROVED"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidenceRequirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "valueContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidenceRefs",
        "outcomeRefs"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_DELIVERED",
            "DELIVERED_CONTRIBUTION"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outcomeRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "parentWorkItemId",
        "childWorkItemIds",
        "joinPolicy",
        "parallelizationDecision",
        "priority",
        "readySince",
        "resourceAccess",
        "integrationRequired",
        "integrationWorkItemRef"
      ],
      "properties": {
        "unit": {
          "enum": [
            "ATOMIC",
            "COMPOSITE"
          ]
        },
        "parentWorkItemId": {
          "type": [
            "string",
            "null"
          ]
        },
        "childWorkItemIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "joinPolicy": {
          "enum": [
            "NONE",
            "ALL_CHILDREN_ACCEPTED"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "readySince": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "resourceAccess": {
          "$ref": "#/$defs/resourceAccess"
        },
        "integrationRequired": {
          "type": "boolean"
        },
        "integrationWorkItemRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "parallelizationDecision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classification",
            "rationale",
            "evidenceRefs"
          ],
          "properties": {
            "classification": {
              "enum": [
                "PARALLEL_CANDIDATE",
                "SERIAL_ONLY",
                "COMPOSITE_CONTAINER"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "evidenceRefs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "expectedType": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "resourceAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readSet",
        "writeSet",
        "exclusiveKeys"
      ],
      "properties": {
        "readSet": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/readResource"
          }
        },
        "writeSet": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/writeResource"
          }
        },
        "exclusiveKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "readResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "path",
        "immutableRevision"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "immutableRevision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "writeResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "path",
        "conflictDomain"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "conflictDomain": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "unit": {
                "const": "ATOMIC"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "childWorkItemIds": {
                "maxItems": 0
              },
              "joinPolicy": {
                "const": "NONE"
              },
              "parallelizationDecision": {
                "properties": {
                  "classification": {
                    "enum": [
                      "PARALLEL_CANDIDATE",
                      "SERIAL_ONLY"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "unit": {
                "const": "COMPOSITE"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "childWorkItemIds": {
                "minItems": 1
              },
              "joinPolicy": {
                "const": "ALL_CHILDREN_ACCEPTED"
              },
              "parallelizationDecision": {
                "properties": {
                  "classification": {
                    "const": "COMPOSITE_CONTAINER"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
