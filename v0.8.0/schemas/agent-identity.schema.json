{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:safor:agent-identity:0.8.0",
  "title": "SAFOR Agent Identity 0.8.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "projectId",
    "agentId",
    "agentName",
    "agentKind",
    "masterId",
    "controlRepository",
    "workspaceRoot",
    "identityRevision",
    "status",
    "registeredAt",
    "initializedBy",
    "roleIds",
    "capabilityIds",
    "activationContract"
  ],
  "properties": {
    "format": {
      "const": "SAFOR_AGENT_IDENTITY"
    },
    "schemaVersion": {
      "const": "0.8.0"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "agentId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "agentName": {
      "type": "string",
      "minLength": 1
    },
    "agentKind": {
      "enum": [
        "CHAT_AGENT",
        "SERVICE_AGENT"
      ]
    },
    "masterId": {
      "type": "string",
      "minLength": 1
    },
    "controlRepository": {
      "type": "string",
      "minLength": 1
    },
    "workspaceRoot": {
      "type": "string",
      "minLength": 1
    },
    "identityRevision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "ACTIVE",
        "PAUSED",
        "REVOKED"
      ]
    },
    "registeredAt": {
      "type": "string",
      "format": "date-time"
    },
    "initializedBy": {
      "type": "string",
      "minLength": 1
    },
    "roleIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "capabilityIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "activationContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activationMode",
        "initialBootstrapFields",
        "onActivation",
        "jobPromptTransportRequired"
      ],
      "properties": {
        "activationMode": {
          "const": "EXTERNAL_TRIGGER_REQUIRED"
        },
        "initialBootstrapFields": {
          "type": "array",
          "items": {
            "enum": [
              "CONTROL_REPOSITORY",
              "PROJECT_ID",
              "AGENT_ID"
            ]
          },
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true
        },
        "onActivation": {
          "type": "array",
          "minItems": 7,
          "items": {
            "enum": [
              "LOAD_IDENTITY",
              "LOAD_AGENT_STATE",
              "LOAD_INBOX_INDEX",
              "SELECT_DISCOVERABLE_JOB",
              "READ_JOB_CONTRACT",
              "READ_MASTER_JOB_STATE",
              "VERIFY_ELIGIBLE_JOB",
              "CLAIM_WITH_OPTIMISTIC_CONCURRENCY",
              "EXECUTE_CLAIMED_JOB",
              "SUBMIT_RESULT"
            ]
          }
        },
        "jobPromptTransportRequired": {
          "const": false
        }
      }
    }
  }
}
