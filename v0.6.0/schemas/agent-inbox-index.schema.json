{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:safor:agent-inbox-index:0.6.0",
  "title": "SAFOR Agent Inbox Index 0.6.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "projectId",
    "agentId",
    "identityRevision",
    "revision",
    "authoritativeLifecycle",
    "sourceOfTruth",
    "verificationRule",
    "entries",
    "updatedAt"
  ],
  "properties": {
    "format": {
      "const": "SAFOR_AGENT_INBOX_INDEX"
    },
    "schemaVersion": {
      "const": "0.6.0"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "agentId": {
      "type": "string",
      "minLength": 1
    },
    "identityRevision": {
      "type": "integer",
      "minimum": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "authoritativeLifecycle": {
      "const": false
    },
    "sourceOfTruth": {
      "const": "master/jobs/{jobId}.json"
    },
    "verificationRule": {
      "const": "READ_MASTER_JOB_STATE_BEFORE_CLAIM"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "jobRef",
        "jobBlobSha",
        "masterJobStateRef",
        "dispatchRevision",
        "discoverabilityState",
        "queuedAt"
      ],
      "properties": {
        "jobId": {
          "type": "string",
          "minLength": 1
        },
        "jobRef": {
          "type": "string",
          "minLength": 1
        },
        "jobBlobSha": {
          "type": "string",
          "minLength": 1
        },
        "masterJobStateRef": {
          "type": "string",
          "minLength": 1
        },
        "dispatchRevision": {
          "type": "integer",
          "minimum": 1
        },
        "discoverabilityState": {
          "enum": [
            "AVAILABLE",
            "REWORK_AVAILABLE",
            "WITHDRAWN"
          ]
        },
        "queuedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
