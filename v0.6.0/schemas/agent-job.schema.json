{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:safor:agent-job:0.6.0",
  "title": "SAFOR Agent Job Contract 0.6.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "jobId",
    "projectId",
    "assignedAgentId",
    "assignedIdentityRef",
    "assignedIdentityRevision",
    "issuedBy",
    "issuedAt",
    "dispatchRevision",
    "dispatchState",
    "workItemRef",
    "executionContractRef",
    "mandateRef",
    "scope",
    "inputs",
    "requiredOutputs",
    "evidenceRequirements",
    "constraints",
    "resultTarget"
  ],
  "properties": {
    "format": {
      "const": "SAFOR_AGENT_JOB"
    },
    "schemaVersion": {
      "const": "0.6.0"
    },
    "jobId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "assignedAgentId": {
      "type": "string",
      "minLength": 1
    },
    "assignedIdentityRef": {
      "type": "string",
      "minLength": 1
    },
    "assignedIdentityRevision": {
      "type": "integer",
      "minimum": 1
    },
    "issuedBy": {
      "type": "string",
      "minLength": 1
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "dispatchRevision": {
      "type": "integer",
      "minimum": 1
    },
    "dispatchState": {
      "const": "READY"
    },
    "workItemRef": {
      "type": "string",
      "minLength": 1
    },
    "executionContractRef": {
      "type": "string",
      "minLength": 1
    },
    "mandateRef": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "allowedRepositories",
        "allowedPaths"
      ],
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "allowedRepositories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "allowedPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "requiredOutputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidenceRequirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mayMerge",
        "mayExpandScope",
        "mayModifyMasterState",
        "allowedProviderCapabilities",
        "maxMutationAttempts"
      ],
      "properties": {
        "mayMerge": {
          "type": "boolean"
        },
        "mayExpandScope": {
          "const": false
        },
        "mayModifyMasterState": {
          "const": false
        },
        "allowedProviderCapabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "maxMutationAttempts": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "resultTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resultRef",
        "evidenceRoot"
      ],
      "properties": {
        "resultRef": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRoot": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "expectedType": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
