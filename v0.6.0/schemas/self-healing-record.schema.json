{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:safor:self-healing-record:0.5.0",
  "title": "SAFOR Self-Healing Record 0.5.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repairId",
    "failureClass",
    "failureFingerprint",
    "subjectRef",
    "status",
    "proposedAction",
    "authorityBasis",
    "attemptNumber",
    "preStateRefs",
    "successEvidenceRequirements",
    "evidenceRefs",
    "startedAt",
    "endedAt",
    "outcome"
  ],
  "properties": {
    "repairId": {
      "type": "string",
      "minLength": 1
    },
    "failureClass": {
      "type": "string",
      "pattern": "^SH-[0-9]{2}$"
    },
    "failureFingerprint": {
      "type": "string",
      "minLength": 1
    },
    "subjectRef": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PLANNED",
        "RUNNING",
        "VERIFYING",
        "SUCCEEDED",
        "FAILED",
        "ESCALATED",
        "CANCELED"
      ]
    },
    "proposedAction": {
      "type": "string",
      "minLength": 1
    },
    "authorityBasis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "attemptNumber": {
      "type": "integer",
      "minimum": 1
    },
    "preStateRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "successEvidenceRequirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollbackRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "endedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "outcome": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
