          "workItemType": "WEBSITE_VERIFICATION",
          "requiresCapabilities": [
            "accessibility_verification",
            "responsive_verification",
            "web_performance_verification",
            "content_quality_review"
          ],
          "requiredAuthorities": [],
          "produces": [
            "ACCESSIBILITY_EVIDENCE",
            "RESPONSIVE_EVIDENCE",
            "PERFORMANCE_EVIDENCE",
            "CONTENT_REVIEW_EVIDENCE"
          ],
