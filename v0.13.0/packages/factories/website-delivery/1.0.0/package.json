  "integrity": {
    "canonicalization": "SAFOR_CANONICAL_JSON_V1",
    "digestAlgorithm": "SHA-256",
    "digestScope": "DECLARED_DOMAIN_CONTRACT",
    "contentDigest": "sha256:f3bc27f1dc366e86f088f734d0b4b9397a348f5fd0e955adf14643c48bc5bcfe",
    "verificationMode": "CANONICAL_REPOSITORY_READBACK"
  },
  "model": {
    "maturity": "REFERENCE_STARTER_WEBSITE",
    "scopeBoundary": {
      "included": [
        "PUBLIC_OR_PRIVATE_WEBSITE_CREATION",
        "CONTENT_AND_INFORMATION_ARCHITECTURE",
        "RESPONSIVE_WEB_IMPLEMENTATION",
        "ACCESSIBILITY",
        "WEB_PERFORMANCE",
        "PUBLISHING",
        "POST_PUBLISH_OBSERVATION",
        "WEBSITE_OUTCOME_ASSESSMENT"
      ],
      "excluded": [
        "GENERAL_SAAS_PRODUCT_ENGINEERING",
        "SERVICE_OPERATIONS",
        "INCIDENT_RESPONSE",
        "SOFTWARE_SUPPLY_CHAIN_GOVERNANCE",
        "COMPLEX_BACKEND_PLATFORM_ENGINEERING"
      ],
      "escalationRule": "If discovery reveals a software product, SaaS application, material backend/service lifecycle or operational engineering requirement, stop WEBSITE planning and require explicit HUMAN selection of SOFTWARE_SAAS."
    },
    "compatibilityContract": {
      "mandatoryCapabilities": [
        "website_goal",
        "audience_definition",
        "website_scope_definition",
        "content_strategy",
        "information_architecture",
        "interaction_design",
        "web_implementation",
        "accessibility_verification",
        "responsive_verification",
        "web_performance_verification",
        "content_quality_review",
        "publish_execution",
        "website_observation",
        "website_outcome_assessment"
      ],
      "conditionalCapabilities": [
        {
          "capabilityId": "search_visibility_verification",
          "when": "PUBLIC_DISCOVERABILITY_REQUIRED"
        }
      ],
      "mandatoryAuthorities": [
        "website_scope_approval",
        "publish_approval",
        "website_outcome_acceptance"
      ],
      "conditionalAuthorities": [],
      "rule": "The free Website Factory remains intentionally narrower than the commercial Software/SaaS Factory. Conditional search visibility capability is required only for public discoverability."
    },
    "flowGraph": {
      "nonLinear": false,
      "nodes": [
        {
          "id": "WEB-01",
          "workItemType": "WEBSITE_DEFINITION",
          "requiresCapabilities": [
            "website_goal",
            "audience_definition",
            "website_scope_definition"
          ],
          "requiredAuthorities": [
            "website_scope_approval"
          ],
          "produces": [
            "WEBSITE_BRIEF"
          ],
          "dependsOn": []
        },
        {
          "id": "WEB-02",
          "workItemType": "CONTENT_INFORMATION_ARCHITECTURE",
          "requiresCapabilities": [
            "content_strategy",
            "information_architecture"
          ],
          "requiredAuthorities": [],
          "produces": [
            "CONTENT_MODEL",
            "INFORMATION_ARCHITECTURE"
          ],
          "dependsOn": [
            "WEB-01"
          ]
        },
        {
          "id": "WEB-03",
          "workItemType": "EXPERIENCE_DESIGN",
          "requiresCapabilities": [
            "interaction_design"
          ],
          "requiredAuthorities": [],
          "produces": [
            "EXPERIENCE_DESIGN"
          ],
          "dependsOn": [
            "WEB-02"
          ]
        },
        {
          "id": "WEB-04",
          "workItemType": "WEBSITE_IMPLEMENTATION",
          "requiresCapabilities": [
