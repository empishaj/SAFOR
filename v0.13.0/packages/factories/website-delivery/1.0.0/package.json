    "discoveryContract": {
      "creationType": "WEBSITE",
      "purpose": "Understand the website audience, purpose, content, desired action and smallest publishable first release without expanding into general software/SaaS engineering.",
      "requiredFields": [
        {
          "id": "targetAudience",
          "prompt": "Für wen ist die Website?"
        },
        {
          "id": "websitePurpose",
          "prompt": "Welchen Zweck soll die Website erfüllen?"
        },
        {
          "id": "desiredUserAction",
          "prompt": "Was sollen Besucherinnen und Besucher auf der Website tun oder verstehen?"
        },
        {
          "id": "contentNeeds",
          "prompt": "Welche Inhalte oder Seitentypen werden benötigt?"
        },
        {
          "id": "publicDiscoverability",
          "prompt": "Soll die Website öffentlich über Suchmaschinen auffindbar sein?",
          "options": [
            "YES",
            "NO",
            "UNSURE"
          ]
        },
        {
          "id": "firstRelease",
          "prompt": "Was ist die kleinste veröffentlichbare erste Version?"
        }
      ],
      "boundaryCheck": {
        "trigger": "REQUIRES_APPLICATION_LOGIC_OR_SAAS_SERVICE_LIFECYCLE",
        "outcome": "CREATION_TYPE_CHANGE_REQUIRED",
        "targetCreationType": "SOFTWARE_SAAS"
      },
      "completionPredicate": "ALL_REQUIRED_FIELDS_CONFIRMED_AND_SCOPE_BOUNDARY_VALID",
      "outputArtifactType": "WEBSITE_BRIEF"
    },
    "planningContract": {
      "creationType": "WEBSITE",
      "requiredPlanningPerspectives": [
        "CONTENT",
        "INFORMATION_ARCHITECTURE",
        "UX",
        "WEB_IMPLEMENTATION",
        "ACCESSIBILITY",
        "RESPONSIVE",
        "PERFORMANCE",
        "PUBLISHING",
        "OUTCOME"
      ],
      "deriveWorkItemsFrom": "flowGraph",
      "conditionalRules": [
        {
          "when": "publicDiscoverability == YES",
          "addPlanningConcerns": [
            "SEARCH_VISIBILITY",
            "METADATA",
            "CANONICALIZATION",
            "SITEMAP_ROBOTS_POLICY"
          ]
        }
      ],
      "rule": "Website planning remains intentionally lightweight and must escalate to SOFTWARE_SAAS when the requested product requires an application/service lifecycle beyond the Website scope boundary."
    },
    "webQualityContract": {
      "accessibility": {
        "defaultStandard": "WCAG_2_2",
        "defaultTargetLevel": "AA",
        "jurisdictionOrContractMayOverride": true
      },
      "responsiveVerificationRequired": true,
      "performanceEvidenceRequired": true,
      "browserDeviceScope": "PROJECT_CONTEXT_DERIVED",
      "searchVisibility": "CONDITIONAL_ON_PUBLIC_DISCOVERABILITY"
    },
    "evidenceContract": {
      "creationType": "WEBSITE",
      "byWorkItemType": {
        "WEBSITE_DEFINITION": [
          "WEBSITE_BRIEF",
          "SCOPE_DECISION"
        ],
        "CONTENT_INFORMATION_ARCHITECTURE": [
          "CONTENT_MODEL",
          "INFORMATION_ARCHITECTURE"
        ],
        "EXPERIENCE_DESIGN": [
          "EXPERIENCE_DESIGN_ARTIFACT"
        ],
        "WEBSITE_IMPLEMENTATION": [
          "CONTRIBUTION_REFERENCE",
          "BUILD_EVIDENCE"
        ],
        "WEBSITE_VERIFICATION": [
          "ACCESSIBILITY_EVIDENCE",
          "RESPONSIVE_EVIDENCE",
          "PERFORMANCE_EVIDENCE",
          "CONTENT_REVIEW_EVIDENCE"
        ],
        "PUBLISH": [
          "PUBLISH_READBACK",
          "PUBLISH_DECISION"
        ],
        "POST_PUBLISH_OBSERVATION": [
          "WEBSITE_OBSERVATION"
        ],
        "WEBSITE_OUTCOME_ASSESSMENT": [
          "WEBSITE_OUTCOME_MEASUREMENT",
          "WEBSITE_OUTCOME_DECISION"
        ]
      },
      "conditionalEvidence": [
        {
          "when": "PUBLIC_DISCOVERABILITY_REQUIRED",
          "require": [
            "SEO_TECHNICAL_EVIDENCE"
          ]
        }
      ],
      "forbiddenSubstitutions": [
        "ASSISTANT_CLAIM_FOR_PROVIDER_EVIDENCE",
        "PUBLISH_AS_OUTCOME_EVIDENCE",
        "SOFTWARE_SAAS_SCOPE_AS_WEBSITE_SCOPE"
      ]
    },
    "outcomeModel": {
      "deliveryTerminalArtifact": "PUBLISH_EVIDENCE",
      "observationArtifact": "WEBSITE_OBSERVATION",
      "outcomeArtifact": "WEBSITE_OUTCOME",
      "measurementContract": {
        "requiredFields": [
          "metric",
          "baselineOrBaselineResolution",
          "targetOrDecisionThreshold",
          "observationWindow",
          "dataSource",
          "decisionRule"
        ],
        "allowedDecisions": [
          "VALUE_SUPPORTED",
          "VALUE_NOT_SUPPORTED",
          "INCONCLUSIVE",
          "CONTINUE_OBSERVATION",
          "ITERATE",
          "ABANDON"
        ]
      },
      "rule": "A published website is not evidence that the intended audience outcome has been achieved."
    },
    "reworkPolicy": {
      "selective": true,
      "preserveAcceptedUnaffectedWork": true,
      "defaultMaximumAttempts": 3,
      "defaultPolicyClass": "CONFIGURABLE_SAFETY_DEFAULT_NOT_DOMAIN_TRUTH",
      "onExhausted": "REPLAN_REQUIRED"
    }
  },
  "provenance": {
    "publisher": "SAFOR",
    "sourceRef": "Introduced in SAFOR 0.13.0-rc.3 as the dedicated free Website Factory, separated from commercial Software/SaaS engineering."
  }
}
