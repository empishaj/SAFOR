    "discoveryContract": {
      "creationType": "SOFTWARE_SAAS",
      "purpose": "Understand the user problem, intended value, solution form and minimum useful first release while deriving technical quality/security questions only when project context makes them material.",
      "requiredFields": [
        {
          "id": "targetUsers",
          "prompt": "Wer soll die Software oder Website hauptsächlich nutzen?"
        },
        {
          "id": "userProblem",
          "prompt": "Welches konkrete Problem soll sie lösen?"
        },
        {
          "id": "valueHypothesis",
          "prompt": "Woran erkennen wir später, dass sie echten Nutzen liefert?"
        },
        {
          "id": "solutionForm",
          "prompt": "Was soll entstehen?",
          "options": [
            "WEBSITE",
            "WEB_APP",
            "SERVICE_API",
            "APPLICATION",
            "OTHER"
          ]
        },
        {
          "id": "firstRelease",
          "prompt": "Was ist die kleinste wirklich nutzbare erste Version?"
        }
      ],
      "conditionalFields": [
        {
          "id": "dataSensitivity",
          "when": "PERSONAL_OR_SENSITIVE_DATA_POSSIBLE",
          "prompt": "Welche sensiblen oder personenbezogenen Daten werden verarbeitet?"
        },
        {
          "id": "availabilityExpectation",
          "when": "PRODUCTION_SERVICE_OR_BUSINESS_CRITICAL",
          "prompt": "Welche Verfügbarkeit und Wiederherstellbarkeit ist für den Nutzungskontext notwendig?"
        },
        {
          "id": "publicDiscoverability",
          "when": "solutionForm == WEBSITE",
          "prompt": "Soll die Website öffentlich über Suchmaschinen auffindbar sein?"
        },
        {
          "id": "regulatedContext",
          "when": "REGULATORY_OR_CONTRACTUAL_CONSTRAINT_POSSIBLE",
          "prompt": "Gibt es rechtliche, regulatorische oder vertragliche Vorgaben, die wir berücksichtigen müssen?"
        }
      ],
      "decisionLoadRule": "Derive from approved context before asking; ask conditional fields only when they materially affect requirements, risk or acceptance.",
      "completionPredicate": "ALL_REQUIRED_FIELDS_CONFIRMED_AND_ACTIVE_CONDITIONAL_FIELDS_RESOLVED",
      "outputArtifactType": "BUSINESS_INTENT"
    },
    "qualityPlanningContract": {
      "referenceModel": "ISO_IEC_25010_2023_ALIGNED",
      "characteristics": [
        "FUNCTIONAL_SUITABILITY",
        "PERFORMANCE_EFFICIENCY",
        "COMPATIBILITY",
        "INTERACTION_CAPABILITY",
        "RELIABILITY",
        "SECURITY",
        "MAINTAINABILITY",
        "FLEXIBILITY",
        "SAFETY"
      ],
      "rule": "Planning must explicitly mark each characteristic RELEVANT, NOT_RELEVANT_WITH_REASON, or DEFERRED_WITH_RISK_DECISION; every RELEVANT characteristic receives measurable acceptance/evidence requirements.",
      "webConditionalProfiles": [
        {
          "when": "solutionForm IN [WEBSITE,WEB_APP]",
          "require": [
            "ACCESSIBILITY",
            "RESPONSIVE_BEHAVIOR",
            "BROWSER_DEVICE_COMPATIBILITY",
            "WEB_PERFORMANCE"
          ]
        },
        {
          "when": "solutionForm IN [WEBSITE,WEB_APP] AND ACCESSIBILITY_APPLIES",
          "defaults": {
            "standard": "WCAG_2_2",
            "targetLevel": "AA"
          },
          "rule": "Target may be raised or replaced by applicable jurisdiction/contract; the selected target is recorded, never silently assumed."
        },
        {
          "when": "solutionForm == WEBSITE AND publicDiscoverability == true",
          "require": [
            "CRAWLABILITY",
            "INDEXABILITY",
            "METADATA",
            "CANONICALIZATION",
            "SITEMAP_ROBOTS_POLICY"
          ]
        },
        {
          "when": "PERSONAL_OR_SENSITIVE_DATA_PROCESSED",
          "require": [
            "PRIVACY_REQUIREMENTS",
            "DATA_MINIMIZATION",
            "RETENTION_AND_DELETION_RULES"
          ]
        }
      ]
    },
    "securityEngineeringContract": {
      "shiftLeft": true,
      "requirementsRequired": true,
      "threatAssessment": {
        "default": "LIGHTWEIGHT_RISK_MODEL",
        "elevateWhen": [
          "INTERNET_FACING",
          "AUTHENTICATION",
          "PERSONAL_OR_SENSITIVE_DATA",
          "MATERIAL_BUSINESS_RISK",
          "PAYMENT_OR_FINANCIAL_FLOW"
        ],
        "evidence": "THREAT_MODEL"
      },
      "secureBuild": {
        "repeatableBuildRequired": true,
        "dependencyInventoryRequired": true,
        "sbomRequiredWhen": "THIRD_PARTY_DEPENDENCIES_PRESENT",
        "secretDetectionRequired": true,
        "staticAnalysis": "RISK_BASED",
        "dynamicSecurityTesting": "WHEN_RUNTIME_ATTACK_SURFACE_EXISTS",
        "provenanceRequired": true
      },
      "postRelease": {
        "vulnerabilityResponseRequired": true,
        "unsafeUnresolvedCriticalFindingOutcome": "BLOCK_OR_EXPLICIT_QUALITY_RISK_DECISION"
      }
    },
    "continuousVerificationContract": {
      "perChangeMinimum": [
        "BUILD",
        "UNIT_OR_EQUIVALENT_FAST_TESTS",
        "STATIC_QUALITY_CHECKS",
        "SECRET_SCAN",
        "DEPENDENCY_STATUS_CHECK"
      ],
      "addWhenApplicable": [
        "COMPONENT_TESTS",
        "INTEGRATION_TESTS",
        "CONTRACT_TESTS",
        "UI_TESTS",
        "ACCESSIBILITY_AUTOMATION",
        "SECURITY_TESTS",
        "PERFORMANCE_TESTS"
      ],
      "fastFeedbackRequired": true,
      "rule": "Implementation batches produce verification evidence continuously; SW-05 is independent/non-functional acceptance verification, not the first time software is tested."
    },
    "supplyChainContract": {
      "dependencyInventoryRequired": true,
      "sbomPolicy": "REQUIRED_WHEN_THIRD_PARTY_COMPONENTS_PRESENT",
      "buildProvenanceRequired": true,
      "artifactIntegrityRequired": true,
      "dependencyRiskReview": "RISK_BASED_AND_CONTINUOUS",
      "rule": "Released artifacts must be traceable to immutable source/input identities and a recorded build process."
    },
    "reviewPolicy": {
      "riskClassificationRequired": true,
      "levels": {
        "LOW": {
          "independentReviewRequired": false,
          "minimum": [
            "AUTHOR_SELF_CHECK",
            "AUTOMATED_GATES"
          ]
        },
        "STANDARD": {
          "independentReviewRequired": true,
          "reviewCapability": "technical_review",
          "independencePolicy": "PERFORMER_MUST_DIFFER_FROM_APPROVING_REVIEWER"
        },
        "ELEVATED": {
          "independentReviewRequired": true,
          "reviewCapability": "technical_review",
          "specialistReviewWhenApplicable": true,
          "independencePolicy": "PERFORMER_MUST_DIFFER_FROM_APPROVING_REVIEWER"
        },
        "CRITICAL": {
          "independentReviewRequired": true,
          "reviewCapability": "technical_review",
          "specialistReviewRequired": true,
          "authorityDecisionRequired": true,
          "independencePolicy": "PERFORMER_MUST_DIFFER_FROM_APPROVING_REVIEWER"
        }
      },
      "classificationSignals": [
        "CHANGE_BLAST_RADIUS",
        "SECURITY_IMPACT",
        "DATA_SENSITIVITY",
        "IRREVERSIBILITY",
        "PRODUCTION_CRITICALITY",
        "ARCHITECTURE_IMPACT"
      ],
      "rule": "Independent review is risk-based rather than universally mandatory; any review used as authoritative acceptance evidence must satisfy separation-of-duties requirements."
    },
    "deliverySemantics": {
      "release": "An immutable candidate artifact exists and all release criteria/evidence are satisfied.",
      "deployment": "The approved release artifact is materialized in the target environment and deployment/readback checks pass.",
      "activation": "The deployed capability is intentionally made available to its intended users or traffic.",
      "operateObserve": "Post-activation health, reliability, security-relevant signals and service behavior are observed from authoritative sources.",
      "rule": "Release, deployment and activation are separate facts and must not be substituted for one another."
    },
    "operationsContract": {
      "postDeploymentVerification": [
        "SMOKE_OR_HEALTH_CHECK",
        "CONFIGURATION_READBACK",
        "OBSERVABILITY_SIGNAL_AVAILABLE"
      ],
      "observabilityMinimum": [
        "HEALTH",
        "ERRORS",
        "LATENCY_OR_RESPONSE_BEHAVIOR_WHEN_RELEVANT",
        "RESOURCE_OR_CAPACITY_SIGNAL_WHEN_RELEVANT"
      ],
      "incidentRecovery": {
        "activationCondition": "INCIDENT_OR_SERVICE_DEGRADATION",
        "require": [
          "INCIDENT_RECORD",
          "MITIGATION_OR_RECOVERY_ACTION",
          "AUTHORITATIVE_HEALTH_READBACK"
        ],
        "unknownExternalMutation": "RECONCILE_BEFORE_RETRY"
      },
      "vulnerabilityResponse": {
        "activationCondition": "POST_RELEASE_VULNERABILITY_OR_SECURITY_DEFECT",
        "require": [
          "IMPACT_ASSESSMENT",
          "REMEDIATION_OR_RISK_DECISION",
          "VERIFICATION_EVIDENCE"
        ]
      }
    },
    "outcomeModel": {
      "deliveryTerminalArtifact": "ACTIVATION",
      "operationalEvidenceArtifact": "OPERATIONAL_STATUS",
      "outcomeArtifact": "OUTCOME",
      "rule": "Delivery, activation and healthy operation are not evidence that the declared value hypothesis has been achieved.",
      "measurementContract": {
        "requiredFields": [
          "metric",
          "baselineOrBaselineResolution",
          "targetOrDecisionThreshold",
          "observationWindow",
          "dataSource",
          "decisionRule",
          "uncertaintyHandling"
        ],
        "allowedDecisions": [
          "VALUE_SUPPORTED",
          "VALUE_NOT_SUPPORTED",
          "INCONCLUSIVE",
          "CONTINUE_OBSERVATION",
          "ITERATE",
          "ABANDON"
        ],
        "rule": "Outcome decisions require authoritative measurement evidence and an explicit decision rule; missing or weak evidence yields INCONCLUSIVE or CONTINUE_OBSERVATION rather than invented success."
      }
    },
    "reworkPolicy": {
      "selective": true,
      "preserveAcceptedUnaffectedWork": true,
      "defaultMaximumAttempts": 3,
      "defaultPolicyClass": "CONFIGURABLE_SAFETY_DEFAULT_NOT_DOMAIN_TRUTH",
      "overrideDimensions": [
        "RISK_CLASS",
        "COST_OF_FAILURE",
        "REVERSIBILITY",
        "WORK_ITEM_TYPE",
        "HUMAN_POLICY"
      ],
      "onExhausted": "REPLAN_REQUIRED"
    },
    "planningContract": {
      "creationType": "SOFTWARE_SAAS",
      "sourceInputs": [
        "DISCOVERY_RECORD",
        "BUSINESS_INTENT",
        "REQUIREMENT"
      ],
      "requiredPlanningPerspectives": [
        "PRODUCT",
        "QUALITY",
        "SECURITY",
        "ARCHITECTURE",
        "ENGINEERING",
        "SUPPLY_CHAIN",
        "VERIFICATION",
        "RELEASE",
        "DEPLOYMENT",
        "OPERATIONS",
        "OUTCOME"
      ],
      "deriveWorkItemsFrom": "flowGraph",
      "requiredForEachWorkItem": [
        "objective",
        "requiredCapabilities",
        "dependencies",
        "expectedOutputs",
        "acceptanceCriteria",
        "evidenceRequirements",
        "riskClass",
        "execution",
        "execution.resourceAccess",
        "execution.parallelizationDecision"
      ],
      "conditionalRules": [
        {
          "when": "solutionForm IN [WEBSITE,WEB_APP]",
          "addPlanningConcerns": [
            "RESPONSIVE_BEHAVIOR",
            "ACCESSIBILITY",
            "BROWSER_DEVICE_COMPATIBILITY",
            "WEB_PERFORMANCE",
            "FRONTEND_BUILD_AND_DELIVERY"
          ]
