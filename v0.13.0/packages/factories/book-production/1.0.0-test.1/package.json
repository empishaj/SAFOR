  "dependencies": [],
  "integrity": {
    "canonicalization": "SAFOR_CANONICAL_JSON_V2",
    "digestAlgorithm": "SHA-256",
    "digestScope": "DECLARED_DOMAIN_CONTRACT",
    "contentDigest": "sha256:0c096a7ca746ca04656b68bffc72a08545b88b3e69669bf3b4fdf4e751f8ede6",
    "verificationMode": "CANONICAL_REPOSITORY_READBACK"
  },
  "model": {
    "flowGraph": {
      "nonLinear": true,
      "nodes": [
        {
          "id": "BK-01",
          "workItemType": "BOOK_CONCEPT",
          "requiresCapabilities": [
            "book_intent",
            "audience_definition"
          ],
          "requiredAuthorities": [
            "book_scope_approval"
          ],
          "produces": [
            "BOOK_INTENT",
            "AUDIENCE_DEFINITION",
            "BOOK_CONCEPT"
          ],
          "dependsOn": []
        },
        {
          "id": "BK-02",
          "workItemType": "RESEARCH",
          "requiresCapabilities": [
            "research"
          ],
          "requiredAuthorities": [],
          "produces": [
            "RESEARCH_DOSSIER"
          ],
          "dependsOn": [
            "BK-01"
          ]
        },
        {
          "id": "BK-03",
          "workItemType": "OUTLINE",
          "requiresCapabilities": [
            "outline_design"
          ],
          "requiredAuthorities": [
            "book_structure_approval"
          ],
          "produces": [
            "OUTLINE"
          ],
          "dependsOn": [
            "BK-01",
            "BK-02"
          ]
        },
        {
          "id": "BK-04",
          "workItemType": "DRAFT",
          "requiresCapabilities": [
            "authoring"
          ],
          "requiredAuthorities": [],
          "produces": [
            "MANUSCRIPT"
          ],
          "dependsOn": [
            "BK-03"
          ]
        },
        {
          "id": "BK-05",
          "workItemType": "FACT_CHECK",
          "requiresCapabilities": [
            "fact_check"
          ],
          "review": {
            "required": true,
            "independencePolicy": "PERFORMER_MUST_DIFFER_FROM_APPROVING_REVIEWER"
          },
          "requiredAuthorities": [],
          "produces": [
            "FACT_CHECK_EVIDENCE"
          ],
          "dependsOn": [
            "BK-04"
          ]
        },
        {
          "id": "BK-06",
          "workItemType": "EDITORIAL_REVIEW",
          "requiresCapabilities": [
            "editorial_review"
          ],
          "review": {
            "required": true,
            "independencePolicy": "PERFORMER_MUST_DIFFER_FROM_APPROVING_REVIEWER"
          },
          "requiredAuthorities": [],
          "produces": [
            "EDITORIAL_REVIEW"
          ],
          "dependsOn": [
            "BK-04"
          ]
        },
        {
          "id": "BK-07",
          "workItemType": "PROOFREAD",
          "requiresCapabilities": [
            "proofreading"
          ],
          "requiredAuthorities": [],
          "produces": [
            "PROOF"
          ],
          "dependsOn": [
            "BK-05",
            "BK-06"
          ],
          "joinPolicy": "ALL_DEPENDENCIES_ACCEPTED"
        },
        {
          "id": "BK-08",
          "workItemType": "PUBLICATION",
          "requiresCapabilities": [
            "publication_preparation"
          ],
          "requiredAuthorities": [
            "publication_approval"
          ],
          "produces": [
            "PUBLICATION_PACKAGE"
          ],
          "dependsOn": [
            "BK-07"
          ]
        },
        {
          "id": "BK-09",
          "workItemType": "OUTCOME_ASSESSMENT",
          "requiresCapabilities": [
            "reader_outcome_assessment"
          ],
          "requiredAuthorities": [
            "reader_outcome_acceptance"
          ],
          "produces": [
            "READER_OUTCOME"
          ],
          "dependsOn": [
            "BK-08"
          ]
        }
      ]
    },
    "reworkPolicy": {
      "selective": true,
      "preserveAcceptedUnaffectedWork": true,
      "defaultMaximumAttempts": 3,
      "onExhausted": "REPLAN_REQUIRED"
    },
    "outcomeModel": {
      "deliveryTerminalArtifact": "PUBLICATION_PACKAGE",
      "outcomeArtifact": "READER_OUTCOME",
      "rule": "Publication is delivery. Reader understanding, behavior or other declared reader value requires separate outcome evidence."
    },
    "discoveryContract": {
      "creationType": "BOOK",
      "purpose": "Understand intended readers, reader need, core promise, evidence standard and minimum coherent book scope before planning.",
      "requiredFields": [
        {
          "id": "targetReaders",
          "prompt": "Für wen schreibst du dieses Buch?"
        },
        {
          "id": "readerNeed",
          "prompt": "Was sollen die Leser danach besser verstehen oder können?"
        },
        {
          "id": "corePromise",
          "prompt": "Was ist die zentrale Aussage oder das Versprechen des Buches?"
        },
        {
          "id": "readerValueHypothesis",
          "prompt": "Woran erkennen wir später, dass das Buch seinen Lesern nutzt?"
        },
        {
          "id": "evidenceStandard",
          "prompt": "Welchen Anspruch soll das Buch an Quellen und Nachweise haben?",
          "options": [
            "PRACTITIONER",
            "EVIDENCE_BASED",
            "SCIENTIFIC"
          ]
        },
        {
          "id": "minimumPublishableScope",
          "prompt": "Was ist der kleinste in sich stimmige publizierbare Umfang?"
        }
      ],
      "completionPredicate": "ALL_REQUIRED_FIELDS_CONFIRMED",
      "outputArtifactType": "BOOK_INTENT"
    },
    "planningContract": {
      "creationType": "BOOK",
      "sourceInputs": [
        "DISCOVERY_RECORD",
        "BOOK_INTENT",
        "AUDIENCE_DEFINITION"
      ],
      "requiredPlanningPerspectives": [
        "READER_VALUE",
        "RESEARCH",
        "STRUCTURE",
        "AUTHORING",
        "FACT_CHECK",
        "EDITORIAL",
        "PROOF",
        "PUBLICATION",
        "OUTCOME"
      ],
      "deriveWorkItemsFrom": "flowGraph",
      "requiredForEachWorkItem": [
        "objective",
        "requiredCapabilities",
        "dependencies",
        "expectedOutputs",
        "acceptanceCriteria",
        "evidenceRequirements",
        "execution",
        "execution.resourceAccess",
        "execution.parallelizationDecision"
      ],
      "conditionalRules": [
        {
          "when": "evidenceStandard == SCIENTIFIC",
          "addPlanningConcerns": [
            "SOURCE_TRACEABILITY",
            "CLAIM_EVIDENCE_MAPPING",
            "SCIENTIFIC_REVIEW"
          ]
        }
      ],
      "rule": "Planning must be derived only from the confirmed book discovery and this factory graph."
    },
    "evidenceContract": {
      "creationType": "BOOK",
      "rule": "Evidence must demonstrate source quality, manuscript transformation and independent review appropriate to the selected evidence standard.",
      "byWorkItemType": {
        "BOOK_CONCEPT": [
          "BOOK_INTENT",
          "AUDIENCE_DEFINITION",
          "BOOK_SCOPE_DECISION"
        ],
        "RESEARCH": [
          "RESEARCH_DOSSIER",
          "SOURCE_PROVENANCE"
        ],
        "OUTLINE": [
          "OUTLINE_ARTIFACT",
          "BOOK_STRUCTURE_DECISION"
        ],
        "DRAFT": [
          "MANUSCRIPT_ARTIFACT"
        ],
        "FACT_CHECK": [
          "INDEPENDENT_FACT_CHECK_EVIDENCE"
        ],
        "EDITORIAL_REVIEW": [
          "INDEPENDENT_EDITORIAL_REVIEW"
        ],
        "PROOFREAD": [
          "PROOFREAD_EVIDENCE"
        ],
        "PUBLICATION": [
          "PUBLICATION_PACKAGE",
          "PUBLICATION_DECISION"
        ],
        "OUTCOME_ASSESSMENT": [
          "READER_FEEDBACK_OR_OUTCOME_EVIDENCE",
          "READER_OUTCOME_DECISION"
        ]
      },
      "conditionalEvidence": [
        {
          "when": "evidenceStandard == SCIENTIFIC",
          "require": [
            "CLAIM_TO_SOURCE_TRACEABILITY",
            "SCIENTIFIC_REVIEW_EVIDENCE"
          ]
        }
      ],
      "forbiddenSubstitutions": [
        "AUTHOR_SELF_ATTESTATION_FOR_REQUIRED_INDEPENDENT_FACT_CHECK",
        "UNVERIFIED_SOURCE_LIST_AS_RESEARCH_EVIDENCE",
        "PUBLICATION_AS_READER_OUTCOME_EVIDENCE"
      ]
    },
    "schedulingContract": {
      "atomicDispatchOnly": true,
      "compositeDecompositionRequired": true,
      "resourceAccessRequired": true,
      "immutableReadInputsRequired": true,
      "unknownMutationConflict": "SERIALIZE",
      "dedicatedGitBranchForMutations": true,
      "naturalParallelism": [
        {
          "after": "BK-04",
          "nodes": [
            "BK-05",
            "BK-06"
          ],
          "joinAt": "BK-07"
        }
      ],
      "decompositionRule": "Research, drafting, fact-check or editorial work may be decomposed only along explicit chapter/section/source domains with independent outputs and conservative conflict domains; shared manuscript integration is explicit.",
      "integrationRule": "Proof/publication work waits for ACCEPTED dependencies and any explicit manuscript-integration work required by the plan.",
      "dependencyGraphRule": "Work-item dependency relations used for scheduling must form an acyclic directed graph; cycles are invalid planning state and block dispatch."
    }
  },
  "provenance": {
    "publisher": "SAFOR",
    "sourceRef": "PUBLIC_TEST_EVALUATION migration of v0.10.0 book-production@0.5.0 for SAFOR-FRAMEWORK-BOOK-CREATION.json testing; not the protected commercial production package."
  }
}
