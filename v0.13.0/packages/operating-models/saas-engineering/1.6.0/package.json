          "CHANGES_REQUIRED",
          "ESCALATE"
        ]
      },
      {
        "id": "HG-3",
        "authorityId": "quality_risk_decision",
        "trigger": "CRITICAL_QUALITY_OR_SECURITY_DEVIATION",
