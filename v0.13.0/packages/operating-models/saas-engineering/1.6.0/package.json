          "RISK_DECISION",
          "BLOCK"
        ]
      },
      {
        "id": "HG-4",
        "authorityId": "production_release_approval",
        "trigger": "PRODUCTION_AND_MATERIAL_RISK",
        "outcomes": [
          "AUTHORIZE",
          "HOLD",
          "ROLLBACK_PLAN_REQUIRED"
        ]
      },
      {
        "id": "HG-5",
        "authorityId": "business_outcome_acceptance",
        "trigger": "OUTCOME_ASSESSMENT",
        "outcomes": [
          "ACCEPT_VALUE",
          "ITERATE",
          "CONTINUE_OBSERVATION",
          "ABANDON"
        ]
      }
    ],
    "separationOfDuties": [
      {
        "id": "SOD-TECH-REVIEW",
        "rule": "When the Factory risk policy requires authoritative independent technical review, the approving reviewer actor must differ from the contribution author actor."
      },
      {
        "id": "SOD-SECURITY",
        "rule": "Security evidence may not be substituted by the implementation author's self-attestation when independent security verification is required."
      },
      {
        "id": "SOD-RISK-DECISION",
        "rule": "An actor responsible for producing the evidence that triggered a critical quality/security deviation must not be the sole actor exercising the quality_risk_decision authority for that same deviation."
      }
    ]
  },
