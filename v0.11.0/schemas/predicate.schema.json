{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safor.dev/schemas/0.11.0/predicate.schema.json",
  "title": "SAFOR Predicate Expression",
  "type": "object",
  "oneOf": [
    {
      "additionalProperties": false,
      "required": [
        "predicate"
      ],
      "properties": {
        "predicate": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "args": {
          "type": "object",
          "default": {}
        }
      }
    },
    {
      "additionalProperties": false,
      "required": [
        "all"
      ],
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#"
          }
        }
      }
    },
    {
      "additionalProperties": false,
      "required": [
        "any"
      ],
      "properties": {
        "any": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#"
          }
        }
      }
    },
    {
      "additionalProperties": false,
      "required": [
        "not"
      ],
      "properties": {
        "not": {
          "$ref": "#"
        }
      }
    }
  ]
}
